                    "\\t\\t\\t\\t\\t/helper\\s+\\w+\\s*\\([^)]*\\)\\s*/.source + curly,"
                ]
            },
            {
                "SEARCH": [
                    "\\t\\t'value': {",
                    "\\t\\t\\tpattern: RegExp(",
                    "\\t\\t\\t\\t/(^|[^@])@/.source +",
