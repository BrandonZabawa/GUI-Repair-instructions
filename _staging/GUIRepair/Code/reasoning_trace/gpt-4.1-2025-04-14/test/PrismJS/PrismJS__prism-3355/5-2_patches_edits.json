                    "\\t\\t\\t\\t\\t/\\w+\\b(?:\\s*\\([\\s\\S]*?\\))?/.source +",
                    "\\t\\t\\t\\t')' +",
                    "\\t\\t\\t\\t'(?:' + /[?!]?\\.\\w+\\b/.source + '|' + round + '|' + square + '|' + angle + round + ')*'",
                    "\\t\\t\\t),",
                    "\\t\\t\\tlookbehind: true,",
                    "\\t\\t\\tgreedy: true,",
                    "\\t\\t\\talias: 'variable',",
                    "\\t\\t\\tinside: {",
                    "\\t\\t\\t\\t'keyword': /^@/,",
                    "\\t\\t\\t\\t'csharp': cs",
                    "\\t\\t\\t}",
                    "\\t\\t},"
                ]
            }
        ]
    },
