{
    "1/1": {
        "components/prism-cpp.js": [
            {
                "SEARCH": [
                    "Prism.languages.cpp = Prism.languages.extend('c', {",
                    "'class-name': {",
                    "pattern: /(\\b(?:class|enum|struct)\\s+)(?!class|enum|struct)\\w+/,",
                    "lookbehind: true",
                    "},"
                ],
                "REPLACE": [
                    "Prism.languages.cpp = Prism.languages.extend('c', {",
                    "'class-name': [",
                    "{",
                    "// class/struct/enum declaration",
                    "pattern: /(\\b(?:class|enum|struct)\\s+)(?!class|enum|struct)\\w+/,",
                    "lookbehind: true",
                    "},",
                    "{",
                    "// inheritance: after :, public, protected, private",
                    "pattern: /(\\b(?:public|protected|private)\\s+|\\:\\s*)(\\w+)/,",
                    "lookbehind: true",
                    "},",
                    "{",
                    "// qualified names: before ::",
                    "pattern: /\\b\\w+(?=\\s*::)/,",
                    "}",
                    "],"
                ]
            }
        ]
    },
