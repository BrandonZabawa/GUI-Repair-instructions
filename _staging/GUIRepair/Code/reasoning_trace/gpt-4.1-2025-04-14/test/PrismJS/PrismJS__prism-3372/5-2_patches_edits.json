        "components/index.js": [
            {
                "SEARCH": [
                    "function loadLanguages(languages) {",
                    "if (languages === undefined) {",
                    "languages = Object.keys(components.languages).filter(l => l != 'meta');",
                    "} else if (!Array.isArray(languages)) {",
                    "languages = [languages];",
                    "}"
                ],
                "REPLACE": [
                    "function loadLanguages(languages) {",
                    "if (languages === undefined) {",
                    "languages = Object.keys(components.languages).filter(l => l != 'meta');",
                    "} else if (!Array.isArray(languages)) {",
                    "languages = [languages];",
                    "}",
                    "",
                    "// Add alias for PlantUML and .wsd files if not already present",
                    "languages = languages.map(lang => {",
                    "if (lang.toLowerCase() === 'plantuml' || lang.toLowerCase() === 'wsd') {",
                    "return 'plantuml';",
                    "}",
                    "return lang;",
                    "});"
                ]
            }
        ]
