                    "  const renderer = layer.getRenderer();",
                    "  // Warn if the input layer is a WebGLTileLayer, as this will provide styled RGBA data, not raw band data.",
                    "  if (layer && layer.constructor && layer.constructor.name === 'WebGLTileLayer') {",
                    "    console.warn(",
                    "      'RasterSource: Input layer is a WebGLTileLayer. This will provide styled RGBA data, not raw band data. ' +",
                    "      'For region growing or pixel operations on raw data, use an ImageLayer with the raw source instead.'",
                    "    );",
                    "  }",
                    "  if (!renderer) {",
                    "    throw new Error('Unsupported layer type: ' + layer);",
                    "  }",
                    "",
                    "  if (!renderer.prepareFrame(frameState)) {",
                    "    return null;",
                    "  }"
                ]
            }
        ]
