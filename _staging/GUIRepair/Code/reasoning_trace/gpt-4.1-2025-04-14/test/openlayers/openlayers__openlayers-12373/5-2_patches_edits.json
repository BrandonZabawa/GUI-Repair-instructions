                    "      wrapX: options.wrapX !== undefined ? options.wrapX : true,",
                    "      zDirection: options.zDirection,",
                    "    });",
                    "",
                    "    // Add invertY option to handle {-y} template",
                    "    this.invertY = options.invertY || false;",
