                    "            tileTexture = tileTextureCache.get(cacheKey);",
                    "            tile = tileTexture.tile;",
                    "          }",
                    "          if (!tileTexture || tileTexture.tile.key !== tileSource.getKey()) {",
                    "            if (sourceProj && !sourceProj.equals(viewProj)) {",
                    "              // Use OpenLayers reprojection tile if projections differ",
                    "              tile = tileSource.getReprojTile(",
                    "                z,",
                    "                x,",
                    "                y,",
                    "                frameState.pixelRatio,",
                    "                viewProj,",
