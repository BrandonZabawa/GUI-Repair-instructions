                    "          const cacheKey = getCacheKey(tileSource, tileCoord);",
                    "",
                    "          /** @type {TileTexture} */",
                    "          let tileTexture;",
                    "",
                    "          /** @type {import(\"../../webgl/TileTexture\").TileType} */",
                    "          let tile;",
                    "",
                    "          // --- BEGIN PATCH: handle reprojection ---",
