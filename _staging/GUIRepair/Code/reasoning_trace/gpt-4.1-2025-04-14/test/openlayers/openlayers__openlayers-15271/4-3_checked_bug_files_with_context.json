        "    withArgsCount(1, 2),",
        "    parseArgsOfType(NumberType)",
        "  ),",
        "  [Ops.Sqrt]: createParser(",
        "    NumberType,",
        "    withArgsCount(1, 1),",
        "    parseArgsOfType(NumberType)",
        "  ),",
        "  [Ops.Match]: createParser(",
        "    (parsedArgs) => {",
