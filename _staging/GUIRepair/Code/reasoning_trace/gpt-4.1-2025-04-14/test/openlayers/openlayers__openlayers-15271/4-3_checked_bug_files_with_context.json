        "    parseArgsOfType(NumberType)",
        "  ),",
        "  [Ops.Subtract]: createParser(",
        "    NumberType,",
        "    withArgsCount(2, 2),",
        "    parseArgsOfType(NumberType)",
        "  ),",
        "  [Ops.Clamp]: createParser(",
        "    NumberType,",
        "    withArgsCount(3, 3),",
        "    parseArgsOfType(NumberType)",
        "  ),",
        "  [Ops.Mod]: createParser(",
        "    NumberType,",
