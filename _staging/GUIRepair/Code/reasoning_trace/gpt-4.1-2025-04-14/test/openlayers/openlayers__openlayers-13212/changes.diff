+  /**
+   * Loader for pyramid mode: fetches the GeoTIFF for the tile from the template.
+   * @private
+   */
+  loadTilePyramid_(z, x, y) {
+    const size = toSize(this.tileGrid.getTileSize(z));
+    const url = this.template_
+      .replace('{z}', z)
+      .replace('{x}', x)
+      .replace('{y}', y);
+
+    // Fetch the GeoTIFF for this tile
+    return tiffFromUrl(url)
+      .then(getImagesForTIFF)
+      .then((images) => {
+        // Use the first image (or allow for overviews if needed)
+        const image = images[0];
+        // Optionally, support bands, nodata, etc. from options
+        const samples = undefined; // TODO: support bands if needed
+        const fillValue = undefined; // TODO: support nodata if needed
+
+        return image[this.readMethod_]({
+          window: [0, 0, image.getWidth(), image.getHeight()],
+          width: size[0],
+          height: size[1],
+          samples: samples,
+          fillValue: fillValue,
+          pool: getWorkerPool(),
+          interleave: false,
+        });
+      })
+      .then((sourceSamples) => {
+        // Flatten the result (single band or multi-band)
+        // Assume normalize is true for pyramid mode
+        const pixelCount = size[0] * size[1];
+        const bandCount = Array.isArray(sourceSamples)
+          ? sourceSamples.length
+          : 1;
+        const dataLength = pixelCount * bandCount;
+        let data = new Uint8Array(dataLength);
+        let dataIndex = 0;
+        if (Array.isArray(sourceSamples)) {
+          for (let i = 0; i < pixelCount; ++i) {
+            for (let b = 0; b < bandCount; ++b) {
+              data[dataIndex++] = sourceSamples[b][i];
+            }
+          }
+        } else {
+          for (let i = 0; i < pixelCount; ++i) {
+            data[dataIndex++] = sourceSamples[i];
+          }
+        }
+        return data;
