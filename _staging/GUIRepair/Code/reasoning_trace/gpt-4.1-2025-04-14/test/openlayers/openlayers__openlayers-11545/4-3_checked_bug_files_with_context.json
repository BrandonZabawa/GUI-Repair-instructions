        "  /**",
        "   * @param {Array<import(\"./Layer.js\").default>=} opt_array Array of layers (to be modified in place).",
        "   * @return {Array<import(\"./Layer.js\").default>} Array of layers.",
        "   */",
        "  getLayersArray(opt_array) {",
