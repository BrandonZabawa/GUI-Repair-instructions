+export function circular(centerOrCircle, radius, opt_sides, opt_angle, opt_projection) {
+  const sides = opt_sides ? opt_sides : 32;
+  let center;
+  if (Array.isArray(centerOrCircle)) {
+    center = centerOrCircle;
+  } else {
+    center = centerOrCircle.getCenter();
+  }
+  let coordinates = [];
+  const isGeographic = opt_projection && (opt_projection.getCode() === 'EPSG:4326' || opt_projection.getGeographic());
+  if (isGeographic) {
+    // Geodesic circle
+    const angleOffset = opt_angle || 0;
+    for (let i = 0; i < sides; ++i) {
+      const angle = angleOffset + (2 * Math.PI * i) / sides;
+      coordinates.push(offsetCoord(center, radius, angle * 180 / Math.PI));
+    }
+    coordinates.push(coordinates[0].slice());
+    return new Polygon([coordinates]);
+  } else {
+    // Planar circle
+    const stride = 2;
+    const arrayLength = stride * (sides + 1);
+    const flatCoordinates = new Array(arrayLength);
+    for (let i = 0; i < sides; ++i) {
+      const angle = (2 * Math.PI * i) / sides + (opt_angle || 0);
+      flatCoordinates[i * 2] = center[0] + radius * Math.cos(angle);
+      flatCoordinates[i * 2 + 1] = center[1] + radius * Math.sin(angle);
+    }
+    flatCoordinates[sides * 2] = flatCoordinates[0];
+    flatCoordinates[sides * 2 + 1] = flatCoordinates[1];
+    return new Polygon(flatCoordinates, undefined, [flatCoordinates.length]);
+  }
