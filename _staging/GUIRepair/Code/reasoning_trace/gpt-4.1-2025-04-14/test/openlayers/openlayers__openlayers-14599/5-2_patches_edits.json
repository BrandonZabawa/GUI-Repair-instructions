                "REPLACE": [
                    "  collectSourceAttributions_(frameState) {",
                    "    // Helper to recursively collect attributions from only effectively visible layers",
                    "    function collectVisibleAttributions(layers, frameState) {",
                    "      let attributions = [];",
                    "      layers.forEach((layer) => {",
                    "        // Check effective visibility: must be visible in the current view",
                    "        if (typeof layer.isVisible === 'function' && layer.isVisible(frameState.viewState)) {",
                    "          if (typeof layer.getLayers === 'function') {",
                    "            // It's a group, recurse",
                    "            attributions = attributions.concat(collectVisibleAttributions(layer.getLayers().getArray(), frameState));",
                    "          } else {",
                    "            // It's a leaf layer",
                    "            attributions = attributions.concat(layer.getAttributions(frameState));",
                    "          }",
                    "        }",
                    "      });",
                    "      return attributions;",
                    "    }",
                    "",
                    "    const map = this.getMap();",
                    "    const allLayers = map.getLayers().getArray ? map.getLayers().getArray() : map.getAllLayers();",
                    "    const visibleAttributions = Array.from(",
                    "      new Set(",
                    "        collectVisibleAttributions(allLayers, frameState)",
                    "      )",
                    "    );",
                    "",
                    "    const collapsible = !map",
                    "      .getAllLayers()",
                    "      .some(",
                    "        (layer) =>",
                    "          layer.getSource() &&",
                    "          layer.getSource().getAttributionsCollapsible() === false",
                    "      );",
                    "    if (!this.overrideCollapsible_) {",
                    "      this.setCollapsible(collapsible);",
                    "    }",
                    "    return visibleAttributions;",
                    "  }"
                ]
            }
        ]
    }
