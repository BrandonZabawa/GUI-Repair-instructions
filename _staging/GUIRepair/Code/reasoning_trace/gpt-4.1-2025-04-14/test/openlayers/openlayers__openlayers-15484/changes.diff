@@ -129,6 +129,16 @@ class ReprojDataTile extends DataTile {
     const maxTargetExtent = this.targetTileGrid_.getExtent();
     let maxSourceExtent = this.sourceTileGrid_.getExtent();
 
+    // Always crop to the source tile grid extent, regardless of projection or wrapX
+    const sourceTileGridExtent = this.sourceTileGrid_.getExtent();
+    if (sourceTileGridExtent) {
+      if (!maxSourceExtent) {
+        maxSourceExtent = sourceTileGridExtent;
+      } else {
+        maxSourceExtent = getIntersection(maxSourceExtent, sourceTileGridExtent);
+      }
+    }
+
     const limitedTargetExtent = maxTargetExtent
       ? getIntersection(targetExtent, maxTargetExtent)
       : targetExtent;
