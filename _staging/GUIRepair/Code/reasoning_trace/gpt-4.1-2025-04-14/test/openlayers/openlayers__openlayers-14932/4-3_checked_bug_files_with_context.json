{
    "src/ol/style/Text.js": [
        "...",
        "class Text {",
        "  /**",
        "   * @param {Options} [options] Options.",
        "   */",
        "  constructor(options) {",
        "    options = options || {};",
        "",
        "    /**",
        "     * @private",
