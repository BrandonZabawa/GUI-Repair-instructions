                    "      .filter(",
                    "        polygon =>",
                    "          Array.isArray(polygon) &&",
                    "          polygon.length > 0 &&",
                    "          // At least one ring with at least 4 coordinates (valid polygon ring)",
                    "          polygon.some(",
                    "            ring => Array.isArray(ring) && ring.length > 0 && ring[0] && ring.length >= 4",
                    "          )",
                    "      );",
                    "    this.setLayout(opt_layout, filteredCoordinates, 3);",
                    "    if (!this.flatCoordinates) {",
                    "      this.flatCoordinates = [];",
                    "    }",
