+  /**
+   * Load more tiles for all child layers in the group.
+   * @param {number} maxTotalLoading
+   * @param {number} maxNewLoads
+   */
+  loadMoreTiles(maxTotalLoading, maxNewLoads) {
+    this.getLayers().forEach(function(layer) {
+      if (typeof layer.loadMoreTiles === 'function') {
+        layer.loadMoreTiles(maxTotalLoading, maxNewLoads);
+      }
+    });
+  }
