                "REPLACE": [
                    "    static propTypes = {",
                    "        /**",
                    "         * 样式前缀",
                    "         */",
                    "        prefix: PropTypes.string,",
                    "        rtl: PropTypes.bool,",
                    "        /**",
                    "         * label 标签的文本",
                    "         */",
                    "        label: PropTypes.node,",
                    "        /**",
                    "         * 自定义用于错误信息的 label 文案",
                    "         */",
                    "        errorMessageLabel: PropTypes.node,"
                ]
            },
            {
                "SEARCH": [
                    "getLabelForErrorMessage() {",
                    "let label = this.props.label;",
                    "",
                    "if (!label || typeof label !== 'string') {",
                    "return null;",
                    "}",
                    "",
                    "label = label.replace(':', '').replace('：', '');",
                    "",
                    "const labelForErrorMessage =",
                    "'useLabelForErrorMessage' in this.props",
                    "? this.props.useLabelForErrorMessage",
                    ": this.context._formLabelForErrorMessage;",
                    "if (labelForErrorMessage && label) {",
                    "return label;",
                    "}",
                    "",
                    "return null;",
                    "}"
                ],
                "REPLACE": [
                    "    getLabelForErrorMessage() {",
                    "        // 优先使用 errorMessageLabel",
                    "        if ('errorMessageLabel' in this.props && this.props.errorMessageLabel) {",
                    "            return this.props.errorMessageLabel;",
                    "        }",
                    "",
                    "        let label = this.props.label;",
                    "",
                    "        if (!label || typeof label !== 'string') {",
                    "            return null;",
                    "        }",
                    "",
                    "        label = label.replace(':', '').replace('：', '');",
                    "",
                    "        const labelForErrorMessage =",
                    "            'useLabelForErrorMessage' in this.props",
                    "                ? this.props.useLabelForErrorMessage",
                    "                : this.context._formLabelForErrorMessage;",
                    "        if (labelForErrorMessage && label) {",
                    "            return label;",
                    "        }",
                    "",
                    "        return null;",
                    "    }"
                ]
            }
        ]
    }
