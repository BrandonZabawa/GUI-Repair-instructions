    "1/1": {
        "src/cascader/cascader.jsx": [
            {
                "SEARCH": [
                    "const flatDataSource = (data, prefix = '0', v2n = {}, p2n = {}) => {",
                    "data.forEach((item, index) => {",
                    "const { value, children } = item;",
                    "const pos = `${prefix}-${index}`;",
                    "const newValue = String(value);",
                    "item.value = newValue;",
                    "v2n[newValue] = p2n[pos] = {",
                    "...item,",
                    "pos,",
                    "_source: item,",
                    "};",
                    "",
                    "if (children && children.length) {",
                    "flatDataSource(children, pos, v2n, p2n);",
                    "}",
                    "});",
                    "",
                    "return { v2n, p2n };",
                    "};"
                ],
                "REPLACE": [
                    "const flatDataSource = (data, prefix = '0', v2n = {}, p2n = {}) => {",
                    "    data.forEach((item, index) => {",
                    "        const { value, children } = item;",
                    "        const pos = `${prefix}-${index}`;",
                    "        const newValue = String(value);",
                    "        // Do not mutate the original item, clone it first",
                    "        const clonedItem = { ...item, value: newValue };",
                    "        v2n[newValue] = p2n[pos] = {",
                    "            ...clonedItem,",
                    "            pos,",
                    "            _source: item,",
                    "        };",
                    "",
                    "        if (children && children.length) {",
                    "            flatDataSource(children, pos, v2n, p2n);",
                    "        }",
                    "    });",
                    "",
                    "    return { v2n, p2n };",
                    "};"
                ]
            }
        ]
    }
}