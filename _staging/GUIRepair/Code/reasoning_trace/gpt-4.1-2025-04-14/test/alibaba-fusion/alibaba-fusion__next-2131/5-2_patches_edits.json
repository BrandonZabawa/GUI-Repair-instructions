                    "    const drill = (data = [], level = 1, prefix = '0', parent) =>",
                    "        data.map((item, index) => {",
                    "            // 为了兼容之前的实现 保留非法节点",
                    "            if (item.illegalFlag) {",
                    "                return item;",
                    "            }",
                    "",
                    "            // Create a shallow copy to avoid mutating the original item",
                    "            const node = { ...item };",
                    "            const { children } = node;",
                    "            const pos = `${prefix}-${index}`;",
                    "            let { key } = node;",
                    "",
                    "            node.pos = pos;",
                    "            node.level = level;",
                    "",
                    "            // 判断为叶子节点",
                    "            // - 指定isLeaf属性",
                    "            // - loadData模式下 没有指定isLeaf为true",
                    "            // - 存在children元素",
                    "            if (!('isLeaf' in node)) {",
                    "                node.isLeaf = !((children && children.length) || props.loadData);",
                    "            }",
                    "            node.isLastChild = parent ? [].concat(parent.isLastChild || [], index === data.length - 1) : [];",
                    "",
                    "            if (key === undefined || key === null) {",
                    "                node.key = key = pos;",
                    "            }",
                    "",
                    "            if (!node.isLeaf) {",
                    "                node.children = drill(children, level + 1, pos, node);",
                    "            }",
                    "",
                    "            k2n[key] = p2n[pos] = { ...node };",
                    "",
                    "            return node;",
                    "        });"
                ]
            }
