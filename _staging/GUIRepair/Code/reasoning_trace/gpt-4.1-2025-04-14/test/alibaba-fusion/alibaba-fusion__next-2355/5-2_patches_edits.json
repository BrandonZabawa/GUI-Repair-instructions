                "REPLACE": [
                    "export const fetchDataByPath = (object, path) => {",
                    "    if (!object || !path) {",
                    "        return false;",
                    "    }",
                    "    path = path.toString();",
                    "",
                    "    // Handle '[a,b]' style dataIndex",
                    "    if (/^\\[.*\\]$/.test(path)) {",
                    "        try {",
                    "            // Remove brackets and split by comma, then trim spaces",
                    "            const keys = path.slice(1, -1).split(',').map(k => k.trim());",
                    "            // Return array of values, or undefined if object is undefined",
                    "            return keys.map(key => object ? object[key] : undefined);",
                    "        } catch (e) {",
                    "            return undefined;",
                    "        }",
                    "    }",
                    "",
                    "    const field = path.split('.');",
                    "    let val, key;",
                    "    if (field.length) {",
                    "        key = field[0];",
                    "        // lists[1].name",
                    "        if (key.indexOf('[') >= 0) {",
                    "            key = key.match(/(.*)\\[(.*)\\]/);",
                    "            if (key) {",
                    "                val = object[key[1]][key[2]];",
                    "            }",
                    "        } else {",
                    "            val = object[field[0]];",
                    "        }",
                    "        if (val) {",
                    "            for (let colIndex = 1; colIndex < field.length; colIndex++) {",
                    "                val = val[field[colIndex]];",
                    "                if (typeof val === 'undefined') {",
                    "                    break;",
                    "                }",
                    "            }",
                    "        }",
                    "    }",
                    "    return val;",
                    "};"
                ]
            }
        ]
    }
