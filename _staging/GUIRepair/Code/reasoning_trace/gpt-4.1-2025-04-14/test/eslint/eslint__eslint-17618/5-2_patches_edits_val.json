{
    "1/1": {
        "lib/linter/code-path-analysis/code-path-state.js": [
            {
                "SEARCH": [
                    "switch (context.kind) {",
                    "case \"&&\": // the false path can short-circuit.",
                    "context.falseForkContext.add(forkContext.head);",
                    "break;",
                    "case \"||\": // the true path can short-circuit.",
                    "context.trueForkContext.add(forkContext.head);",
                    "break;",
                    "case \"??\": // both can short-circuit.",
                    "context.trueForkContext.add(forkContext.head);",
                    "context.falseForkContext.add(forkContext.head);",
                    "break;",
                    "default:",
                    "throw new Error(\"unreachable\");",
                    "}"
                ],
                "REPLACE": [
                    "            switch (context.kind) {",
                    "                case \"&&\": // the false path can short-circuit.",
                    "                    context.falseForkContext.add(forkContext.head);",
                    "                    // If inside a ?? context, also add the false path to qqForkContext",
                    "                    if (context.upper && context.upper.kind === \"??\") {",
                    "                        context.upper.qqForkContext.add(forkContext.head);",
                    "                    }",
                    "                    break;",
                    "                case \"||\": // the true path can short-circuit.",
                    "                    context.trueForkContext.add(forkContext.head);",
                    "                    // If inside a ?? context, also add the true path to qqForkContext",
                    "                    if (context.upper && context.upper.kind === \"??\") {",
                    "                        context.upper.qqForkContext.add(forkContext.head);",
                    "                    }",
                    "                    break;",
                    "                case \"??\": // both can short-circuit.",
                    "                    context.trueForkContext.add(forkContext.head);",
                    "                    context.falseForkContext.add(forkContext.head);",
                    "                    break;",
                    "                default:",
                    "                    throw new Error(\"unreachable\");",
                    "            }"
                ]
            }
        ]
    }
}