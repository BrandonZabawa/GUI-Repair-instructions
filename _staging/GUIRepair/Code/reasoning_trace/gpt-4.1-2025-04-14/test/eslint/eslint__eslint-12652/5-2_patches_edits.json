                    "                (",
                    "                    (node.parent.type === \"JSXExpressionContainer\" &&",
                    "                        node.parent.parent &&",
                    "                        node.parent.parent.type === \"JSXAttribute\")",
                    "                )",
                    "            ) {",
                    "                return;",
                    "            }"
                ]
            }
