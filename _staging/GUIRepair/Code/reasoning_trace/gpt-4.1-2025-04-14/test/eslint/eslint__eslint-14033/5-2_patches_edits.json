                    "                            if (node.parent.kind === \"var\" || node.parent.kind === \"const\") {",
                    "                                return null;",
                    "                            }",
                    "",
                    "                            if (node.id.type === \"ArrayPattern\" || node.id.type === \"ObjectPattern\") {",
                    "",
