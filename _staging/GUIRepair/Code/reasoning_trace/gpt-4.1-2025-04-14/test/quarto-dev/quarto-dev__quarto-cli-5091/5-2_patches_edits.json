        "src/resources/filters/common/url.lua": [
            {
                "SEARCH": [
                    "function urldecode(url)",
                    "if url == nil then",
                    "return",
                    "end",
                    "url = url:gsub(\"+\", \" \")",
                    "url = url:gsub(\"%%(%x%x)\", function(x)",
                    "return string.char(tonumber(x, 16))",
                    "end)",
                    "return url",
                    "end",
                    ""
                ],
                "REPLACE": [
                    "function urldecode(url)",
                    "  if url == nil then",
                    "  return",
                    "  end",
                    "    url = url:gsub(\"+\", \" \")",
                    "    url = url:gsub(\"%%(%x%x)\", function(x)",
                    "      return string.char(tonumber(x, 16))",
                    "    end)",
                    "  return url",
                    "end",
                    "",
                    "-- Sanitize a URL for use as a filename",
                    "function url_to_filename(url)",
                    "  -- Replace unsafe characters with underscores",
                    "  return url:gsub(\"[/:%%?&=#+]\", \"_\")",
                    "end",
                    ""
                ]
            }
        ],
