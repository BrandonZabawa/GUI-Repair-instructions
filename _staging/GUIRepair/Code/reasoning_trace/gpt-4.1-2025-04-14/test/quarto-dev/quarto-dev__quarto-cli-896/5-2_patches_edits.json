                "REPLACE": [
                    "function requiresPanelLayout(divEl)",
                    "  -- If the div has layout attributes, use panel layout",
                    "  if hasLayoutAttributes(divEl) then",
                    "    return true",
                    "  -- latex and html require special layout markup for subcaptions",
                    "  elseif (isLatexOutput() or isHtmlOutput()) and ",
                    "          divEl.attr.classes:includes(\"tbl-parent\") then",
                    "    return true",
                    "  -- If the div has any custom class (other than default Pandoc ones), use panel layout",
                    "  elseif divEl.attr.classes ~= nil and #divEl.attr.classes > 0 then",
                    "    -- Exclude default Pandoc classes if needed (e.g., \"unnumbered\", \"incremental\")",
                    "    local default_classes = { [\"unnumbered\"]=true, [\"incremental\"]=true }",
                    "    for _, cls in ipairs(divEl.attr.classes) do",
                    "      if not default_classes[cls] then",
                    "        return true",
                    "      end",
                    "    end",
                    "    return false",
                    "  else ",
                    "    return false",
                    "  end",
                    "end"
                ]
            }
        ]
    }
}