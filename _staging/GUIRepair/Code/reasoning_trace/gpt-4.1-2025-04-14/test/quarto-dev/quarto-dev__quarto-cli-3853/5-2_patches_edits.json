                    "            local preamble = pandoc.RawBlock(\"latex\", ",
                    "              \"\\\\begin{\" .. proof.env .. \"}\" ..",
                    "              (name and (\"[\" .. pandoc.utils.stringify(pandoc.List(name)) .. \"]\") or \"\")",
