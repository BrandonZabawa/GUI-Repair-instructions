                "REPLACE": [
                    "const kHandlers: EmbedHandler[] = [",
                    "  {",
                    "    name: \"Jupyter Notebook Embed\",",
                    "    handle(",
                    "      filename: string,",
                    "      params: Record<string, unknown>,",
                    "      _handlerContext: LanguageCellHandlerContext,",
                    "    ) {",
                    "      const markdownFragments: EitherString[] = [];",
                    "",
                    "      // Resolve the filename into a path",
                    "      const notebookAddress = parseNotebookAddress(filename);",
                    "      if (notebookAddress) {",
                    "        const outputs = params.outputs as string | undefined;",
                    "        const placeHolder = notebookMarkdownPlaceholder(filename, {",
                    "          echo: params.echo !== undefined ? params.echo as boolean : false,",
                    "          warning: false,",
                    "          asis: true,",
                    "          eval: false,",
                    "        }, outputs);",
                    "",
                    "        markdownFragments.push(placeHolder);",
                    "        return Promise.resolve({",
                    "          handled: true,",
                    "          markdownFragments,",
                    "          resources: [",
                    "            notebookAddress.path,",
                    "          ],",
                    "        });",
                    "      } else {",
                    "        return Promise.resolve({",
                    "          handled: false,",
                    "          markdownFragments: [],",
                    "        });",
                    "      }",
                    "    },",
                    "  },",
                    "  // Generic file embed handler",
                    "  {",
                    "    name: \"Generic File Embed\",",
                    "    async handle(",
                    "      filename: string,",
                    "      params: Record<string, unknown>,",
                    "      handlerContext: LanguageCellHandlerContext,",
                    "    ) {",
                    "      // Only handle if not already handled by previous handlers",
                    "      // Read the file content",
                    "      try {",
                    "        // Use the handlerContext to read the file (assuming a readTextFile method exists)",
                    "        const fileContent = await handlerContext.readTextFile(filename);",
                    "        // Determine language from file extension",
                    "        const langMatch = filename.match(/\\.([a-zA-Z0-9]+)$/);",
                    "        const lang = langMatch ? langMatch[1] : \"\";",
                    "        const codeBlock = `\\`\\`\\`${lang}\\n${fileContent}\\n\\`\\`\\``;",
                    "        return {",
                    "          handled: true,",
                    "          markdownFragments: [codeBlock],",
                    "          resources: [filename],",
                    "        };",
                    "      } catch (e) {",
                    "        // If file can't be read, do not handle",
                    "        return {",
                    "          handled: false,",
                    "          markdownFragments: [],",
                    "        };",
                    "      }",
                    "    },",
                    "  },",
                    "];"
                ]
            }
        ]
