                    "function render_tabset(attr, tabs, renderer)",
                    "  -- create a unique id for the tabset",
                    "  local tabsetid = \"tabset-\" .. tabsetidx",
                    "  tabsetidx = tabsetidx + 1",
                    "",
                    "  -- collect extra nav classes (e.g., nav-fill, nav-justified)",
                    "  local navExtraClasses = {}",
                    "  for _, class in ipairs(attr.classes) do",
                    "    if class ~= \"panel-tabset\" and (class:match(\"^nav%-\")) then",
                    "      table.insert(navExtraClasses, class)",
                    "    end",
                    "  end",
                    "  local navClassAttr = \"nav nav-tabs\"",
                    "  if #navExtraClasses > 0 then",
                    "    navClassAttr = navClassAttr .. \" \" .. table.concat(navExtraClasses, \" \")",
                    "  end",
                    "",
                    "  -- init tab navigation ",
                    "  local nav = pandoc.List()",
                    "  nav:insert(pandoc.RawInline('html', '<ul class=\"' .. navClassAttr .. '\" role=\"tablist\">'))"
                ]
            },
            {
                "SEARCH": [
                    "function bootstrapTabs()",
                    "return {",
                    "ulAttribs = function(tabsetid)",
                    "return 'class=\"nav nav-tabs\" role=\"tablist\"'",
