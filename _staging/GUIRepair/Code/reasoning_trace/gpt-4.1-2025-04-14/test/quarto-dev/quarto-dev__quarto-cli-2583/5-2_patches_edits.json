                    "  -- escape special characters for LaTeX",
                    "  captionText = stringEscape(captionText, \"latex\")",
                    "  if #tblLabel > 0 then",
                    "    captionText = captionText .. \" {#\" .. tblLabel .. \"}\"",
                    "  end",
                    "  latex = latex:gsub(latexCaptionPattern, \"%1\" .. captionText:gsub(\"%%\", \"%%%%\") .. \"%3\", 1)",
                    "  return latex"
                ]
            }
        ]
    }
