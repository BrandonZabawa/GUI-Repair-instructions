{
    "1/1": {
        "src/resources/filters/crossref/theorems.lua": [
            {
                "SEARCH": [
                    "-- prepend the prefix",
                    "local caption = el.content[1]",
                    "tprepend(caption.content, {",
                    "pandoc.Span(",
                    "pandoc.Strong(prefix),",
                    "pandoc.Attr(\"\", { \"theorem-title\" })",
                    ")",
                    "})"
                ],
                "REPLACE": [
                    "          -- prepend the prefix as a caption",
                    "          local caption_block = pandoc.Para({",
                    "            pandoc.Span(",
                    "              pandoc.Strong(prefix),",
                    "              pandoc.Attr(\"\", { \"theorem-title\" })",
                    "            )",
                    "          })",
                    "          -- If the first block is a Para or Plain, prepend the caption to its content",
                    "          if #el.content > 0 and (el.content[1].t == \"Para\" or el.content[1].t == \"Plain\") then",
                    "            tprepend(el.content[1].content, caption_block.content)",
                    "          else",
                    "            -- Otherwise, insert the caption as a new paragraph at the top",
                    "            table.insert(el.content, 1, caption_block)",
                    "          end"
                ]
            }
        ]
    }
}