{
    "1/1": {
        "src/js/components/Data/Data.js": [
            {
                "SEARCH": [
                    "let toolbarContent;",
                    "if (toolbar) {",
                    "toolbarContent = [",
                    "<Toolbar key=\"toolbar\">",
                    "{(toolbar === true || toolbar === 'search') && <DataSearch />}",
                    "{(toolbar === true || toolbar === 'view') && <DataView />}",
                    "{(toolbar === true || toolbar === 'filters') && <DataFilters drop />}",
                    "</Toolbar>,",
                    "<DataSummary key=\"summary\" />,",
                    "];",
                    "}"
                ],
                "REPLACE": [
                    "  let toolbarContent;",
                    "  if (toolbar) {",
                    "    // Determine if any filters/search/view are active",
                    "    const hasActiveFilters =",
                    "      (view && (",
                    "        (view.search && view.search.length > 0) ||",
                    "        (view.filters && Object.keys(view.filters).length > 0) ||",
                    "        (view.sort && Object.keys(view.sort).length > 0)",
                    "      )) ||",
                    "      false;",
                    "",
                    "    toolbarContent = [",
                    "      <Toolbar key=\"toolbar\">",
                    "        {(toolbar === true || toolbar === 'search') && <DataSearch />}",
                    "        {(toolbar === true || toolbar === 'view') && <DataView />}",
                    "        {(toolbar === true || toolbar === 'filters') && <DataFilters drop />}",
                    "        {hasActiveFilters && (",
                    "          <Box flex={false} margin={{ start: 'small' }}>",
                    "            <Button",
                    "              label={format({",
                    "                id: 'dataFilters.clear',",
                    "                messages: messages?.dataFilters,",
                    "              })}",
                    "              onClick={contextValue.clearFilters}",
                    "            />",
                    "          </Box>",
                    "        )}",
                    "      </Toolbar>,",
                    "      <DataSummary key=\"summary\" />,",
                    "    ];",
                    "  }"
                ]
            }
        ],
        "src/js/components/DataFilters/DataFilters.js": [
            {
                "SEARCH": [
                    "const clearControl = badge && (",
                    "<Box flex={false} margin={{ start: 'small' }}>",
                    "<Button",
                    "label={format({",
                    "id: 'dataFilters.clear',",
                    "messages: messages?.dataFilters,",
                    "})}",
                    "onClick={() => {",
                    "setTouched({});",
                    "clearFilters();",
                    "}}",
                    "/>",
                    "</Box>",
                    ");"
                ],
                "REPLACE": [
                    "  // Remove clearControl from top-level, as it is now handled in Data.js toolbar",
                    "  const clearControl = null;"
                ]
            },
            {
                "SEARCH": [
                    "if (!controlled) return content;",
                    "",
                    "const tip = format({",
                    "id: badge",
                    "? `dataFilters.openSet.${badge === 1 ? 'singular' : 'plural'}`",
                    ": 'dataFilters.open',",
                    "messages: messages?.dataFilters,",
                    "values: { number: badge },",
                    "});",
                    "",
                    "let control;",
                    "if (drop) {",
                    "control = (",
                    "<DropButton",
                    "id={`${dataId}--filters-control`}",
                    "tip={tip}",
                    "aria-label={tip}",
                    "kind=\"toolbar\"",
                    "icon={<Filter />}",
                    "hoverIndicator",
                    "dropProps={dropProps}",
                    "dropContent={content}",
                    "badge={badge}",
                    "open={showContent}",
                    "onOpen={() => setShowContent(undefined)}",
                    "onClose={() => setShowContent(undefined)}",
                    "/>",
                    ");",
                    "} else if (layer) {",
                    "control = (",
                    "<Button",
                    "id={`${dataId}--filters-control`}",
                    "tip={tip}",
                    "aria-label={tip}",
                    "kind=\"toolbar\"",
                    "hoverIndicator",
                    "icon={<Filter />}",
                    "badge={badge}",
                    "onClick={() => setShowContent(true)}",
                    "/>",
                    ");",
                    "}",
                    "",
                    "return (",
                    "<Box flex={false} direction=\"row\" {...rest}>",
                    "{control}",
                    "{clearControl}",
                    "{layer && showContent && (",
                    "<Layer",
                    "id={`${dataId}--filters-layer`}",
                    "{...(typeof layer === 'object' ? layer : layerProps)}",
                    "onClickOutside={() => setShowContent(undefined)}",
                    "onEsc={() => setShowContent(undefined)}",
                    ">",
                    "{content}",
                    "</Layer>",
                    ")}",
                    "</Box>",
                    ");",
                    "};"
                ],
                "REPLACE": [
                    "  if (!controlled) return content;",
                    "",
                    "  const tip = format({",
                    "    id: badge",
                    "      ? `dataFilters.openSet.${badge === 1 ? 'singular' : 'plural'}`",
                    "      : 'dataFilters.open',",
                    "    messages: messages?.dataFilters,",
                    "    values: { number: badge },",
                    "  });",
                    "",
                    "  let control;",
                    "  if (drop) {",
                    "    control = (",
                    "      <DropButton",
                    "        id={`${dataId}--filters-control`}",
                    "        tip={tip}",
                    "        aria-label={tip}",
                    "        kind=\"toolbar\"",
                    "        icon={<Filter />}",
                    "        hoverIndicator",
                    "        dropProps={dropProps}",
                    "        dropContent={content}",
                    "        badge={badge}",
                    "        open={showContent}",
                    "        onOpen={() => setShowContent(undefined)}",
                    "        onClose={() => setShowContent(undefined)}",
                    "      />",
                    "    );",
                    "  } else if (layer) {",
                    "    control = (",
                    "      <Button",
                    "        id={`${dataId}--filters-control`}",
                    "        tip={tip}",
                    "        aria-label={tip}",
                    "        kind=\"toolbar\"",
                    "        hoverIndicator",
                    "        icon={<Filter />}",
                    "        badge={badge}",
                    "        onClick={() => setShowContent(true)}",
                    "      />",
                    "    );",
                    "  }",
                    "",
                    "  return (",
                    "    <Box flex={false} direction=\"row\" {...rest}>",
                    "      {control}",
                    "      {layer && showContent && (",
                    "        <Layer",
                    "          id={`${dataId}--filters-layer`}",
                    "          {...(typeof layer === 'object' ? layer : layerProps)}",
                    "          onClickOutside={() => setShowContent(undefined)}",
                    "          onEsc={() => setShowContent(undefined)}",
                    "        >",
                    "          {content}",
                    "        </Layer>",
                    "      )}",
                    "    </Box>",
                    "  );",
                    "};"
                ]
            }
        ]
    }
}