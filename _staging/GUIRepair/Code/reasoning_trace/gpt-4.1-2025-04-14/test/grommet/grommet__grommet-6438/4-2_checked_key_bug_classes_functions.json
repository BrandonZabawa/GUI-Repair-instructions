            "function_code": [
                "export const withinDates = (date, dates) => {",
                "  let result;",
                "  if (dates) {",
                "    if (Array.isArray(dates)) {",
                "      dates.some((d) => {",
                "        if (d instanceof Date) {",
                "          if (sameDay(date, d)) {",
                "            result = 2;",
                "          }",
                "        } else {",
                "          result = betweenDates(date, d);",
                "        }",
                "        return result;",
                "      });",
                "    } else if (sameDay(date, dates)) {",
                "      result = 2;",
                "    }",
                "  }",
                "  return result;",
                "};"
            ]
        }
