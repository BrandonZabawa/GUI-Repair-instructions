            "function_code": [
                "export const betweenDates = (date, dates) => {",
                "  let result;",
                "  if (dates) {",
                "    const [from, to] = Array.isArray(dates)",
                "      ? dates.map((d) => (d ? new Date(d) : undefined))",
                "      : [dates, undefined];",
                "    if ((from && sameDay(date, from)) || (to && sameDay(date, to))) {",
                "      result = 2;",
                "    } else if (",
                "      from &&",
                "      sameDayOrAfter(date, from) &&",
                "      to &&",
                "      sameDayOrBefore(date, to)",
                "    ) {",
                "      result = 1;",
                "    }",
                "  } else {",
                "    result = 1;",
                "  }",
                "  return result;",
                "};"
            ]
        },
