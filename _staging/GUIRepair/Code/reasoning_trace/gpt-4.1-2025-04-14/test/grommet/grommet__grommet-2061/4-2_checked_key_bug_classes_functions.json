                "  width: 100%;",
                "",
                "  ${props => props.size && sizeStyle(props)}",
                "  ${props => props.plain && plainStyle}",
                "",
                "  &::-webkit-input-placeholder {",
                "    ${placeholderColor}",
                "  }",
                "",
                "  &::-moz-placeholder {",
                "    ${placeholderColor}",
                "  }",
