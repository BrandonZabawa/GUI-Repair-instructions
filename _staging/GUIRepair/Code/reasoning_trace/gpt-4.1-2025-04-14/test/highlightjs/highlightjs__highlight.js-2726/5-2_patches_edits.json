{
    "1/1": {
        "src/languages/latex.js": [
            {
                "SEARCH": [
                    "{",
                    "className: 'string', // because it looks like attributes in HTML tags",
                    "variants: [",
                    "{begin: /\\[/, end: /\\]/},",
                    "{begin: /\\{/, end: /\\}/}",
                    "]",
                    "},"
                ],
                "REPLACE": [
                    "{",
                    "className: 'string', // because it looks like attributes in HTML tags",
                    "variants: [",
                    "{begin: /\\[/, end: /\\]/}",
                    "]",
                    "},",
                    "// Allow normal LaTeX parsing inside braces",
                    "{",
                    "begin: /\\{/,",
                    "end: /\\}/,",
                    "contains: [] // will be filled later to allow recursion",
                    "},"
                ]
            },
            {
                "SEARCH": [
                    "return {",
                    "name: 'LaTeX',",
                    "aliases: ['tex'],",
                    "contains: [",
                    "COMMAND,",
                    "{",
                    "className: 'formula',",
                    "contains: [COMMAND],",
                    "relevance: 0,",
                    "variants: [",
                    "{begin: /\\$\\$/, end: /\\$\\$/},",
                    "{begin: /\\$/, end: /\\$/}",
                    "]",
                    "},",
                    "hljs.COMMENT(",
                    "'%',",
                    "'$',",
                    "{",
                    "relevance: 0",
                    "}",
                    ")",
                    "]",
                    "};",
                    "}"
                ],
                "REPLACE": [
                    "// Helper to allow recursion for braces",
                    "const BRACES = {",
                    "begin: /\\{/,",
                    "end: /\\}/,",
                    "contains: [] // will be filled with main contains",
                    "};",
                    "",
                    "// Now fill the contains for braces with the main contains",
                    "const MAIN_CONTAINS = [",
                    "COMMAND,",
                    "{",
                    "className: 'formula',",
                    "contains: [COMMAND],",
                    "relevance: 0,",
                    "variants: [",
                    "{begin: /\\$\\$/, end: /\\$\\$/},",
                    "{begin: /\\$/, end: /\\$/}",
                    "]",
                    "},",
                    "hljs.COMMENT(",
                    "'%',",
                    "'$',",
                    "{",
                    "relevance: 0",
                    "}",
                    ")",
                    "];",
                    "BRACES.contains = MAIN_CONTAINS;",
                    "",
                    "// Add braces to main contains",
                    "MAIN_CONTAINS.push(BRACES);",
                    "",
                    "return {",
                    "name: 'LaTeX',",
                    "aliases: ['tex'],",
                    "contains: MAIN_CONTAINS",
                    "};",
                    "}"
                ]
            }
        ]
    },
