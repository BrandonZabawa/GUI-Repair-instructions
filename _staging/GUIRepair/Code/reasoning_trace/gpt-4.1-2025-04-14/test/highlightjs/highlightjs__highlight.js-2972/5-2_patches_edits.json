                    "begin: /->/, endsWithParent: true,",
                    "keywords: 'None'",
                    "}",
                    "]",
                    "},",
                    "{",
                    "className: 'meta',",
                    "begin: /^[\\t ]*@/, end: /(?=#)|$/,",
                    "contains: [NUMBER, PARAMS, STRING]",
