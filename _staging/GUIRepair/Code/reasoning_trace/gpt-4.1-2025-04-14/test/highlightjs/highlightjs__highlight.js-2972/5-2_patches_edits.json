                    "keywords: KEYWORDS,",
                    "contains: ['self', PROMPT, NUMBER, STRING, hljs.HASH_COMMENT_MODE, TYPE_HINT],",
                    "},",
                    "],",
                    "};",
                    "SUBST.contains = [STRING, NUMBER, PROMPT];",
                    "",
                    "return {",
                    "name: 'Python',"
                ]
            },
            {
                "SEARCH": [
                    "contains: [",
                    "PROMPT,",
                    "NUMBER,",
                    "// eat \"if\" prior to string so that it won't accidentally be",
