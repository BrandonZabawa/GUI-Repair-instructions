        "src/languages/python.js": [
            {
                "SEARCH": [
                    "const PARAMS = {",
                    "className: 'params',",
                    "variants: [",
                    "// Exclude params at functions without params",
                    "{begin: /\\(\\s*\\)/, skip: true, className: null },",
                    "{",
                    "begin: /\\(/, end: /\\)/, excludeBegin: true, excludeEnd: true,",
                    "keywords: KEYWORDS,",
                    "contains: ['self', PROMPT, NUMBER, STRING, hljs.HASH_COMMENT_MODE],",
                    "},",
                    "],",
                    "};",
                    "SUBST.contains = [STRING, NUMBER, PROMPT];",
                    "",
                    "return {",
                    "name: 'Python',"
                ],
                "REPLACE": [
                    "// Type hint highlighting for function parameters and return types",
                    "const TYPE_HINT = {",
                    "className: 'type',",
                    "// Matches type hints like \": Type\" or \": List[str]\" or \"-> Type\"",
                    "begin: /(?::|->)\\s*[a-zA-Z_][\\w\\.\\[\\], ]*/,",
                    "relevance: 0",
                    "};",
                    "",
                    "// Type comment highlighting: \"# type: ...\"",
                    "const TYPE_COMMENT = {",
                    "className: 'comment',",
                    "begin: /#\\s*type:/,",
                    "end: /$/,",
                    "contains: [",
                    "{",
                    "className: 'type',",
                    "begin: /type:\\s*/,",
                    "end: /$/,",
                    "excludeBegin: true",
                    "}",
                    "]",
                    "};",
                    "",
                    "const PARAMS = {",
                    "className: 'params',",
                    "variants: [",
                    "// Exclude params at functions without params",
