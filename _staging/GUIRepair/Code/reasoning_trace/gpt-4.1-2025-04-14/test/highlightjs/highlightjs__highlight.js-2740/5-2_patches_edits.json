{
    "1/1": {
        "src/languages/sql.js": [
            {
                "SEARCH": [
                    "{",
                    "className: 'string',",
                    "begin: '\\'', end: '\\'',",
                    "contains: [{begin: '\\'\\'\\'}]",
                    "},"
                ],
                "REPLACE": [
                    "{",
                    "className: 'string',",
                    "// Improved pattern: handles escaped single quotes (''), and terminates correctly",
                    "begin: /'/,",
                    "end: /'/,",
                    "contains: [{begin: /''/}],",
                    "// Match any sequence of (escaped quote or non-quote char), then closing quote",
                    "// This prevents runaway strings on nested/escaped quotes",
                    "relevance: 0",
                    "},"
                ]
            }
        ]
    },
