{
    "1/1": {
        "src/languages/javascript.js": [
            {
                "SEARCH": [
                    "const SUBST = {",
                    "className: 'subst',",
                    "begin: '\\\\${',",
                    "end: '\\\\}',",
                    "keywords: KEYWORDS,",
                    "contains: [] // defined later",
                    "};"
                ],
                "REPLACE": [
                    "const SUBST = {",
                    "className: 'subst',",
                    "begin: '\\\\${',",
                    "end: '\\\\}',",
                    "keywords: KEYWORDS,",
                    "contains: [] // defined later",
                    "};",
                    "",
                    "// Add recursive brace matching for nested objects/functions in template substitutions",
                    "const NESTED_BRACES = {",
                    "begin: /\\{/,",
                    "end: /\\}/,",
                    "contains: [",
                    "\"self\",",
                    "// Allow all the same things as in SUBST",
                    "hljs.APOS_STRING_MODE,",
                    "hljs.QUOTE_STRING_MODE,",
                    "// Allow template strings inside nested braces",
                    "{",
                    "begin: /`/,",
                    "end: /`/,",
                    "contains: [",
                    "hljs.BACKSLASH_ESCAPE,",
                    "// Allow nested substitutions",
                    "// This will be replaced with SUBST after SUBST is defined",
                    "]",
                    "},",
                    "// Numbers, regex, etc.",
                    "HTML_TEMPLATE,",
                    "CSS_TEMPLATE,",
                    "TEMPLATE_STRING,",
                    "NUMBER,",
                    "hljs.REGEXP_MODE",
                    "]",
                    "};",
                    "",
                    "// Now that NESTED_BRACES is defined, we can set SUBST.contains",
                    "// (We need to do this after NESTED_BRACES is defined to avoid circular reference issues)"
                ]
            },
            {
                "SEARCH": [
                    "SUBST.contains = [",
                    "hljs.APOS_STRING_MODE,",
                    "hljs.QUOTE_STRING_MODE,",
                    "HTML_TEMPLATE,",
                    "CSS_TEMPLATE,",
                    "TEMPLATE_STRING,",
                    "NUMBER,",
                    "hljs.REGEXP_MODE",
                    "];"
                ],
                "REPLACE": [
                    "// Add NESTED_BRACES to allow for nested objects/functions in template substitutions",
                    "NESTED_BRACES.contains[2].contains.push(SUBST); // Add SUBST to template string inside nested braces",
                    "",
                    "SUBST.contains = [",
                    "hljs.APOS_STRING_MODE,",
                    "hljs.QUOTE_STRING_MODE,",
                    "HTML_TEMPLATE,",
                    "CSS_TEMPLATE,",
                    "TEMPLATE_STRING,",
                    "NUMBER,",
                    "hljs.REGEXP_MODE,",
                    "NESTED_BRACES",
                    "];"
                ]
            }
        ]
    },
