            "function_code": [
                "const expandClassName = (name, { prefix }) => {",
                "  if (name.includes(\".\")) {",
                "    const pieces = name.split(\".\");",
                "    return pieces.map(x => `${prefix}${x}`).join(\" \");",
                "  }",
                "  return `${prefix}${name}`;",
                "};"
            ]
        }
    }
