{
    "1/1": {
        "src/lib/html_renderer.js": [
            {
                "SEARCH": [
                    "openNode(node) {",
                    "if (!emitsWrappingTags(node)) return;",
                    "",
                    "let className = node.kind;",
                    "if (!node.sublanguage) {",
                    "className = expandClassName(className, { prefix: this.classPrefix });",
                    "}",
                    "this.span(className);",
                    "}"
                ],
                "REPLACE": [
                    "openNode(node) {",
                    "if (!emitsWrappingTags(node)) return;",
                    "",
                    "let className = node.kind;",
                    "// Avoid adding the un-prefixed language class for the root language node",
                    "if (!node.sublanguage && node.kind !== node.language) {",
                    "className = expandClassName(className, { prefix: this.classPrefix });",
                    "} else if (!node.sublanguage) {",
                    "// For the root language node, only add the prefixed class",
                    "className = `${this.classPrefix}${className}`;",
                    "}",
                    "this.span(className);",
                    "}"
                ]
            }
        ]
    },
