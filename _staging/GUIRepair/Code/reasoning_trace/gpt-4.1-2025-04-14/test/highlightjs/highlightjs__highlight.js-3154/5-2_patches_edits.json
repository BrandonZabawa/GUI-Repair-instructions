{
    "1/1": {
        "src/languages/ruby.js": [
            {
                "SEARCH": [
                    "{ // heredocs",
                    "begin: /<<[-~]?\\'?(\\w+)\\n(?:[^\\n]*\\n)*?\\s*\\1\\b/,",
                    "returnBegin: true,",
                    "contains: [",
                    "{",
                    "begin: /<<[-~]?\\'?/",
                    "},",
                    "hljs.END_SAME_AS_BEGIN({",
                    "begin: /(\\w+)/,",
                    "end: /(\\w+)/,",
                    "contains: [",
                    "hljs.BACKSLASH_ESCAPE,",
                    "SUBST",
                    "]",
                    "})",
                    "]",
                    "}"
                ],
                "REPLACE": [
                    "{ // heredocs",
                    "// Handles: <<IDENT, <<-IDENT, <<~IDENT, <<'IDENT', <<\"IDENT\", <<`IDENT`",
                    "begin: /<<[-~]?(?:['\"`])?(\\w+)(?:['\"`])?\\n(?:[\\s\\S]*?\\n)?\\s*\\1\\b/,",
                    "returnBegin: true,",
                    "contains: [",
                    "{",
                    "// Match the heredoc opening, including optional quotes",
                    "begin: /<<[-~]?(?:['\"`])?(\\w+)(?:['\"`])?/",
                    "},",
                    "{",
                    "// The heredoc body, ending with the correct delimiter",
                    "begin: /(?<=\\n)/,",
                    "end: /(?=^\\s*\\1\\b)/m,",
                    "subLanguage: null,",
                    "contains: [",
                    "hljs.BACKSLASH_ESCAPE,",
                    "SUBST",
                    "]",
                    "},",
                    "{",
                    "// The ending delimiter itself",
                    "begin: /^\\s*(\\w+)\\b/m",
                    "}",
                    "]",
                    "}"
                ]
            }
        ]
    },
