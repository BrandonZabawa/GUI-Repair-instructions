                "REPLACE": [
                    "    handleSetModeToSlider () {",
                    "        this.props.vm.runtime.requestUpdateMonitor(Map({",
                    "            id: this.props.id,",
                    "            mode: 'slider'",
                    "        }));",
                    "    }",
                    "    handleSetSliderRange () {",
                    "        // Prompt for min and max",
                    "        let min = prompt('Enter slider minimum value:', this.props.min);",
                    "        if (min === null) return;",
                    "        let max = prompt('Enter slider maximum value:', this.props.max);",
                    "        if (max === null) return;",
                    "        min = Number(min);",
                    "        max = Number(max);",
                    "        if (isNaN(min) || isNaN(max) || min >= max) {",
                    "            alert('Invalid range. Min must be less than max and both must be numbers.');",
                    "            return;",
                    "        }",
                    "        this.props.vm.runtime.requestUpdateMonitor(Map({",
                    "            id: this.props.id,",
                    "            min: min,",
                    "            max: max",
                    "        }));",
                    "    }"
                ]
            },
