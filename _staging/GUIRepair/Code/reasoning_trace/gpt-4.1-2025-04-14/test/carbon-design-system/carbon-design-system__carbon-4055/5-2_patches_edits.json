                "REPLACE": [
                    "    const content = this.getChildren().map((child, index) => {",
                    "      return React.cloneElement(child, { ref: index });",
                    "    });",
                    "    const buttonId = this.props.id ? `${this.props.id}__button` : this.uid;",
                    "    const aboveTheFoldId = this.props.id ? `${this.props.id}__above` : `${this.uid}__above`;",
                    "    const belowTheFoldId = this.props.id ? `${this.props.id}__below` : `${this.uid}__below`;",
                    "",
                    "    // Split children into above and below the fold",
                    "    const [aboveTheFold, ...belowTheFold] = content;",
                    "",
                    "    return (",
                    "      <div",
                    "        ref={tile => {",
                    "          this.tile = tile;",
                    "        }}",
                    "        style={tileStyle}",
                    "        className={classes}",
                    "        {...other}",
                    "        // Remove tabIndex from the container, focus should be on the button",
                    "        // onClick and onKeyPress removed from container, handled by button",
                    "      >",
                    "        <div",
                    "          id={aboveTheFoldId}",
                    "          className={`${prefix}--tile-content__above-the-fold`}",
                    "          // Add heading role for screen readers",
                    "          role=\"heading\"",
                    "          aria-level=\"2\"",
                    "        >",
                    "          {aboveTheFold}",
                    "        </div>",
                    "        <button",
                    "          className={`${prefix}--tile__chevron`}",
                    "          aria-controls={belowTheFoldId}",
                    "          aria-expanded={expanded}",
                    "          aria-label={",
                    "            expanded",
                    "              ? `${tileExpandedIconText}, collapse to hide additional content`",
                    "              : `${tileCollapsedIconText}, expand to show more content`",
                    "          }",
                    "          id={buttonId}",
                    "          onClick={this.handleClick}",
                    "          onKeyDown={this.handleKeyDown}",
                    "        >",
                    "          <ChevronDown16",
                    "            aria-hidden=\"true\"",
                    "            // Remove aria-label/alt/description from icon, handled by button",
                    "          />",
                    "        </button>",
                    "        <div",
                    "          id={belowTheFoldId}",
                    "          ref={tileContent => {",
                    "            this.tileContent = tileContent;",
                    "          }}",
                    "          className={`${prefix}--tile-content__below-the-fold`}",
                    "          // Hide below-the-fold content from screen readers when collapsed",
                    "          aria-hidden={!expanded}",
                    "          tabIndex={expanded ? 0 : -1}",
                    "          style={{ display: expanded ? undefined : 'none' }}",
                    "        >",
                    "          {belowTheFold}",
                    "        </div>",
                    "      </div>",
                    "    );",
                    "  }",
