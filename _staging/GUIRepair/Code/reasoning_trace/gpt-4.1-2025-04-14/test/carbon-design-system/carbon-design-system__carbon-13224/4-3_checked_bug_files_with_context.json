        "          top: `${position[1]}px`,",
        "        }}>",
        "        {children}",
        "      </ul>",
        "    </MenuContext.Provider>",
        "  );",
        "",
        "  return isRoot ? (open && createPortal(rendered, target)) || null : rendered;",
        "});",
