{
    "1/1": {
        "packages/react/src/components/StructuredList/StructuredList.js": [
            {
                "SEARCH": [
                    "aria-label={deprecatedAriaLabel || ariaLabel}>",
                    "{children}",
                    "</div>"
                ],
                "REPLACE": [
                    "          aria-label={ariaLabel || deprecatedAriaLabel}>",
                    "          {children}",
                    "        </div>"
                ]
            }
        ],
        "packages/react/src/components/CodeSnippet/CodeSnippet.js": [
            {
                "SEARCH": [
                    "aria-label={deprecatedAriaLabel || ariaLabel}",
                    "aria-describedby={uid}",
                    "className={codeSnippetClasses}",
                    "feedback={feedback}",
                    "feedbackTimeout={feedbackTimeout}>"
                ],
                "REPLACE": [
                    "        aria-label={ariaLabel || deprecatedAriaLabel}",
                    "        aria-describedby={uid}",
                    "        className={codeSnippetClasses}",
                    "        feedback={feedback}",
                    "        feedbackTimeout={feedbackTimeout}>"
                ]
            },
            {
                "SEARCH": [
                    "aria-label={deprecatedAriaLabel || ariaLabel || 'code-snippet'}",
                    "aria-readonly={type === 'single' || type === 'multi' ? true : null}",
                    "aria-multiline={type === 'multi' ? true : null}",
                    "onScroll={(type === 'single' && handleScroll) || null}",
                    "{...containerStyle}>"
                ],
                "REPLACE": [
                    "        aria-label={ariaLabel || deprecatedAriaLabel || 'code-snippet'}",
                    "        aria-readonly={type === 'single' || type === 'multi' ? true : null}",
                    "        aria-multiline={type === 'multi' ? true : null}",
                    "        onScroll={(type === 'single' && handleScroll) || null}",
                    "        {...containerStyle}>"
                ]
            }
        ]
    }
}