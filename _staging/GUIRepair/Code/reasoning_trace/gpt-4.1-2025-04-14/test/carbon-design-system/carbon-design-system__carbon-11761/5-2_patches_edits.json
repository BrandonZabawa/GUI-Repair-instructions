                "REPLACE": [
                    "const TableContainer = ({",
                    "  className,",
                    "  children,",
                    "  title,",
                    "  description,",
                    "  stickyHeader,",
                    "  useStaticWidth,",
                    "  ...rest",
                    "}) => {",
                    "  const prefix = usePrefix();",
                    "  const tableContainerClasses = cx(",
                    "    className,",
                    "    `${prefix}--data-table-container`,",
                    "    {",
                    "      [`${prefix}--data-table--max-width`]: stickyHeader,",
                    "      [`${prefix}--data-table-container--static`]: useStaticWidth,",
                    "    }",
                    "  );",
                    "",
                    "  // Generate unique IDs for title and description if they exist",
                    "  const titleId = title ? `${prefix}--data-table-header__title-${Math.random().toString(36).substr(2, 9)}` : undefined;",
                    "  const descriptionId = description ? `${prefix}--data-table-header__description-${Math.random().toString(36).substr(2, 9)}` : undefined;",
                    "",
                    "  // If children is a valid React element, clone it and pass aria-labelledby/aria-describedby",
                    "  let childrenWithAria = children;",
                    "  if (React.isValidElement(children)) {",
                    "    childrenWithAria = React.cloneElement(children, {",
                    "      'aria-labelledby': titleId,",
                    "      'aria-describedby': descriptionId,",
                    "    });",
                    "  }",
                    "",
                    "  return (",
                    "    <div {...rest} className={tableContainerClasses}>",
                    "      {title && (",
                    "        <div className={`${prefix}--data-table-header`}>",
                    "          <h4",
                    "            className={`${prefix}--data-table-header__title`}",
                    "            id={titleId}",
                    "          >",
                    "            {title}",
                    "          </h4>",
                    "          <p",
                    "            className={`${prefix}--data-table-header__description`}",
                    "            id={descriptionId}",
                    "          >",
                    "            {description}",
                    "          </p>",
                    "        </div>",
                    "      )}",
                    "      {childrenWithAria}",
                    "    </div>",
                    "  );",
                    "};"
                ]
            }
