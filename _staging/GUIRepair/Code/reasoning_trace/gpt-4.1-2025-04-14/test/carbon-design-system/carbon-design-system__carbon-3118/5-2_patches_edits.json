                "REPLACE": [
                    "const ListBoxSelection = ({",
                    "  clearSelection,",
                    "  selectionCount,",
                    "  translateWithId: t,",
                    "}) => {",
                    "  const isMulti = typeof selectionCount === 'number' && selectionCount > 0;",
                    "  const className = cx(",
                    "    `${prefix}--list-box__selection`,",
                    "    {",
                    "      [`${prefix}--list-box__selection--multi`]: isMulti,",
                    "      [`${prefix}--tag--filter`]: isMulti,",
                    "    }",
                    "  );",
                    "  const handleOnClick = event => {",
                    "    event.stopPropagation();",
                    "    clearSelection(event);",
                    "  };",
                    "  const handleOnKeyDown = event => {",
                    "    // When a user hits ENTER, we'll clear the selection",
                    "    if (event.keyCode === 13) {",
                    "      clearSelection(event);",
                    "    }",
                    "  };",
                    "  const description = isMulti ? t('clear.all') : t('clear.selection');",
                    "  return (",
                    "    <div",
                    "      role=\"button\"",
                    "      className={className}",
                    "      tabIndex=\"0\"",
                    "      onClick={handleOnClick}",
                    "      onKeyDown={handleOnKeyDown}",
                    "      title={description}>",
                    "      {isMulti ? selectionCount : null}",
                    "      <Close16 role=\"img\" />",
                    "    </div>",
                    "  );",
                    "};"
                ]
            }
        ]
    }
