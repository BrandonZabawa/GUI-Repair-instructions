@@ -28,6 +28,21 @@ class CodeSnippet extends mixin(
     super(element, options);
 
     this._initCodeSnippet();
+
+    // If disabled, add disabled class and do not attach event listeners
+    if (this.element.hasAttribute('disabled') || this.element.classList.contains(`${settings.prefix}--snippet--disabled`)) {
+      this.element.classList.add(`${settings.prefix}--snippet--disabled`);
+      this.element.setAttribute('aria-disabled', 'true');
+      // Optionally, disable all buttons inside
+      const btns = this.element.querySelectorAll('button, [tabindex]');
+      btns.forEach(btn => {
+        btn.setAttribute('disabled', 'true');
+        btn.setAttribute('tabindex', '-1');
+        btn.setAttribute('aria-disabled', 'true');
+      });
+      return;
+    }
+
     this.element
       .querySelector(this.options.classExpandBtn)
       .addEventListener('click', (evt) => this._handleClick(evt));
