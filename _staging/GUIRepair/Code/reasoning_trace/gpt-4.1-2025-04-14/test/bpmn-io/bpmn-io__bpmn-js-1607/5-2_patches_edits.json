                "REPLACE": [
                    "export function createCategoryValue(definitions, bpmnFactory) {",
                    "  // Always ensure category is added to the global definitions' rootElements",
                    "  // to avoid unresolved references on import",
                    "",
                    "  // Find the global definitions if not already",
                    "  var globalDefinitions = definitions;",
                    "  if (globalDefinitions.$type !== 'bpmn:Definitions' && globalDefinitions.$parent) {",
                    "    while (globalDefinitions.$parent) {",
                    "      globalDefinitions = globalDefinitions.$parent;",
                    "      if (globalDefinitions.$type === 'bpmn:Definitions') {",
                    "        break;",
                    "      }",
                    "    }",
                    "  }",
                    "",
                    "  var categoryValue = bpmnFactory.create('bpmn:CategoryValue'),",
                    "      category = bpmnFactory.create('bpmn:Category', {",
                    "        categoryValue: [ categoryValue ]",
                    "      });",
                    "",
                    "  // add to correct place (always global definitions)",
                    "  collectionAdd(globalDefinitions.get('rootElements'), category);",
                    "  getBusinessObject(category).$parent = globalDefinitions;",
                    "  getBusinessObject(categoryValue).$parent = category;",
                    "",
                    "  return categoryValue;",
                    "}"
                ]
            }
        ]
    }
}