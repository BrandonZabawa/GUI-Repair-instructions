                    "  if (is(oldBusinessObject, 'bpmn:Activity')) {",
                    "",
                    "    if (isSubProcess(oldBusinessObject)) {",
                    "",
                    "      // no toggeling, so keep old state",
                    "      newElement.isExpanded = isExpanded(element);",
                    "    }",
                    "",
                    "    // else if property is explicitly set, use it",
                    "    else if (target && has(target, 'isExpanded')) {",
                    "      newElement.isExpanded = target.isExpanded;",
                    "    }",
                    "",
                    "    // If converting from a non-SubProcess (e.g., Call Activity) to an expanded SubProcess,",
                    "    // set to default SubProcess size",
                    "    if (",
                    "      !isSubProcess(oldBusinessObject) &&",
                    "      is(newBusinessObject, 'bpmn:SubProcess') &&",
                    "      newElement.isExpanded",
                    "    ) {",
                    "      const defaultSize = elementFactory.getDefaultSize({ type: 'bpmn:SubProcess' });",
                    "      newElement.width = defaultSize.width;",
                    "      newElement.height = defaultSize.height;",
                    "    }",
                    "    // copy size, from an expanded subprocess to an expanded alternative subprocess",
                    "    // except bpmn:Task, because Task is always expanded",
                    "    else if ((isExpanded(element) && !is(oldBusinessObject, 'bpmn:Task')) && newElement.isExpanded) {",
                    "      newElement.width = element.width;",
                    "      newElement.height = element.height;",
                    "    }",
                    "  }"
