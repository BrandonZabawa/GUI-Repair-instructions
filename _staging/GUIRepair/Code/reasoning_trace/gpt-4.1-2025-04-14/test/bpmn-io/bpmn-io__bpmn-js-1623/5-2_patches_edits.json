                "REPLACE": [
                    "  eventBus.on('import.done', function() {",
                    "    elementRegistry.filter(function(e) {",
                    "      return self.canDrillDown(e);",
                    "    }).map(function(el) {",
                    "      self.addOverlay(el);",
                    "    });",
                    "  });",
                    "",
                    "  // Add overlays when the root element (diagram/plane) is changed",
                    "  eventBus.on('root.set', function(event) {",
                    "    var rootElement = event.element;",
                    "    // Remove all existing drilldown overlays",
                    "    elementRegistry.forEach(function(e) {",
                    "      self.removeOverlay(e);",
                    "    });",
                    "    // Add overlays for all elements in the new root that can drill down",
                    "    elementRegistry.filter(function(e) {",
                    "      // Only consider elements in the current root",
                    "      return e.parent === rootElement && self.canDrillDown(e);",
                    "    }).forEach(function(el) {",
                    "      self.addOverlay(el);",
                    "    });",
                    "  });",
                    "",
                    "}"
                ]
            }
        ]
