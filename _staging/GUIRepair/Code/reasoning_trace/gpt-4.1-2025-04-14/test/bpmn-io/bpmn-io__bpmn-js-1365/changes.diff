   var handlers = this.handlers = {
+    'bpmn:DataObjectReference': function(parentGfx, element) {
+      // Draw the DataObject shape
+      var rect = drawRect(parentGfx, element.width, element.height, 0, {
+        fill: getFillColor(element, defaultFillColor),
+        stroke: getStrokeColor(element, defaultStrokeColor)
+      });
+
+      // Draw the folded corner
+      var path = svgCreate('path');
+      var cornerWidth = Math.min(element.width, element.height) * 0.25;
+      var d = [
+        'M', element.width - cornerWidth, 0,
+        'L', element.width, cornerWidth,
+        'L', element.width, 0,
+        'Z'
+      ].join(' ');
+      svgAttr(path, {
+        d: d,
+        fill: getFillColor(element, defaultFillColor),
+        stroke: getStrokeColor(element, defaultStrokeColor)
+      });
+      svgAppend(parentGfx, path);
+
+      // Draw collection marker if isCollection
+      var bo = getSemantic(element);
+      if (bo && (bo.isCollection || (bo.dataObjectRef && bo.dataObjectRef.isCollection))) {
+        var markerWidth = 12, markerHeight = 8;
+        var markerX = (element.width - markerWidth) / 2;
+        var markerY = element.height - markerHeight - 4;
+        for (var i = 0; i < 3; i++) {
+          var line = svgCreate('rect');
+          svgAttr(line, {
+            x: markerX + i * 4,
+            y: markerY,
+            width: 2,
+            height: markerHeight,
+            fill: getStrokeColor(element, defaultStrokeColor)
+          });
+          svgAppend(parentGfx, line);
+        }
+      }
+
+      return rect;
+    },
