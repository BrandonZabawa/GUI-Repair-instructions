diff --git a/lib/features/popup-menu/ReplaceMenuProvider.js b/lib/features/popup-menu/ReplaceMenuProvider.js
index c11a224c..0c2ed6c8 100644
--- a/lib/features/popup-menu/ReplaceMenuProvider.js
+++ b/lib/features/popup-menu/ReplaceMenuProvider.js
@@ -262,6 +262,33 @@ ReplaceMenuProvider.prototype.getHeaderEntries = function(element) {
     headerEntries.push(this._getAdHocEntry(element));
   }
 
+  // Add collection marker toggle for DataObjectReference and DataObject
+  if (is(element, 'bpmn:DataObjectReference') || is(element, 'bpmn:DataObject')) {
+    var businessObject = getBusinessObject(element);
+    var isCollection = businessObject.isCollection || (businessObject.dataObjectRef && businessObject.dataObjectRef.isCollection);
+
+    headerEntries.push({
+      id: 'toggle-collection',
+      className: 'bpmn-icon-collection-marker',
+      title: this._translate('Collection'),
+      active: !!isCollection,
+      action: (event, entry) => {
+        // Toggle isCollection on the correct object
+        if (businessObject.dataObjectRef) {
+          this._modeling.updateProperties(element, {
+            dataObjectRef: Object.assign({}, businessObject.dataObjectRef, {
+              isCollection: !businessObject.dataObjectRef.isCollection
+            })
+          });
+        } else {
+          this._modeling.updateProperties(element, {
+            isCollection: !businessObject.isCollection
+          });
+        }
+      }
+    });
+  }
+
   return headerEntries;
 };
 
