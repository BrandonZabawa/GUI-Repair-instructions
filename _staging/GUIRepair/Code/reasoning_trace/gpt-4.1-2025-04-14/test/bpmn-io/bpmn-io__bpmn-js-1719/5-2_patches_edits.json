            {
                "SEARCH": [
                    "function hideEmptyLabels(children) {",
                    "if (children.length) {",
                    "children.forEach(function(child) {",
                    "if (child.type === 'label' && !child.businessObject.name) {",
                    "child.hidden = true;",
                    "}",
                    "});",
                    "}",
                    "}"
                ],
                "REPLACE": [
                    "  function hideEmptyLabels(children) {",
                    "    if (children.length) {",
                    "      children.forEach(function(child) {",
                    "        if (child.type === 'label' && !child.businessObject.name) {",
                    "          child.hidden = true;",
                    "        }",
                    "      });",
                    "    }",
                    "  }",
                    "",
                    "  function hideAllLabels(children) {",
                    "    if (children.length) {",
                    "      children.forEach(function(child) {",
                    "        if (child.type === 'label') {",
                    "          child.hidden = true;",
                    "        }",
                    "      });",
                    "    }",
                    "  }",
                    "",
                    "  function showAllLabels(children) {",
                    "    if (children.length) {",
                    "      children.forEach(function(child) {",
                    "        if (child.type === 'label') {",
                    "          child.hidden = false;",
                    "        }",
                    "      });",
                    "    }",
                    "  }"
                ]
            },
            {
                "SEARCH": [
                    "this.executed([ 'shape.toggleCollapse' ], LOW_PRIORITY, function(e) {",
                    "",
                    "var context = e.context,",
                    "shape = context.shape;",
                    "",
                    "if (!is(shape, 'bpmn:SubProcess')) {",
                    "return;",
                    "}",
                    "",
                    "if (!shape.collapsed) {",
                    "",
                    "// all children got made visible through djs, hide empty labels",
                    "hideEmptyLabels(shape.children);",
                    "",
                    "// remove collapsed marker",
                    "getDi(shape).isExpanded = true;",
                    "} else {",
                    "",
                    "// place collapsed marker",
                    "getDi(shape).isExpanded = false;",
                    "}",
                    "});"
                ],
                "REPLACE": [
                    "  this.executed([ 'shape.toggleCollapse' ], LOW_PRIORITY, function(e) {",
                    "",
                    "    var context = e.context,",
                    "        shape = context.shape;",
                    "",
                    "    if (!is(shape, 'bpmn:SubProcess')) {",
                    "      return;",
                    "    }",
                    "",
                    "    if (!shape.collapsed) {",
                    "",
                    "      // all children got made visible through djs, hide empty labels",
                    "      hideEmptyLabels(shape.children);",
                    "",
                    "      // show all labels when expanding",
                    "      showAllLabels(shape.children);",
                    "",
                    "      // remove collapsed marker",
                    "      getDi(shape).isExpanded = true;",
                    "    } else {",
                    "",
                    "      // hide all labels when collapsing",
                    "      hideAllLabels(shape.children);",
                    "",
                    "      // place collapsed marker",
                    "      getDi(shape).isExpanded = false;",
                    "    }",
                    "  });"
                ]
            }
        ]
