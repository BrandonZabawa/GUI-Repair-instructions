                "REPLACE": [
                    "AppendContextPadProvider.prototype.getContextPadEntries = function(element) {",
                    "  const popupMenu = this._popupMenu;",
                    "  const translate = this._translate;",
                    "  const getAppendMenuPosition = this._getAppendMenuPosition.bind(this);",
                    "",
                    "  // Always provide an append entry, fallback to create if popupMenu is empty",
                    "  if (!popupMenu.isEmpty(element, 'bpmn-append')) {",
                    "",
                    "    // append menu entry",
                    "    return {",
                    "      'append': {",
                    "        group: 'model',",
                    "        imageUrl: appendIcon,",
                    "        title: translate('Append element'),",
                    "        action: {",
                    "          click: function(event, element) {",
                    "",
                    "            var position = assign(getAppendMenuPosition(element), {",
                    "              cursor: { x: event.x, y: event.y }",
                    "            });",
                    "",
                    "            popupMenu.open(element, 'bpmn-append', position, {",
                    "              title: translate('Append element'),",
                    "              width: 300,",
                    "              search: true",
                    "            });",
                    "          }",
                    "        }",
                    "      }",
                    "    };",
                    "  } else {",
                    "    // fallback: trigger create action if append is not available",
                    "    return {",
                    "      'append': {",
                    "        group: 'model',",
                    "        imageUrl: appendIcon,",
                    "        title: translate('Create element'),",
                    "        action: {",
                    "          click: function(event, element) {",
                    "            // fallback to createElement editor action",
                    "            const editorActions = this._contextPad._eventBus._injector.get('editorActions', false);",
                    "            if (editorActions) {",
                    "              editorActions.trigger('createElement', event);",
                    "            }",
                    "          }.bind(this)",
                    "        }",
                    "      }",
                    "    };",
                    "  }",
                    "};"
                ]
            }
        ]
    }
}