        "lib/features/modeling/BpmnUpdater.js": [
            {
                "SEARCH": [
                    "BpmnUpdater.prototype.updateDiParent = function(di, parentDi) {",
                    "",
                    "if (parentDi && !is(parentDi, 'bpmndi:BPMNPlane')) {",
                    "parentDi = parentDi.$parent;",
                    "}",
                    "",
                    "if (di.$parent === parentDi) {",
                    "return;",
                    "}",
                    "",
                    "var planeElements = (parentDi || di.$parent).get('planeElement');",
                    "",
                    "if (parentDi) {",
                    "planeElements.push(di);",
                    "di.$parent = parentDi;",
                    "} else {",
                    "collectionRemove(planeElements, di);",
                    "di.$parent = null;",
                    "}",
                    "};"
                ],
                "REPLACE": [
                    "BpmnUpdater.prototype.updateDiParent = function(di, parentDi) {",
                    "",
                    "  if (parentDi && !is(parentDi, 'bpmndi:BPMNPlane')) {",
                    "    parentDi = parentDi.$parent;",
                    "  }",
                    "",
                    "  if (di.$parent === parentDi) {",
                    "    return;",
                    "  }",
                    "",
                    "  // Defensive: if neither parentDi nor di.$parent is available, skip",
                    "  var planeContainer = parentDi || di.$parent;",
                    "  if (!planeContainer || typeof planeContainer.get !== 'function') {",
                    "    // No valid DI parent to update, skip",
                    "    return;",
                    "  }",
                    "",
                    "  var planeElements = planeContainer.get('planeElement');",
