{
    "1/1": {
        "lib/features/replace/BpmnReplace.js": [
            {
                "SEARCH": [
                    "newBusinessObject = moddleCopy.copyElement(",
                    "oldBusinessObject,",
                    "newBusinessObject,",
                    "properties",
                    ");"
                ],
                "REPLACE": [
                    "    newBusinessObject = moddleCopy.copyElement(",
                    "      oldBusinessObject,",
                    "      newBusinessObject,",
                    "      properties",
                    "    );",
                    "",
                    "    // Special handling for loopCharacteristics: copy properties if type changes (parallel <-> sequential)",
                    "    if (",
                    "      has(oldBusinessObject, 'loopCharacteristics') &&",
                    "      has(newBusinessObject, 'loopCharacteristics') &&",
                    "      oldBusinessObject.loopCharacteristics &&",
                    "      newBusinessObject.loopCharacteristics &&",
                    "      oldBusinessObject.loopCharacteristics.$type !== newBusinessObject.loopCharacteristics.$type",
                    "    ) {",
                    "      // Copy relevant properties from old to new loopCharacteristics",
                    "      var oldLoop = oldBusinessObject.loopCharacteristics;",
                    "      var newLoop = newBusinessObject.loopCharacteristics;",
                    "      var loopProps = [",
                    "        'loopCardinality',",
                    "        'loopDataInputRef',",
                    "        'loopDataOutputRef',",
                    "        'inputDataItem',",
                    "        'outputDataItem',",
                    "        'completionCondition',",
                    "        'elementVariable'",
                    "      ];",
                    "      loopProps.forEach(function(prop) {",
                    "        if (oldLoop[prop] !== undefined) {",
                    "          newLoop[prop] = oldLoop[prop];",
                    "        }",
                    "      });",
                    "    }"
                ]
            }
        ]
    }
}