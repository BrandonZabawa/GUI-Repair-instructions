        "lib/features/copy-paste/BpmnCopyPaste.js": [
            {
                "SEARCH": [
                    "if (isLabel(descriptor)) {",
                    "return descriptor;",
                    "}"
                ],
                "REPLACE": [
                    "    if (isLabel(descriptor)) {",
                    "      // Copy label text (e.g., name or text) for label elements",
                    "      var labelTarget = getBusinessObject(element.labelTarget);",
                    "      if (labelTarget && (labelTarget.name !== undefined)) {",
                    "        descriptor.labelText = labelTarget.name;",
                    "      } else if (labelTarget && (labelTarget.text !== undefined)) {",
                    "        descriptor.labelText = labelTarget.text;",
                    "      }",
                    "      return descriptor;",
                    "    }"
                ]
            },
            {
                "SEARCH": [
                    "// do NOT copy business object if external label",
                    "if (isLabel(descriptor)) {",
                    "descriptor.businessObject = getBusinessObject(cache[ descriptor.labelTarget ]);",
                    "",
                    "return;",
                    "}"
                ],
                "REPLACE": [
                    "    // do NOT copy business object if external label",
                    "    if (isLabel(descriptor)) {",
                    "      var labelTargetBO = getBusinessObject(cache[ descriptor.labelTarget ]);",
                    "      descriptor.businessObject = labelTargetBO;",
                    "",
                    "      // Restore label text if it was copied",
                    "      if (descriptor.labelText !== undefined) {",
                    "        if (labelTargetBO && (labelTargetBO.name !== undefined)) {",
                    "          labelTargetBO.name = descriptor.labelText;",
                    "        } else if (labelTargetBO && (labelTargetBO.text !== undefined)) {",
                    "          labelTargetBO.text = descriptor.labelText;",
                    "        }",
                    "      }",
                    "",
                    "      return;",
                    "    }"
                ]
            }
        ]
