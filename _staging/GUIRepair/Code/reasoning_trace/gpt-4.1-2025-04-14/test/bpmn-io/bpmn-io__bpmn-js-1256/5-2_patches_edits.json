                "REPLACE": [
                    "  function compensateLaneDelete(shape, oldParent) {",
                    "",
                    "    var siblings = getChildLanes(oldParent);",
                    "",
                    "    if (!siblings.length) {",
                    "      return;",
                    "    }",
                    "",
                    "    // Find the lane directly above or below the deleted lane",
                    "    var adjacentLane = null;",
                    "    var minDelta = Infinity;",
                    "",
                    "    siblings.forEach(function(sibling) {",
                    "      if (sibling === shape) return;",
                    "      var delta = Math.abs(sibling.y - shape.y);",
                    "      if (delta < minDelta) {",
                    "        minDelta = delta;",
                    "        adjacentLane = sibling;",
                    "      }",
                    "    });",
                    "",
                    "    if (adjacentLane) {",
                    "      // Resize the adjacent lane to fill the space of the deleted lane",
                    "      var newY = Math.min(adjacentLane.y, shape.y);",
                    "      var newHeight = adjacentLane.height + shape.height;",
                    "      modeling.resizeShape(adjacentLane, { x: adjacentLane.x, y: newY, width: adjacentLane.width, height: newHeight });",
                    "    }",
                    "  }"
                ]
            }
        ]
