{
    "1/1": {
        "lighthouse-core/audits/byte-efficiency/byte-efficiency-audit.js": [
            {
                "SEARCH": [
                    "static bytesToKbString(bytes) {",
                    "return Math.round(bytes / KB_IN_BYTES).toLocaleString() + ' KB';",
                    "}",
                    "",
                    "/**",
                    "* @param {number} bytes",
                    "* @param {number} percent",
                    "* @return {string}",
                    "*/",
                    "static toSavingsString(bytes = 0, percent = 0) {",
                    "const kbDisplay = this.bytesToKbString(bytes);",
                    "const percentDisplay = Math.round(percent).toLocaleString() + '%';",
                    "return `${kbDisplay} (${percentDisplay})`;",
                    "}",
                    "",
                    "/**",
                    "* @param {number} bytes",
                    "* @param {number} networkThroughput measured in bytes/second",
                    "* @return {string}",
                    "*/",
                    "static bytesToMsString(bytes, networkThroughput) {",
                    "return (Math.round(bytes / networkThroughput * 100) * 10).toLocaleString() + 'ms';",
                    "}"
                ],
                "REPLACE": [
                    "  static bytesToKbString(bytes) {",
                    "    // Show 1 decimal place for KB, e.g., \"1,234.5 KB\"",
                    "    return (bytes / KB_IN_BYTES).toLocaleString(undefined, {maximumFractionDigits: 1}) + ' KB';",
                    "  }",
                    "",
                    "  /**",
                    "   * @param {number} bytes",
                    "   * @param {number} percent",
                    "   * @return {string}",
                    "   */",
                    "  static toSavingsString(bytes = 0, percent = 0) {",
                    "    const kbDisplay = this.bytesToKbString(bytes);",
                    "    // Show 1 decimal place for percent, e.g., \"12.3%\"",
                    "    const percentDisplay = percent.toLocaleString(undefined, {maximumFractionDigits: 1}) + '%';",
                    "    return `${kbDisplay} (${percentDisplay})`;",
                    "  }",
                    "",
                    "  /**",
                    "   * @param {number} bytes",
                    "   * @param {number} networkThroughput measured in bytes/second",
                    "   * @return {string}",
                    "   */",
                    "  static bytesToMsString(bytes, networkThroughput) {",
                    "    // Show 0 decimal places for ms, but use toLocaleString for thousands separator",
                    "    const ms = Math.round(bytes / networkThroughput * 1000);",
                    "    return ms.toLocaleString(undefined, {maximumFractionDigits: 0}) + ' ms';",
                    "  }"
                ]
            }
        ]
    }
}