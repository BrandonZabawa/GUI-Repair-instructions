                ],
                "REPLACE": [
                    "function prepareAssets(artifacts, results) {",
                    "  const passNames = Object.keys(artifacts.traces);",
                    "  const assets = [];",
                    "",
                    "  // Helper to inject synthetic metric events into the trace",
                    "  function injectMetricEvents(traceData, results) {",
                    "    if (!traceData.traceEvents) return;",
                    "",
                    "    // Helper to add a synthetic event",
                    "    function addEvent(name, ts, args) {",
                    "      traceData.traceEvents.push({",
                    "        cat: 'blink.user_timing',",
                    "        name: name,",
                    "        ph: 'R',",
                    "        ts: ts,",
                    "        pid: 1,",
                    "        tid: 1,",
                    "        args: args || {}",
                    "      });",
                    "    }",
                    "",
                    "    // Add FMP",
                    "    if (results['first-meaningful-paint'] && results['first-meaningful-paint'].extendedInfo &&",
                    "        results['first-meaningful-paint'].extendedInfo.value &&",
                    "        results['first-meaningful-paint'].extendedInfo.value.timestamps &&",
                    "        results['first-meaningful-paint'].extendedInfo.value.timestamps.fMP) {",
                    "      addEvent('firstMeaningfulPaint', results['first-meaningful-paint'].extendedInfo.value.timestamps.fMP);",
                    "    }",
                    "",
                    "    // Add Speed Index (Perceptual)",
                    "    if (results['speed-index-metric'] && results['speed-index-metric'].extendedInfo &&",
                    "        results['speed-index-metric'].extendedInfo.value &&",
                    "        results['speed-index-metric'].extendedInfo.value.timestamps &&",
                    "        results['speed-index-metric'].extendedInfo.value.timestamps.perceptualSpeedIndex) {",
                    "      addEvent('perceptualSpeedIndex', results['speed-index-metric'].extendedInfo.value.timestamps.perceptualSpeedIndex);",
                    "    }",
                    "",
                    "    // Add Time to Interactive",
                    "    if (results['time-to-interactive'] && results['time-to-interactive'].extendedInfo &&",
                    "        results['time-to-interactive'].extendedInfo.value &&",
                    "        results['time-to-interactive'].extendedInfo.value.timestamps &&",
                    "        results['time-to-interactive'].extendedInfo.value.timestamps.timeToInteractive) {",
                    "      addEvent('timeToInteractive', results['time-to-interactive'].extendedInfo.value.timestamps.timeToInteractive);",
                    "    }",
                    "",
                    "    // Add First Contentful Paint",
                    "    if (results['first-meaningful-paint'] && results['first-meaningful-paint'].extendedInfo &&",
                    "        results['first-meaningful-paint'].extendedInfo.value &&",
                    "        results['first-meaningful-paint'].extendedInfo.value.timestamps &&",
                    "        results['first-meaningful-paint'].extendedInfo.value.timestamps.fCP) {",
                    "      addEvent('firstContentfulPaint', results['first-meaningful-paint'].extendedInfo.value.timestamps.fCP);",
                    "    }",
                    "",
                    "    // Add First Visual Change",
                    "    if (results['speed-index-metric'] && results['speed-index-metric'].extendedInfo &&",
                    "        results['speed-index-metric'].extendedInfo.value &&",
                    "        results['speed-index-metric'].extendedInfo.value.timestamps &&",
                    "        results['speed-index-metric'].extendedInfo.value.timestamps.firstVisualChange) {",
                    "      addEvent('firstVisualChange', results['speed-index-metric'].extendedInfo.value.timestamps.firstVisualChange);",
                    "    }",
                    "",
                    "    // Add Visually Complete",
                    "    if (results['speed-index-metric'] && results['speed-index-metric'].extendedInfo &&",
                    "        results['speed-index-metric'].extendedInfo.value &&",
                    "        results['speed-index-metric'].extendedInfo.value.timestamps &&",
                    "        results['speed-index-metric'].extendedInfo.value.timestamps.visuallyComplete) {",
                    "      addEvent('visuallyComplete', results['speed-index-metric'].extendedInfo.value.timestamps.visuallyComplete);",
                    "    }",
                    "  }",
                    "",
                    "  return passNames.reduce((chain, passName) => {",
                    "    const trace = artifacts.traces[passName];",
                    "",
                    "    return chain.then(_ => artifacts.requestScreenshots(trace))",
                    "      .then(screenshots => {",
                    "        // Deep copy trace to avoid mutating original",
                    "        const traceData = JSON.parse(JSON.stringify(trace));",
                    "        // Inject synthetic metric events",
                    "        injectMetricEvents(traceData, results);",
                    "        const html = screenshotDump(screenshots, results);",
                    "",
                    "        assets.push({",
                    "          traceData,",
                    "          html",
                    "        });",
                    "      });",
                    "  }, Promise.resolve())",
                    "    .then(_ => assets);",
                    "}"
                ]
            }
        ]
    }
}