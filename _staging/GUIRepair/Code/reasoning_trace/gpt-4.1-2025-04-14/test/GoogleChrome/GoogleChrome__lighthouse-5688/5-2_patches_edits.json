{
    "1/1": {
        "lighthouse-core/audits/byte-efficiency/uses-webp-images.js": [
            {
                "SEARCH": [
                    "for (const image of images) {",
                    "if (image.failed) {",
                    "warnings.push(`Unable to decode ${URL.getURLDisplayName(image.url)}`);",
                    "continue;",
                    "} else if (image.originalSize < image.webpSize + IGNORE_THRESHOLD_IN_BYTES) {",
                    "continue;",
                    "}"
                ],
                "REPLACE": [
                    "    for (const image of images) {",
                    "      if (image.failed) {",
                    "        warnings.push(`Unable to decode ${URL.getURLDisplayName(image.url)}`);",
                    "        continue;",
                    "      }",
                    "",
                    "      // Include BMP images (including x-ms-bmp) for next-gen format recommendation",
                    "      const legacyFormats = [",
                    "        'image/jpeg',",
                    "        'image/png',",
                    "        'image/bmp',",
                    "        'image/x-ms-bmp',",
                    "      ];",
                    "      if (!legacyFormats.includes(image.mimeType)) {",
                    "        // Only process legacy formats for next-gen recommendation",
                    "        continue;",
                    "      }",
                    "",
                    "      if (image.originalSize < image.webpSize + IGNORE_THRESHOLD_IN_BYTES) {",
                    "        continue;",
                    "      }"
                ]
            }
        ]
    }
}