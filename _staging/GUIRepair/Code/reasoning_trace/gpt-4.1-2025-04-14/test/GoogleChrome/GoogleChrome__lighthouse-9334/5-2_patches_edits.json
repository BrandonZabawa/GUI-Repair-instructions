{
    "1/1": {
        "lighthouse-cli/run.js": [
            {
                "SEARCH": [
                    "if (runnerResult && runnerResult.lhr.runtimeError) {",
                    "const {runtimeError} = runnerResult.lhr;",
                    "return printErrorAndExit({",
                    "name: 'LHError',",
                    "friendlyMessage: runtimeError.message,",
                    "lhrRuntimeError: true,",
                    "code: runtimeError.code,",
                    "message: runtimeError.message,",
                    "});",
                    "}"
                ],
                "REPLACE": [
                    "    if (runnerResult && runnerResult.lhr.runtimeError) {",
                    "      const {runtimeError} = runnerResult.lhr;",
                    "      // Use LighthouseError class to get translated message",
                    "      const LighthouseError = require('../lighthouse-core/lib/lh-error.js');",
                    "      const errorDef = LighthouseError.errors[runtimeError.code] || {",
                    "        code: runtimeError.code,",
                    "        message: runtimeError.message,",
                    "      };",
                    "      const err = new LighthouseError(errorDef);",
                    "      return printErrorAndExit(err);",
                    "    }"
                ]
            }
        ]
    }
}