                    "artifacts,",
                    "warnings: [...warnings, pageLoadError.friendlyMessage],",
                    "};",
                    "} else {",
                    "await collectPhaseArtifacts({phase: 'getArtifact', ...phaseState});",
                    "",
                    "const artifacts = await awaitArtifacts(phaseState.artifactState);",
                    "return {",
                    "artifacts,",
                    "warnings,",
                    "pageLoadError: undefined,",
                    "};",
