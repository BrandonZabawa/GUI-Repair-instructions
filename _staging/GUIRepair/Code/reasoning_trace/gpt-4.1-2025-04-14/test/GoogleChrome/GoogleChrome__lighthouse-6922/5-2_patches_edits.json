                "REPLACE": [
                    "    connection.on('protocolevent', event => {",
                    "      this._devtoolsLog.record(event);",
                    "      if (this._networkStatusMonitor) {",
                    "        this._networkStatusMonitor.dispatch(event);",
                    "      }",
                    "",
                    "      // Handle network events from OOPIFs (child targets)",
                    "      if (event.method === 'Target.receivedMessageFromTarget') {",
                    "        try {",
                    "          const message = JSON.parse(event.params.message);",
                    "          // Forward network events from OOPIFs to the main event emitter",
                    "          if (message.method && message.method.startsWith('Network.')) {",
                    "            this._devtoolsLog.record({",
                    "              ...message,",
                    "              sessionId: event.params.sessionId,",
                    "            });",
                    "            if (this._networkStatusMonitor) {",
                    "              this._networkStatusMonitor.dispatch({",
                    "                ...message,",
                    "                sessionId: event.params.sessionId,",
                    "              });",
                    "            }",
                    "            this._eventEmitter.emit(message.method, message.params);",
                    "          }",
                    "        } catch (e) {",
                    "          // Ignore parse errors",
                    "        }",
                    "      } else {",
                    "        // @ts-ignore TODO(bckenny): tsc can't type event.params correctly yet,",
                    "        // typing as property of union instead of narrowing from union of",
                    "        // properties. See https://github.com/Microsoft/TypeScript/pull/22348.",
                    "        this._eventEmitter.emit(event.method, event.params);",
                    "      }",
                    "    });"
                ]
            },
            {
