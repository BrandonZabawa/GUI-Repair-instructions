                "REPLACE": [
                    "function printRuntimeErrorAndExit(err) {",
                    "  // Ensure we always print a user-friendly, translated message.",
                    "  let message = err.friendlyMessage;",
                    "  if (!message || typeof message !== 'string') {",
                    "    // Fallback to err.message, but avoid printing internal file paths or codes.",
                    "    message = err.message && typeof err.message === 'string'",
                    "      ? err.message",
                    "      : 'A runtime error occurred. Please check your input and try again.';",
                    "  }",
                    "  console.error('Runtime error encountered:', message);",
                    "  if (err.stack) {",
                    "    console.error(err.stack);",
                    "  }",
                    "  return process.exit(_RUNTIME_ERROR_CODE);",
                    "}"
                ]
            }
        ]
    }
