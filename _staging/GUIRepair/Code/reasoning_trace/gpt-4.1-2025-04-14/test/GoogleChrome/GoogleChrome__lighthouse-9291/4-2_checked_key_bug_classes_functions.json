            "function_code": [
                "function printErrorAndExit(err) {",
                "  if (err.code === 'ECONNREFUSED') {",
                "    return printConnectionErrorAndExit();",
                "  } else if (err.code === 'CRI_TIMEOUT') {",
                "    return printProtocolTimeoutErrorAndExit();",
                "  } else {",
                "    return printRuntimeErrorAndExit(err);",
                "  }",
                "}"
            ]
        }
