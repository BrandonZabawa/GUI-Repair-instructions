            "function_code": [
                "function printRuntimeErrorAndExit(err) {",
                "  console.error('Runtime error encountered:', err.friendlyMessage || err.message);",
                "  if (err.stack) {",
                "    console.error(err.stack);",
                "  }",
                "  return process.exit(_RUNTIME_ERROR_CODE);",
                "}"
            ]
        },
