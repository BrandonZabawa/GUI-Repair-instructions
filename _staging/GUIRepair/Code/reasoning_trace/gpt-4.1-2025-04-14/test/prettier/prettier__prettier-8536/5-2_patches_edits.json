{
    "1/1": {
        "src/language-js/printer-estree.js": [
            {
                "SEARCH": [
                    "// Only force a trailing newline if there were any contents.",
                    "if (",
                    "!n.body.every(({ type }) => type === \"EmptyStatement\") ||",
                    "n.comments",
                    ") {",
                    "parts.push(hardline);",
                    "}"
                ],
                "REPLACE": [
                    "      // Only force a trailing newline if there were any contents.",
                    "      if (",
                    "        !n.body.every(({ type }) => type === \"EmptyStatement\") ||",
                    "        n.comments",
                    "      ) {",
                    "        // Avoid double hardline at the end",
                    "        if (parts.length === 0 || parts[parts.length - 1] !== hardline) {",
                    "          parts.push(hardline);",
                    "        }",
                    "      }"
                ]
            }
        ]
    }
}