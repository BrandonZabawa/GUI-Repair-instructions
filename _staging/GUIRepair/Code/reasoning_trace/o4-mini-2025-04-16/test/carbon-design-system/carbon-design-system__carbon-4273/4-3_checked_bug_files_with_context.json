        "            <SkeletonText width=\"95%\" />",
        "          </div>",
        "        </li>",
        "      )}",
        "      {Array.from({ length: numSkeletonItems }).map((_, i) => (",
        "        <AccordionSkeletonItem key={i} />",
        "      ))}",
        "    </ul>",
        "  );",
        "}",
