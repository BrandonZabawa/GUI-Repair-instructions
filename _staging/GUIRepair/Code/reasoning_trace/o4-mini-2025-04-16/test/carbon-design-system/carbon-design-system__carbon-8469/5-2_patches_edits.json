{
    "1/1": {
        "packages/react/src/components/Toggle/Toggle.js": [
            {
                "SEARCH": [
                    "<input",
                    "{...other}",
                    "{...checkedProps}",
                    "aria-label={null}",
                    "type=\"checkbox\"",
                    "id={id}",
                    "className={toggleClasses}",
                    "onChange={(evt) => {",
                    "onChange && onChange(evt);",
                    "onToggle(input.checked, id, evt);",
                    "}}",
                    "ref={(el) => {",
                    "input = el;",
                    "}}",
                    "onKeyUp={(evt) => {",
                    "if (match(evt, keys.Enter)) {",
                    "input.checked = !input.checked;",
                    "onChange && onChange(evt);",
                    "onToggle(input.checked, id, evt);",
                    "}",
                    "}}",
                    "/>"
                ],
                "REPLACE": [
                    "        <input",
                    "          {...other}",
                    "          {...checkedProps}",
                    "          type=\"checkbox\"",
                    "          aria-label={other['aria-label']}",
                    "          id={id}",
                    "          className={toggleClasses}",
                    "          onChange={(evt) => {",
                    "            onChange && onChange(evt);",
                    "            onToggle(input.checked, id, evt);",
                    "          }}",
                    "          ref={(el) => {",
                    "            input = el;",
                    "          }}",
                    "          onKeyUp={(evt) => {",
                    "            if (match(evt, keys.Enter)) {",
                    "              input.checked = !input.checked;",
                    "              onChange && onChange(evt);",
                    "              onToggle(input.checked, id, evt);",
                    "            }",
                    "          }}",
                    "        />"
                ]
            }
        ],
