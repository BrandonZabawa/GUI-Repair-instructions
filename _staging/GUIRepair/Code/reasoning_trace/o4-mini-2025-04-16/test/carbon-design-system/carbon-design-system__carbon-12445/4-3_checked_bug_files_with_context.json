        "  warnText: PropTypes.node,",
        "};",
        "",
        "ComboBox.defaultProps = {",
        "  disabled: false,",
        "  itemToString: defaultItemToString,",
        "  itemToElement: null,",
        "  shouldFilterItem: defaultShouldFilterItem,",
        "  type: 'default',",
        "  ariaLabel: 'Choose an item',",
        "  direction: 'bottom',",
        "};",
        "",
        "export default ComboBox;"
