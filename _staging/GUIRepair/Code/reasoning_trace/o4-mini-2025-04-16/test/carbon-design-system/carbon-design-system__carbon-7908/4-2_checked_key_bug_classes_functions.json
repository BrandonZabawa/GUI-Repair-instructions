                "      },",
                "      onStateChange,",
                "      selectedItem: controlledSelectedItems,",
                "      items,",
                "    })",
                "  );",
                "",
                "  /**",
                "   * wrapper function to forward changes to consumer",
                "   */",
                "  const setIsOpenWrapper = (open) => {",
                "    setIsOpen(open);",
                "    if (onMenuChange) {",
