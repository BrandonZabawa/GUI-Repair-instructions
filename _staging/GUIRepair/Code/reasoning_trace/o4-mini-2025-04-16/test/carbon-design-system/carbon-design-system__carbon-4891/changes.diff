   constructor(element, options) {
     super(element, options);
+
+    // Inject global CSS to neutralize Chrome autofill background
+    if (!document.querySelector('style[data-cds-search-autofill]')) {
+      const styleEl = document.createElement('style');
+      styleEl.setAttribute('data-cds-search-autofill', 'true');
+      styleEl.textContent = `
+        .${settings.prefix}--search-input:-webkit-autofill {
+          box-shadow: 0 0 0px 1000px #fff inset !important;
+          -webkit-text-fill-color: inherit !important;
+        }
+      `;
+      document.head.appendChild(styleEl);
+    }
+
     const closeIcon = this.element.querySelector(
       this.options.selectorClearIcon
     );
