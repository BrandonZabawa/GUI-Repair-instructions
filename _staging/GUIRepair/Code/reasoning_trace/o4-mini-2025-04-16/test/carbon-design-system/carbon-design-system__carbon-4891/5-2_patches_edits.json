                    "          style={{",
                    "            ...other.style,",
                    "            WebkitBoxShadow: '0 0 0px 1000px #fff inset',",
                    "            WebkitTextFillColor: 'inherit',",
                    "          }}",
                    "          id={id}",
                    "          placeholder={placeHolderText}",
