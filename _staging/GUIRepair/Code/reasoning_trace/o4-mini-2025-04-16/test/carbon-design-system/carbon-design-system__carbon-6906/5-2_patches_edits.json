                    "                  {isOpen && (",
                    "                    <ListBox.Menu",
                    "                      // must be a listbox to contain role=\"option\"",
                    "                      role=\"listbox\"",
                    "                      aria-label={ariaLabel}",
                    "                      id={`${id}-menu`}>",
                    "                      {sortItems(",
                    "                        \u2026",
