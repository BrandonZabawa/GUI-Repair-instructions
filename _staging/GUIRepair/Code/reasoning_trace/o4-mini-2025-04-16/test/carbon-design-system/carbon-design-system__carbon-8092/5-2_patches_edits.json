{
    "1/1": {
        "packages/react/src/components/Select/Select.js": [
            {
                "SEARCH": [
                    "hideLabel,",
                    "invalid,",
                    "invalidText,",
                    "helperText,",
                    "light,",
                    "size,"
                ],
                "REPLACE": [
                    "    hideLabel,",
                    "    invalid,",
                    "    invalidText,",
                    "    warn,",
                    "    warnText,",
                    "    helperText,",
                    "    light,",
                    "    size,"
                ]
            },
            {
                "SEARCH": [
                    "const selectClasses = classNames({",
                    "[`${prefix}--select`]: true,",
                    "[`${prefix}--select--inline`]: inline,",
                    "[`${prefix}--select--light`]: light,",
                    "[`${prefix}--select--invalid`]: invalid,",
                    "[`${prefix}--select--disabled`]: disabled,",
                    "[className]: className,",
                    "});"
                ],
                "REPLACE": [
                    "  const selectClasses = classNames({",
                    "    [`${prefix}--select`]: true,",
                    "    [`${prefix}--select--inline`]: inline,",
                    "    [`${prefix}--select--light`]: light,",
                    "    [`${prefix}--select--invalid`]: invalid,",
                    "    [`${prefix}--select--warning`]: warn,",
                    "    [`${prefix}--select--disabled`]: disabled,",
                    "    [className]: className,",
                    "  });"
                ]
            },
            {
                "SEARCH": [
                    "const errorId = `${id}-error-msg`;",
                    "const error = invalid ? (",
                    "<div className={`${prefix}--form-requirement`} id={errorId}>",
                    "{invalidText}",
                    "</div>",
                    ") : null;"
                ],
                "REPLACE": [
                    "  const errorId = `${id}-error-msg`;",
                    "  const error = invalid ? (",
                    "    <div className={`${prefix}--form-requirement`} id={errorId}>",
                    "      {invalidText}",
                    "    </div>",
                    "  ) : null;",
                    "  const warningId = `${id}-warning-msg`;",
                    "  const warning = warn ? (",
                    "    <div className={`${prefix}--form-requirement`} id={warningId}>",
                    "      {warnText}",
                    "    </div>",
                    "  ) : null;"
                ]
            },
            {
                "SEARCH": [
                    "const ariaProps = {};",
                    "if (invalid) {",
                    "ariaProps['aria-describedby'] = errorId;",
                    "}"
                ],
                "REPLACE": [
                    "  const ariaProps = {};",
                    "  if (invalid) {",
                    "    ariaProps['aria-describedby'] = errorId;",
                    "  } else if (warn) {",
                    "    ariaProps['aria-describedby'] = warningId;",
                    "  }"
                ]
            },
            {
                "SEARCH": [
                    "<ChevronDown16 className={`${prefix}--select__arrow`} />",
                    "{invalid && (",
                    "<WarningFilled16 className={`${prefix}--select__invalid-icon`} />",
                    ")}"
                ],
                "REPLACE": [
                    "        <ChevronDown16 className={`${prefix}--select__arrow`} />",
                    "        {invalid && (",
                    "          <WarningFilled16 className={`${prefix}--select__invalid-icon`} />",
                    "        )}",
                    "        {warn && (",
                    "          <WarningFilled16 className={`${prefix}--select__warning-icon`} />",
                    "        )}"
                ]
            },
            {
                "SEARCH": [
                    "</div>",
                    "{error}",
                    "</div>"
                ],
                "REPLACE": [
                    "          </div>",
                    "            {error || warning}",
                    "          </div>"
                ]
            },
            {
                "SEARCH": [
                    "{!inline && error ? error : helper}"
                ],
                "REPLACE": [
                    "        {!inline && (error || warning) ? (error || warning) : helper}"
                ]
            },
            {
                "SEARCH": [
                    "/**",
                    "* Message which is displayed if the value is invalid.",
                    "*/",
                    "invalidText: PropTypes.node,"
                ],
                "REPLACE": [
                    "  /**",
                    "   * Message which is displayed if the value is invalid.",
                    "   */",
                    "  invalidText: PropTypes.node,",
                    "  /**",
                    "   * Message which is displayed if the value is a warning.",
                    "   */",
                    "  warnText: PropTypes.node,",
                    "  /**",
                    "   * Specify if the current value is a warning state.",
                    "   */",
                    "  warn: PropTypes.bool,"
                ]
            },
            {
                "SEARCH": [
                    "invalidText: '',",
                    "helperText: '',"
                ],
                "REPLACE": [
                    "  invalidText: '',",
                    "  warn: false,",
                    "  warnText: '',",
                    "  helperText: '',"
                ]
            }
        ]
    }
}