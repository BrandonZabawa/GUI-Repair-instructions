                "",
                "        const {",
                "            prefix,",
                "            focusable,",
                "            inlineIndent,",
                "            itemClassName,",
                "            rtl,",
                "        } = root.props;",
                "        const focused = this.getFocused();",
                "",
                "        const newClassName = replaceClassName",
                "            ? className",
                "            : cx({",
                "                  [`${prefix}menu-item`]: true,",
                "                  [`${prefix}disabled`]: disabled,",
                "                  [`${prefix}focused`]: !focusable && focused,",
                "                  [itemClassName]: !!itemClassName,",
                "                  [className]: !!className,",
                "              });",
