                    "}"
                ],
                "REPLACE": [
                    "        if (!('value' in this.props)) {",
                    "            st.value = value;",
                    "        }",
                    "        // single-mode: still clear searchValue after selecting an item",
                    "        if (!multiple && searchValue) {",
                    "            st.searchValue = '';",
                    "        }",
                    "        // multiple-mode: if all of the filtered (search) items have been picked, clear the search",
                    "        if (multiple && searchValue) {",
                    "            const filteredPaths = this.filterItems();",
                    "            if (filteredPaths.length > 0 && value.length === filteredPaths.length) {",
                    "                st.searchValue = '';",
                    "            }",
                    "        }",
                    "        if (Object.keys(st).length) {",
                    "            this.setState(st);",
                    "        }",
                    "",
                    "        if (onChange) {",
                    "            onChange(value, data, extra);",
                    "        }",
                    "",
                    "        // whenever we actually cleared searchValue in state, clear the Select\u2019s search input",
                    "        if (st.hasOwnProperty('searchValue') && this.select) {",
                    "            this.select.handleSearchClear();",
                    "        }"
                ]
            }
        ]
    }
