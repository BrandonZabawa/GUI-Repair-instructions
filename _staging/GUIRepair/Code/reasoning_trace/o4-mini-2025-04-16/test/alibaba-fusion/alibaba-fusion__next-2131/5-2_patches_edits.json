                "REPLACE": [
                    "    const drill = (data = [], level = 1, prefix = '0', parent) =>",
                    "        data.map((item, index) => {",
                    "            // 为了兼容之前的实现 保留非法节点",
                    "            if (item.illegalFlag) {",
                    "                return item;",
                    "            }",
                    "",
                    "            const { children } = item;",
                    "            const pos = `${prefix}-${index}`;",
                    "            let { key } = item;",
                    "",
                    "            // 克隆一下，切勿修改原始 (可能是 frozen/immutable) 对象",
                    "            const newItem = { ...item };",
                    "            newItem.pos = pos;",
                    "            newItem.level = level;",
                    "",
                    "            // 判断是否叶子节点",
                    "            if (!('isLeaf' in newItem)) {",
                    "                newItem.isLeaf = !((children && children.length) || props.loadData);",
                    "            }",
                    "            newItem.isLastChild = parent ? [].concat(parent.isLastChild || [], index === data.length - 1) : [];",
                    "",
                    "            if (key === undefined || key === null) {",
                    "                newItem.key = key = pos;",
                    "            }",
                    "",
                    "            // 递归时使用 cloned children 并把结果重新挂到 newItem 上",
                    "            if (!newItem.isLeaf) {",
                    "                newItem.children = drill(children, level + 1, pos, newItem);",
                    "            }",
                    "",
                    "            // 直接存储 newItem，不再是展开原 item",
                    "            k2n[key] = p2n[pos] = newItem;",
                    "",
                    "            return newItem;",
                    "        });"
                ]
            }
        ]
    }
