            "function_code": [
                "function fmtValue(value, fmt) {",
                "    const formater = (v, idx) => {",
                "        if (Array.isArray(fmt)) {",
                "            fmt = fmt[idx];",
                "        }",
                "        return v ? (typeof fmt === 'function' ? fmt(v) : v.format(fmt)) : '';",
                "    };",
                "",
                "    return Array.isArray(value) ? value.map((v, idx) => formater(v, idx)) : formater(value);",
                "}"
            ]
        },
