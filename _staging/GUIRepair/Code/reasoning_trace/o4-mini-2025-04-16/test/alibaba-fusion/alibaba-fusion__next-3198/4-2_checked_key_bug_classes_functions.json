            "function_code": [
                "function checkDate(value) {",
                "    /**",
                "     * 因为 datejs(undefined) 表示当前时间",
                "     * 但是这里期望的是一个空值，即用户不输入值的时候显示为空",
                "     */",
                "    if (value === undefined) {",
                "        value = null;",
                "    }",
                "",
                "    value = datejs(value);",
                "    return value.isValid() ? value : null;",
                "}"
            ]
