            "function_code": [
                "export function setTime(targetVal, sourceVal) {",
                "    if (sourceVal && targetVal) {",
                "        return targetVal",
                "            .hour(sourceVal.hour())",
                "            .minute(sourceVal.minute())",
                "            .second(sourceVal.second())",
                "            .millisecond(sourceVal.millisecond());",
                "    }",
                "    return targetVal;",
                "}"
            ]
        },
