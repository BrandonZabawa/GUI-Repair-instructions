                    "* @private get element rect",
                    "* @param       {Element} elem",
                    "* @return      {Object}",
                    "*/",
                    "function _getElementRect(elem) {",
                    "let offsetTop = 0,",
                    "offsetLeft = 0,",
                    "scrollTop = 0,",
                    "scrollLeft = 0;",
                    "",
                    "const offsetHeight = elem.offsetHeight;",
                    "const offsetWidth = elem.offsetWidth;",
                    "",
                    "do {",
                    "if (!isNaN(elem.offsetTop)) {",
                    "offsetTop += elem.offsetTop;",
                    "}",
                    "if (!isNaN(elem.offsetLeft)) {",
                    "offsetLeft += elem.offsetLeft;",
                    "}",
                    "if (!isNaN(elem.scrollTop)) {",
                    "scrollTop += elem.scrollTop;",
                    "}",
                    "if (!isNaN(elem.scrollLeft)) {",
                    "scrollLeft += elem.scrollLeft;",
                    "}",
                    "} while ((elem = elem.offsetParent) !== null);",
                    "",
                    "return {",
                    "top:",
                    "offsetTop -",
                    "scrollTop -",
                    "(document.documentElement.scrollTop || document.body.scrollTop),",
                    "left:",
                    "offsetLeft -",
                    "scrollLeft -",
                    "(document.documentElement.scrollLeft || document.body.scrollLeft),",
                    "height: offsetHeight,",
                    "width: offsetWidth,",
                    "};",
                    "}"
                ],
                "REPLACE": [
                    "/**",
                    " * @private get element rect",
                    " * @param       {Element} elem",
                    " * @return      {Object}",
                    " */",
                    "function _getElementRect(elem) {",
                    "    // Use boundingClientRect so nested/container scrolling is accounted for correctly",
                    "    const rect = elem.getBoundingClientRect();",
                    "    return {",
                    "        top: rect.top,",
                    "        left: rect.left,",
                    "        width: rect.width || elem.offsetWidth,",
                    "        height: rect.height || elem.offsetHeight,",
                    "    };",
                    "}"
                ]
            }
