                "REPLACE": [
                    "    onWindowResized = () => {",
                    "        if (this.updateTimer) {",
                    "            clearTimeout(this.updateTimer);",
                    "        }",
                    "",
                    "        this.updateTimer = setTimeout(() => {",
                    "            this.setSlideBtn();",
                    "            this.getDropdownItems(this.props);",
                    "        }, 100);",
                    "    };",
                    "",
                    "    // ------------------------------------------------------------------------",
                    "    // Add wheel support so users can scroll the tabs with the mouse wheel",
                    "    onWheel = (e) => {",
                    "        e.preventDefault();",
                    "        const { tabPosition } = this.props;",
                    "        // horizontal tabs = deltaX, vertical tabs = deltaY",
                    "        const delta = (tabPosition === 'top' || tabPosition === 'bottom') ? e.deltaX : e.deltaY;",
                    "        // invert wheel direction so it feels natural",
                    "        this.setOffset(this.offset - delta, true, false);",
                    "    };",
                    "",
                    "    // Add arrow key support so users can navigate with left/right (or up/down)",
                    "    onContainerKeyDown = (e) => {",
                    "        // 37 = left, 38 = up, 39 = right, 40 = down",
                    "        if (e.keyCode === KEYCODE.LEFT || e.keyCode === KEYCODE.UP) {",
                    "            e.preventDefault();",
                    "            this.onPrevClick();",
                    "        } else if (e.keyCode === KEYCODE.RIGHT || e.keyCode === KEYCODE.DOWN) {",
                    "            e.preventDefault();",
                    "            this.onNextClick();",
                    "        }",
                    "        // still invoke any consumer-provided handler",
                    "        if (this.props.onKeyDown) {",
                    "            this.props.onKeyDown(e);",
                    "        }",
                    "    };"
                ]
            },
            {
                "SEARCH": [
                    "const container = (",
                    "<div className={containerCls} onKeyDown={onKeyDown} key=\"nav-container\">",
                    "<div className={`${prefix}tabs-nav-wrap`} ref={this.wrapperRefHandler}>",
                    "<div className={`${prefix}tabs-nav-scroll`}>"
                ],
                "REPLACE": [
                    "        const container = (",
                    "            <div",
                    "                className={containerCls}",
                    "                // bind our new wheel + keyboard handlers",
                    "                onWheel={this.onWheel}",
                    "                onKeyDown={this.onContainerKeyDown}",
                    "                key=\"nav-container\"",
                    "            >",
                    "                <div className={`${prefix}tabs-nav-wrap`} ref={this.wrapperRefHandler}>",
                    "                    <div className={`${prefix}tabs-nav-scroll`}>"
                ]
            }
        ]
    }
