                    "            if (hasArrow) {",
                    "                iconEl = (",
                    "                    <Icon",
                    "                        className={`${prefix}nav-icon-only-arrow`}",
                    "                        type={mode === 'popup' ? 'arrow-right' : 'arrow-down'}",
                    "                    />",
                    "                );",
                    "            }",
                    "        }"
                ]
            }
        ]
    }
}