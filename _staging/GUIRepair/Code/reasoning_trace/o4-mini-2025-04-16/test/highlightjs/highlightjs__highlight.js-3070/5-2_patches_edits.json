{
    "1/1": {
        "src/lib/html_renderer.js": [
            {
                "SEARCH": [
                    "/**",
                    "* Adds a node open to the output stream (if needed)",
                    "*",
                    "* @param {Node} node */",
                    "openNode(node) {",
                    "if (!emitsWrappingTags(node)) return;",
                    "",
                    "let className = node.kind;",
                    "if (!node.sublanguage) {",
                    "className = expandClassName(className, { prefix: this.classPrefix });",
                    "}",
                    "this.span(className);",
                    "}"
                ],
                "REPLACE": [
                    "/**",
                    "* Adds a node open to the output stream (if needed)",
                    "*",
                    "* @param {Node} node */",
                    "openNode(node) {",
                    "if (!emitsWrappingTags(node)) return;",
                    "",
                    "// Always apply the configured prefix (e.g. \"hljs-\") to every kind,",
                    "// even when this is a sublanguage block.",
                    "const className = expandClassName(node.kind, { prefix: this.classPrefix });",
                    "this.span(className);",
                    "}"
                ]
            }
        ]
    },
