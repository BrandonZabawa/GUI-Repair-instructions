{
    "1/1": {
        "src/languages/latex.js": [
            {
                "SEARCH": [
                    "{",
                    "className: 'string', // because it looks like attributes in HTML tags",
                    "variants: [",
                    "{begin: /\\[/, end: /\\]/},",
                    "{begin: /\\{/, end: /\\}/}",
                    "]",
                    "},"
                ],
                "REPLACE": [
                    "{",
                    "className: 'string', // options in [ \u2026 ]",
                    "begin: /\\[/, end: /\\]/,",
                    "},",
                    "{",
                    "className: 'subst',    // recurse into { \u2026 }",
                    "begin: /\\{/, end: /\\}/,",
                    "contains: [ COMMAND ]",
                    "},"
                ]
            }
        ]
    },
