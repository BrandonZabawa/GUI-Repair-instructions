            {
                "SEARCH": [
                    "SUBST.contains.push(QUOTE_STRING);"
                ],
                "REPLACE": [
                    "SUBST.contains.push(QUOTE_STRING);",
                    "// new operators/redirections/continuation markers",
                    "const REDIRECTION = {",
                    "className: 'operator',",
                    "begin: /<<<?|>>?|<|>/",
                    "};",
                    "const OPERATOR = {",
                    "className: 'operator',",
                    "begin: /\\|\\||&&|\\||;|>>|>|<<|<|<<</",
                    "};",
                    "const CONTINUATION = {",
                    "className: 'punctuation',",
                    "begin: /\\\\$/",
                    "};"
                ]
            },
            {
                "SEARCH": [
                    "contains: [",
                    "KNOWN_SHEBANG, // to catch known shells and boost relevancy",
                    "hljs.SHEBANG(), // to catch unknown shells but still highlight the shebang",
                    "FUNCTION,",
                    "ARITHMETIC,",
                    "hljs.HASH_COMMENT_MODE,",
                    "QUOTE_STRING,",
                    "ESCAPED_QUOTE,",
                    "APOS_STRING,",
                    "VAR",
                    "]"
                ],
                "REPLACE": [
                    "contains: [",
                    "KNOWN_SHEBANG,        // to catch known shells and boost relevancy",
                    "hljs.SHEBANG(),       // to catch unknown shells but still highlight the shebang",
                    "FUNCTION,",
                    "ARITHMETIC,",
                    "hljs.HASH_COMMENT_MODE,",
                    "QUOTE_STRING,",
                    "ESCAPED_QUOTE,",
                    "APOS_STRING,",
                    "SUBST,                // highlight $(\u2026)",
                    "CONTINUATION,         // highlight trailing backslash",
                    "OPERATOR,             // highlight |, &&, ||, ;",
                    "REDIRECTION,          // highlight <, >, <<, >>, <<<",
                    "VAR",
                    "]"
                ]
            }
        ]
