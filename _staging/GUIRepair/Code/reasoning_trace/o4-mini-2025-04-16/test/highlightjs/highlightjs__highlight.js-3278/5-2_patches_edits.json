{
    "1/1": {
        "src/languages/typescript.js": [
            {
                "SEARCH": [
                    "tsLanguage.contains = tsLanguage.contains.concat([",
                    "DECORATOR,",
                    "NAMESPACE,",
                    "INTERFACE,",
                    "]);"
                ],
                "REPLACE": [
                    "// Add support for TS generic parameters (<T, U extends V>) so",
                    "// they don\u2019t get mis-parsed as HTML/JSX tags.",
                    "tsLanguage.contains = tsLanguage.contains.concat([",
                    "{",
                    "// highlight <T, U extends V>",
                    "className: 'typeparams',",
                    "begin: /</, end: />/,",
                    "contains: [",
                    "{ begin: IDENT_RE,        className: 'type'    },",
                    "{ beginKeywords: 'extends', className: 'keyword' },",
                    "{ begin: /,/,              relevance: 0       }",
                    "],",
                    "// disallow pipes (so we don\u2019t accidentally eat",
                    "// e.g. union types || later on)",
                    "illegal: /\\|/",
                    "},",
                    "DECORATOR,",
                    "NAMESPACE,",
                    "INTERFACE,",
                    "]);"
                ]
            }
        ]
    },
