{
    "1/1": {
        "src/languages/python.js": [
            {
                "SEARCH": [
                    "{",
                    "begin: '\\\\b([1-9](_?[0-9])*|0+(_?0)*)[lLjJ]?\\\\b'",
                    "},"
                ],
                "REPLACE": [
                    "{",
                    "// decinteger: allow number to end before a letter,",
                    "// so that \"1if\" becomes \"1\" (number) + \"if\" (keyword)",
                    "begin: '\\\\b([1-9](_?[0-9])*|0+(_?0)*)(?:[lLjJ])?(?![0-9_])'",
                    "},"
                ]
            }
        ]
    },
