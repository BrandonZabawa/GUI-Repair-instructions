{
    "1/1": {
        "src/languages/css.js": [
            {
                "SEARCH": [
                    "{",
                    "begin: ':',",
                    "end: '[;}]',",
                    "contains: [",
                    "modes.HEXCOLOR,",
                    "modes.IMPORTANT,",
                    "modes.CSS_NUMBER_MODE,",
                    "...STRINGS,",
                    "{",
                    "begin: /(url|data-uri)\\(/,",
                    "end: /\\)/,",
                    "relevance: 0, // from keywords",
                    "keywords: {",
                    "built_in: \"url data-uri\"",
                    "},",
                    "contains: [",
                    "{",
                    "className: \"string\",",
                    "// any character other than `)` as in `url()` will be the start",
                    "// of a string, which ends with `)` (from the parent mode)",
                    "begin: /[^)]/,",
                    "endsWithParent: true,",
                    "excludeEnd: true",
                    "}",
                    "]",
                    "},",
                    "FUNCTION_DISPATCH",
                    "]",
                    "},"
                ],
                "REPLACE": [
                    "{",
                    "begin: ':',",
                    "end: '[;}]',",
                    "contains: [",
                    "hljs.C_BLOCK_COMMENT_MODE,",
                    "modes.HEXCOLOR,",
                    "modes.IMPORTANT,",
