{
    "1/1": {
        "src/languages/handlebars.js": [
            {
                "SEARCH": [
                    "{",
                    "// open block statement",
                    "className: 'template-tag',",
                    "begin: /\\{\\{#/,",
                    "end: /\\}\\}/,",
                    "contains: [OPENING_BLOCK_MUSTACHE_CONTENTS],",
                    "},",
                    "{",
                    "className: 'template-tag',",
                    "begin: /\\{\\{(?=else\\}\\})/,",
                    "end: /\\}\\}/,",
                    "keywords: 'else'",
                    "},",
                    "{",
                    "// closing block statement",
                    "className: 'template-tag',",
                    "begin: /\\{\\{\\\\//,",
                    "end: /\\}\\}/,",
                    "contains: [CLOSING_BLOCK_MUSTACHE_CONTENTS],",
                    "},"
                ],
                "REPLACE": [
                    "{",
                    "// open block statement",
                    "className: 'template-tag',",
                    "begin: /\\{\\{#/,",
                    "end: /\\}\\}/,",
                    "contains: [OPENING_BLOCK_MUSTACHE_CONTENTS],",
                    "},",
                    "// handle `{{else if \u2026}}` exactly like an opening block so that",
                    "// \"if\" and the rest of the conditional get proper highlight",
                    "{",
                    "className: 'template-tag',",
                    "begin: /\\{\\{\\s*else\\s+if\\b/,",
                    "end: /\\}\\}/,",
                    "contains: [OPENING_BLOCK_MUSTACHE_CONTENTS]",
                    "},",
                    "// handle the simple `{{else}}`",
                    "{",
                    "className: 'template-tag',",
                    "begin: /\\{\\{\\s*else\\b/,",
                    "end: /\\}\\}/,",
                    "keywords: 'else'",
                    "},",
                    "{",
                    "// closing block statement",
                    "className: 'template-tag',",
                    "begin: /\\{\\{\\\\//,",
                    "end: /\\}\\}/,",
                    "contains: [CLOSING_BLOCK_MUSTACHE_CONTENTS],",
                    "},"
                ]
            }
        ]
    },
