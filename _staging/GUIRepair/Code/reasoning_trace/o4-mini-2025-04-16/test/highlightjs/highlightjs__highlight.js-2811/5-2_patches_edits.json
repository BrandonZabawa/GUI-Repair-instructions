{
    "1/1": {
        "src/languages/python.js": [
            {
                "SEARCH": [
                    "{",
                    "className: 'meta',",
                    "begin: /^[\\t ]*@/, end: /$/",
                    "},"
                ],
                "REPLACE": [
                    "{",
                    "className: 'meta',",
                    "begin: /^[\\t ]*@/,",
                    "// stop before a comment or EOL so the #\u2026 is treated as a comment",
                    "end: /(?=#|$)/,",
                    "relevance: 0",
                    "},"
                ]
            }
        ]
    },
