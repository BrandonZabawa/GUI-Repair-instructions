                "REPLACE": [
                    "Object.assign(tsLanguage, {",
                    "name: 'TypeScript',",
                    "aliases: ['ts', 'tsx']",
                    "});",
                    "",
                    "// Override the default \u201ctitle\u201d mode so PascalCase identifiers",
                    "// like OutT (not just Out) are fully matched.",
                    "{",
                    "const titleIndex = tsLanguage.contains.findIndex(m => m.className === 'title');",
                    "if (titleIndex !== -1) {",
                    "tsLanguage.contains[titleIndex] = {",
                    "className: 'title',",
                    "begin: /[A-Z][A-Za-z0-9_]*/,",
                    "relevance: 0",
                    "};",
                    "}",
                    "}",
                    "",
                    "return tsLanguage;"
                ]
            }
        ]
