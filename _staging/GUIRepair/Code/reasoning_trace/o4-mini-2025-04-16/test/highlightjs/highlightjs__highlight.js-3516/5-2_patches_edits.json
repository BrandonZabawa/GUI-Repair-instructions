{
    "1/1": {
        "src/languages/css.js": [
            {
                "SEARCH": [
                    "{",
                    "begin: /(url|data-uri)\\(/,",
                    "end: /\\)/,",
                    "relevance: 0, // from keywords",
                    "keywords: { built_in: \"url data-uri\" },",
                    "contains: [",
                    "{",
                    "className: \"string\",",
                    "// any character other than `)` as in `url()` will be the start",
                    "// of a string, which ends with `)` (from the parent mode)",
                    "begin: /[^)]/,",
                    "endsWithParent: true,",
                    "excludeEnd: true",
                    "}",
                    "]",
                    "},"
                ],
                "REPLACE": [
                    "// handle quoted url() so that inner \u201c)\u201d do not close the mode",
                    "{",
                    "begin: /(url|data-uri)\\(\\s*\"/,",
                    "end: /\"\\s*\\)/,",
                    "relevance: 0,",
                    "keywords: { built_in: \"url data-uri\" },",
                    "contains: [",
                    "hljs.QUOTE_STRING_MODE",
                    "]",
                    "},",
                    "{",
                    "begin: /(url|data-uri)\\(\\s*'/,",
                    "end: /'\\s*\\)/,",
                    "relevance: 0,",
                    "keywords: { built_in: \"url data-uri\" },",
                    "contains: [",
                    "hljs.APOS_STRING_MODE",
                    "]",
                    "},",
                    "// fallback for unquoted url()",
                    "{",
                    "begin: /(url|data-uri)\\(/,",
                    "end: /\\)/,",
                    "relevance: 0, // from keywords",
                    "keywords: { built_in: \"url data-uri\" },",
                    "contains: [",
                    "{",
                    "className: \"string\",",
                    "begin: /[^)]/,",
                    "endsWithParent: true,",
                    "excludeEnd: true",
                    "}",
                    "]",
                    "},"
                ]
            }
        ]
    },
