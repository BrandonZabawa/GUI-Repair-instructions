{
    "1/1": {
        "src/languages/perl.js": [
            {
                "SEARCH": [
                    "{",
                    "className: 'regexp',",
                    "begin: /(m|qr)?\\//,",
                    "end: regex.concat(",
                    "/\\//,",
                    "REGEX_MODIFIERS",
                    "),",
                    "contains: [ hljs.BACKSLASH_ESCAPE ],",
                    "relevance: 0 // allows empty \"//\" which is a common comment delimiter in other languages",
                    "}"
                ],
                "REPLACE": [
                    "{",
                    "className: 'regexp',",
                    "// match m or qr with any non-word, non-space, non-{ delimiter (including slash),",
                    "// then body, then the same delimiter, then modifiers",
                    "begin: regex.concat(",
                    "/(?:m|qr)?/,               // optional m or qr",
                    "/([^ \\w\\s\\{]|\\/)/,         // capture delimiter (any non-word, non-space, non-{ or a slash)",
                    "/(?:\\\\.|[^\\\\\\1])*/,        // body: either an escape or any char except backslash or the delimiter",
                    "/\\1/,                      // closing delimiter (same as opener)",
                    "REGEX_MODIFIERS            // any valid Perl modifiers",
                    "),",
                    "contains: [ hljs.BACKSLASH_ESCAPE ],",
                    "relevance: 0",
                    "}"
                ]
            }
        ]
    },
