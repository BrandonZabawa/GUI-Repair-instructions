{
    "1/1": {
        "src/languages/ruby.js": [
            {
                "SEARCH": [
                    "{ // heredocs",
                    "begin: /<<[-~]?'?(\\w+)\\n(?:[^\\n]*\\n)*?\\s*\\1\\b/,",
                    "returnBegin: true,",
                    "contains: [",
                    "{",
                    "begin: /<<[-~]?'?/",
                    "},",
                    "hljs.END_SAME_AS_BEGIN({",
                    "begin: /(\\w+)/,",
                    "end: /(\\w+)/,",
                    "contains: [",
                    "hljs.BACKSLASH_ESCAPE,",
                    "SUBST",
                    "]",
                    "})",
                    "]",
                    "}"
                ],
                "REPLACE": [
                    "{ // heredocs (support single-quoted delimiters and .method calls)",
                    "begin: /<<[-~]?'?(\\w+)'?(?:\\.\\w+)?\\n(?:[^\\n]*\\n)*?\\s*\\1\\b/,",
                    "returnBegin: true,",
                    "contains: [",
                    "{",
                    "// match the opener (<<- or <<~ plus optional leading quote)",
                    "begin: /<<[-~]?'?/",
                    "},",
                    "hljs.END_SAME_AS_BEGIN({",
                    "// capture the unquoted delimiter name",
                    "begin: /(\\w+)/,",
                    "end: /(\\w+)/,",
                    "contains: [",
                    "hljs.BACKSLASH_ESCAPE,",
                    "SUBST",
                    "]",
                    "})",
                    "]",
                    "}"
                ]
            }
        ]
    },
