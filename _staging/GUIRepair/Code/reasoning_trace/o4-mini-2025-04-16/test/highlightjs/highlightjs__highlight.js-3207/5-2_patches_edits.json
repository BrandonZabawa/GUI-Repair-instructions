                    "{",
                    "className: 'meta',",
                    "begin: /&[a-zA-Z_][a-zA-Z0-9_.]*[!?=]?\\/\\d+/,",
                    "relevance: 0",
                    "},",
                    "hljs.HASH_COMMENT_MODE,"
                ]
            }
        ]
    },
