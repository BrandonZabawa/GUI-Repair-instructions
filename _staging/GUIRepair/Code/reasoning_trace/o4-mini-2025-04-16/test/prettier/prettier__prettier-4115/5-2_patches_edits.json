{
    "1/1": {
        "src/language-markdown/printer-markdown.js": [
            {
                "SEARCH": [
                    "case \"html\": {",
                    "const parentNode = path.getParentNode();",
                    "return parentNode.type === \"root\" &&",
                    "privateUtil.getLast(parentNode.children) === node",
                    "? node.value.trimRight()",
                    ": node.value;",
                    "}"
                ],
                "REPLACE": [
                    "    case \"html\": {",
                    "      // Trim away *all* leading/trailing whitespace so nested HTML",
                    "      // never \u201cremembers\u201d its old indent.",
                    "      const value = node.value.trim();",
                    "      return value;",
                    "    }"
                ]
            }
        ]
    }
}