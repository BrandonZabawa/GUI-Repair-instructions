                ],
                "REPLACE": [
                    "  function getParserName(lang) {",
                    "    // If the code fence has trailing attributes (e.g. \"{cmd=node}\"), drop them.",
                    "    const cleanedLang =",
                    "      typeof lang === \"string\" ? lang.split(/[{\\s]/)[0].toLowerCase() : \"\";",
                    "    const supportInfo = support.getSupportInfo(null, {",
                    "      plugins: options.plugins,",
                    "      pluginsLoaded: true",
                    "    });",
                    "    const language = supportInfo.languages.find(",
                    "      language =>",
                    "        language.name.toLowerCase() === cleanedLang ||",
                    "        (language.extensions &&",
                    "          language.extensions.find(ext => ext.substring(1) === cleanedLang))",
                    "    );"
                ]
            }
        ]
    }
}