    "1/1": {
        "src/language-js/needs-parens.js": [
            {
                "SEARCH": [
                    "if (",
                    "// Preserve parens if we have a Flow annotation comment, unless we're using the Flow",
                    "// parser. The Flow parser turns Flow comments into type annotation nodes in its",
                    "// AST, which we handle separately.",
                    "options.parser !== \"flow\" &&",
                    "hasFlowShorthandAnnotationComment(path.getValue())",
                    ") {",
                    "return true;",
                    "}"
                ],
                "REPLACE": [
                    "  if (",
                    "    // Preserve parens if we have a Flow annotation comment, unless we're using the Flow",
                    "    // parser. The Flow parser turns Flow comments into type annotation nodes in its",
                    "    // AST, which we handle separately.",
                    "    options.parser !== \"flow\" &&",
                    "    hasFlowShorthandAnnotationComment(path.getValue())",
                    "  ) {",
                    "    return true;",
                    "  }",
                    "",
                    "  // Preserve parentheses for JSDoc @satisfies comments to keep intellisense working",
                    "  if (",
                    "    node.type === \"ObjectExpression\" &&",
                    "    path.getValue().comments &&",
                    "    path.getValue().comments.some((comment) => comment.value.includes(\"@satisfies\"))",
                    "  ) {",
                    "    return true;",
                    "  }"
                ]
            }
        ]
    }
}