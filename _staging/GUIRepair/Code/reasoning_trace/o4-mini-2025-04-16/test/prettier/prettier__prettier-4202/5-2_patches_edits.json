                "REPLACE": [
                    "  const columnMaxWidths = contents.reduce(",
                    "    (currentWidths, rowContents) =>",
                    "      currentWidths.map((width, columnIndex) =>",
                    "        Math.max(width, privateUtil.getStringWidth(rowContents[columnIndex]))",
                    "      ),",
                    "    contents[0].map(() => 3) // minimum width = 3 (---, :--, :-:, --:)",
                    "  );",
                    "",
                    "  // If any column is wider than the print width, disable fancy table",
                    "  // separators and fallback to a simple 3-dash pattern.",
                    "  if (Math.max(...columnMaxWidths) > options.printWidth) {",
                    "    function fallbackSeparator() {",
                    "      return concat([",
                    "        \"| \",",
                    "        join(",
                    "          \" | \",",
                    "          node.align.map(align => {",
                    "            switch (align) {",
                    "              case \"left\":",
                    "                return \":---\";",
                    "              case \"right\":",
                    "                return \"---:\";",
                    "              case \"center\":",
                    "                return \":---:\";",
                    "              default:",
                    "                return \"---\";",
                    "            }",
                    "          })",
                    "        ),",
                    "        \" |\"",
                    "      ]);",
                    "    }",
                    "    return join(hardline, [",
                    "      printRow(contents[0]),",
                    "      fallbackSeparator(),",
                    "      join(hardline, contents.slice(1).map(printRow))",
                    "    ]);",
                    "  }"
                ]
            }
        ]
    }
