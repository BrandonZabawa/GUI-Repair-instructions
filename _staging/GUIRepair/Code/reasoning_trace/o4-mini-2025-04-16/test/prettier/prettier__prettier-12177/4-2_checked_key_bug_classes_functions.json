                "        index === 0",
                "          ? line.trimEnd()",
                "          : \" \" + (index < lines.length - 1 ? line.trim() : line.trimStart())",
                "      )",
                "    ),",
                "    \"*/\",",
                "  ];",
                "}",
                "",
                "module.exports = { printComment };"
