                    "BpmnImporter.prototype.addLabel = function(semantic, di, element) {",
                    "  var bounds,",
                    "      text,",
                    "      label;",
                    "",
                    "  // 1) compute external label bounds from the DI",
                    "  bounds = getExternalLabelBounds(di, element);",
                    "",
                    "  // 2) if the pool/lane is vertical, swap x/y and width/height",
                    "  if (di.isHorizontal === false) {",
                    "    var tmpX = bounds.x,",
                    "        tmpW = bounds.width;",
                    "",
                    "    bounds.x      = bounds.y;",
                    "    bounds.y      = tmpX;",
                    "    bounds.width  = bounds.height;",
                    "    bounds.height = tmpW;",
                    "  }",
                    "",
                    "  // 3) allow the text renderer to refine those bounds (word wrapping, etc)",
                    "  text = getLabel(element);",
                    "  if (text) {",
                    "    bounds = this._textRenderer.getExternalLabelBounds(bounds, text);",
                    "  }",
                    "",
                    "  // 4) finally create the label",
                    "  label = this._elementFactory.createLabel(elementData(semantic, di, {",
                    "    id: semantic.id + '_label',",
                    "    labelTarget: element,",
                    "    type: 'label',",
                    "    hidden: element.hidden || !text,",
                    "    x: Math.round(bounds.x),",
                    "    y: Math.round(bounds.y),",
                    "    width: Math.round(bounds.width),",
                    "    height: Math.round(bounds.height)",
                    "  }));",
                    "",
                    "  return this._canvas.addShape(label, element.parent);",
                    "};"
                ]
            }
        ]
