                " * @param {ModdleElement} semantic",
                " * @param {ModdleElement} di",
                " * @param {Shape} parentElement",
                " *",
                " * @return {Shape | Root | Connection}",
                " */",
                "BpmnImporter.prototype.add = function(semantic, di, parentElement) {",
                "  var element,",
                "      translate = this._translate,",
                "      hidden;",
                "",
                "  var parentIndex;",
