                "  'elementFactory',",
                "  'elementRegistry',",
                "  'translate',",
                "  'textRenderer'",
                "];",
                "",
                "",
                "/**",
                " * Add a BPMN element (semantic) to the canvas making it a child of the",
                " * given parent.",
