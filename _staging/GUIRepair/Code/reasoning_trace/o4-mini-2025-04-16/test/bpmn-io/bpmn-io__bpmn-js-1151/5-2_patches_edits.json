{
    "1/1": {
        "lib/features/copy-paste/BpmnCopyPaste.js": [
            {
                "SEARCH": [
                    "// fill and stroke will be set to DI",
                    "copyProperties(businessObject.di, descriptor.di, [",
                    "'fill',",
                    "'stroke'",
                    "]);",
                    "",
                    "copyProperties(businessObject.di, descriptor, 'isExpanded');",
                    "",
                    "if (isLabel(descriptor)) {",
                    "return descriptor;",
                    "}"
                ],
                "REPLACE": [
                    "    // fill and stroke will be set to DI",
                    "    copyProperties(businessObject.di, descriptor.di, [",
                    "      'fill',",
                    "      'stroke'",
                    "    ]);",
                    "",
                    "    copyProperties(businessObject.di, descriptor, 'isExpanded');",
                    "",
                    "    if (isLabel(descriptor)) {",
                    "",
                    "      // preserve external label bounds (copy DI)",
                    "      var labelDi = businessObject.di && businessObject.di.label;",
                    "      if (labelDi) {",
                    "        // labelDi may be a bounds object or wrap bounds",
                    "        var bounds = labelDi.bounds || labelDi;",
                    "",
                    "        descriptor.x      = Math.round(bounds.x);",
                    "        descriptor.y      = Math.round(bounds.y);",
                    "        descriptor.width  = Math.round(bounds.width);",
                    "        descriptor.height = Math.round(bounds.height);",
                    "      }",
                    "",
                    "      return descriptor;",
                    "    }"
                ]
            }
        ]
    }
}