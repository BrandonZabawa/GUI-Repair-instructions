                "REPLACE": [
                    "export function getDefaultPosition(source, element) {",
                    "  ",
                    "  var sourceTrbl = asTRBL(source);",
                    "  ",
                    "  var sourceMid = getMid(source);",
                    "  ",
                    "  // simply put element right next to source",
                    "  // guard against undefined / non-finite element.width",
                    "  var width = element.width || 0;",
                    "  ",
                    "  return {",
                    "    x: sourceTrbl.right + DEFAULT_HORIZONTAL_DISTANCE + width / 2,",
                    "    y: sourceMid.y",
                    "  };",
                    "}"
                ]
            }
        ]
    }
