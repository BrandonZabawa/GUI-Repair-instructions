        "  forEach",
        "} from 'min-dash';",
        "",
        "import BaseRenderer from 'diagram-js/lib/draw/BaseRenderer';",
        "",
        "import {",
        "  isExpanded,",
        "  isEventSubProcess",
        "} from '../util/DiUtil';",
        "",
        "import {",
        "  getLabel",
        "} from '../features/label-editing/LabelUtil';",
