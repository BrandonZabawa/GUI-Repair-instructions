{
    "1/1": {
        "lib/import/BpmnImporter.js": [
            {
                "SEARCH": [
                    "// (optional) LABEL",
                    "if (isLabelExternal(semantic) && getLabel(element)) {",
                    "this.addLabel(semantic, element);",
                    "}"
                ],
                "REPLACE": [
                    "  // (optional) external LABEL (including message\u2010flow \u2192 messageRef.name fallback)",
                    "  if ( isLabelExternal(semantic) ) {",
                    "",
                    "    // first try the flow\u2019s own name",
                    "    var labelText = getLabel(element);",
                    "",
                    "    // fallback to the referenced Message\u2019s name for MessageFlows",
                    "    if (!labelText && is(semantic, 'bpmn:MessageFlow') && semantic.messageRef) {",
                    "      labelText = semantic.messageRef.name || '';",
                    "      // temporarily ensure getLabel(element) will pick it up",
                    "      semantic.name = labelText;",
                    "    }",
                    "",
                    "    if (labelText) {",
                    "      this.addLabel(semantic, element);",
                    "    }",
                    "  }"
                ]
            }
        ]
    }
}