                    "",
                    "        if (entries && entries.append) {",
                    "          editorActions && editorActions.trigger('appendElement', event);",
                    "        } else {",
                    "          // fallback to create if no append menu available",
                    "          editorActions && editorActions.trigger('createElement', event);",
                    "        }",
                    "      } else {",
