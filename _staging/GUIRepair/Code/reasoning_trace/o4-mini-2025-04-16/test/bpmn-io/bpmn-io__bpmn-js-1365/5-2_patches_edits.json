{
    "1/1": {
        "lib/draw/BpmnRenderer.js": [
            {
                "SEARCH": [
                    "import BaseRenderer from 'diagram-js/lib/draw/BaseRenderer';",
                    "import inherits from 'inherits';",
                    "import { assign } from 'min-dash';"
                ],
                "REPLACE": [
                    "import BaseRenderer from 'diagram-js/lib/draw/BaseRenderer';",
                    "import inherits from 'inherits';",
                    "import { assign } from 'min-dash';",
                    "import { isCollection } from './BpmnRenderUtil';"
                ]
            },
            {
                "SEARCH": [
                    "// \u2026",
                    "'bpmn:DataObjectReference': function(parentGfx, element) {",
                    "var semantic = getSemantic(element),",
                    "dataRef  = semantic.dataObjectRef;",
                    "",
                    "var attrs = computeStyle({",
                    "fill: getFillColor(element, defaultFillColor),",
                    "stroke: getStrokeColor(element, defaultStrokeColor)",
                    "});",
                    "",
                    "var rect = drawRect(parentGfx, element.width, element.height, 0, attrs);",
                    "",
                    "return rect;",
                    "}",
                    "// \u2026"
                ],
                "REPLACE": [
                    "    // \u2026",
                    "    'bpmn:DataObjectReference': function(parentGfx, element) {",
                    "      var semantic              = getSemantic(element),",
                    "          dataRef               = semantic.dataObjectRef,",
                    "          collectionMarkerOnCss = isCollection(element);",
                    "",
                    "      var attrs = computeStyle({",
                    "        fill: getFillColor(element, defaultFillColor),",
                    "        stroke: getStrokeColor(element, defaultStrokeColor)",
                    "      });",
                    "",
                    "      // draw the \u201cfile\u201d rectangle",
                    "      var rect = drawRect(parentGfx, element.width, element.height, 0, attrs);",
                    "",
                    "      // if it\u2019s a collection, draw the little three\u2010bar marker",
                    "      if (collectionMarkerOnCss) {",
                    "        var pathData = pathMap.getScaledPath('DATA_OBJECT_COLLECTION_PATH', {",
                    "          xScaleFactor:     1,",
                    "          yScaleFactor:     1,",
                    "          containerWidth:   element.width,",
                    "          containerHeight:  element.height,",
                    "          position: {",
                    "            // tweak these to place marker in the top-left corner",
                    "            mx: 0.15,",
                    "            my: 0.15",
                    "          }",
                    "        });",
                    "",
                    "        drawPath(",
                    "          parentGfx,",
                    "          pathData,",
                    "          computeStyle({",
                    "            stroke:      attrs.stroke,",
                    "            strokeWidth: attrs.strokeWidth",
                    "          })",
                    "        );",
                    "      }",
                    "",
                    "      return rect;",
                    "    }",
                    "    // \u2026"
                ]
            }
        ],
        "lib/features/context-pad/ContextPadProvider.js": [
            {
                "SEARCH": [
                    "if (isAny(businessObject, [",
                    "'bpmn:FlowNode',",
                    "'bpmn:InteractionNode',",
                    "'bpmn:DataObjectReference',",
                    "'bpmn:DataStoreReference'",
                    "])) {",
                    "",
                    "assign(actions, {",
                    "'append.text-annotation': appendAction('bpmn:TextAnnotation', 'bpmn-icon-text-annotation'),",
                    "",
                    "'connect': {",
                    "group: 'connect',",
                    "className: 'bpmn-icon-connection-multi',",
                    "title: translate('Connect using ' +",
                    "(businessObject.isForCompensation ? '' : 'Sequence/MessageFlow or ') +",
                    "'Association'),",
                    "action: {",
                    "click: startConnect,",
                    "dragstart: startConnect",
                    "}",
                    "}",
                    "});",
                    "}"
                ],
                "REPLACE": [
                    "  if (isAny(businessObject, [",
                    "    'bpmn:FlowNode',",
                    "    'bpmn:InteractionNode',",
                    "    'bpmn:DataObjectReference',",
                    "    'bpmn:DataStoreReference'",
                    "  ])) {",
                    "",
                    "    assign(actions, {",
                    "      'append.text-annotation': appendAction('bpmn:TextAnnotation', 'bpmn-icon-text-annotation'),",
                    "",
                    "      'connect': {",
                    "        group: 'connect',",
                    "        className: 'bpmn-icon-connection-multi',",
                    "        title: translate('Connect using ' +",
                    "                  (businessObject.isForCompensation ? '' : 'Sequence/MessageFlow or ') +",
                    "                  'Association'),",
                    "        action: {",
                    "          click: startConnect,",
                    "          dragstart: startConnect",
                    "        }",
                    "      },",
                    "",
                    "      // toggle the collection marker on DataObjectReference/DataStoreReference",
                    "      'toggle-collection': {",
                    "        group: 'edit',",
                    "        className: 'bpmn-icon-data-object-collection',",
                    "        title: translate('Toggle collection'),",
                    "        action: {",
                    "          click: function(event, element) {",
                    "            var bo      = element.businessObject,",
                    "                current = bo.isCollection || (bo.dataObjectRef && bo.dataObjectRef.isCollection);",
                    "",
                    "            // flip on the element itself",
                    "            modeling.updateProperties(element, {",
                    "              isCollection: !current",
                    "            });",
                    "",
                    "            // if this is a DataObjectReference, also sync the underlying DataObject",
                    "            if (bo.dataObjectRef) {",
                    "              modeling.updateProperties(bo.dataObjectRef, {",
                    "                isCollection: !current",
                    "              });",
                    "            }",
                    "          }",
                    "        }",
                    "      }",
                    "    });",
                    "  }"
                ]
            }
        ]
    }
}