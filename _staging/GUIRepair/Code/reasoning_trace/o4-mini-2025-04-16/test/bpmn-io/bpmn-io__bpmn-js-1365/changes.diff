diff --git a/lib/features/context-pad/ContextPadProvider.js b/lib/features/context-pad/ContextPadProvider.js
index 356af0ae..696a8842 100644
--- a/lib/features/context-pad/ContextPadProvider.js
+++ b/lib/features/context-pad/ContextPadProvider.js
@@ -382,6 +382,31 @@ ContextPadProvider.prototype.getContextPadEntries = function(element) {
           click: startConnect,
           dragstart: startConnect
         }
+      },
+
+      // toggle the collection marker on DataObjectReference/DataStoreReference
+      'toggle-collection': {
+        group: 'edit',
+        className: 'bpmn-icon-data-object-collection',
+        title: translate('Toggle collection'),
+        action: {
+          click: function(event, element) {
+            var bo      = element.businessObject,
+                current = bo.isCollection || (bo.dataObjectRef && bo.dataObjectRef.isCollection);
+
+            // flip on the element itself
+            modeling.updateProperties(element, {
+              isCollection: !current
+            });
+
+            // if this is a DataObjectReference, also sync the underlying DataObject
+            if (bo.dataObjectRef) {
+              modeling.updateProperties(bo.dataObjectRef, {
+                isCollection: !current
+              });
+            }
+          }
+        }
       }
     });
   }
