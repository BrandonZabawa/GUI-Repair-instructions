{
    "1/1": {
        "lib/features/rules/BpmnRules.js": [
            {
                "SEARCH": [
                    "function isMessageFlowTarget(element) {",
                    "return (",
                    "is(element, 'bpmn:InteractionNode') &&",
                    "!is(element, 'bpmn:BoundaryEvent') &&",
                    "!isForCompensation(element) && (",
                    "!is(element, 'bpmn:Event') || (",
                    "is(element, 'bpmn:CatchEvent') &&",
                    "hasEventDefinitionOrNone(element, 'bpmn:MessageEventDefinition')",
                    ")",
                    ")",
                    ");",
                    "}"
                ],
                "REPLACE": [
                    "function isMessageFlowTarget(element) {",
                    "  // allow message flows to intermediate message catch boundary events",
                    "  if ( is(element, 'bpmn:BoundaryEvent') &&",
                    "       hasEventDefinition(element, 'bpmn:MessageEventDefinition') ) {",
                    "",
                    "    return true;",
                    "  }",
                    "",
                    "  return (",
                    "    is(element, 'bpmn:InteractionNode') &&",
                    "    // either not a boundary event, or a boundary that carries a message definition",
                    "    ( !is(element, 'bpmn:BoundaryEvent')",
                    "      || hasEventDefinition(element, 'bpmn:MessageEventDefinition')",
                    "    ) &&",
                    "    !isForCompensation(element) && (",
                    "      !is(element, 'bpmn:Event') || (",
                    "        is(element, 'bpmn:CatchEvent') &&",
                    "        hasEventDefinitionOrNone(element, 'bpmn:MessageEventDefinition')",
                    "      )",
                    "    )",
                    "  );",
                    "}"
                ]
            }
        ]
    }
}