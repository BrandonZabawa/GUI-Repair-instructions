{
    "1/1": {
        "lib/features/modeling/behavior/ReplaceConnectionBehavior.js": [
            {
                "SEARCH": [
                    "// replace SequenceFlow <> MessageFlow",
                    "if (replacementType) {",
                    "modeling.connect(source, target, {",
                    "type: replacementType,",
                    "waypoints: connection.waypoints.slice()",
                    "});",
                    "}"
                ],
                "REPLACE": [
                    "    // replace SequenceFlow <> MessageFlow",
                    "    if (replacementType) {",
                    "      modeling.connect(source, target, {",
                    "        type: replacementType,",
                    "        waypoints: connection.waypoints.slice()",
                    "      });",
                    "    }",
                    "+",
                    "+  // automatically re-parent associations when their endpoints",
                    "+  // move out of the old subprocess/collaboration",
                    "+  if (is(connection, 'bpmn:Association')) {",
                    "+    // pick a new semantic parent (use source, or fall back to target)",
                    "+    var newParent = source.parent || target.parent;",
                    "+",
                    "+    // if the connection is still valid and its current BPMN parent",
                    "+    // differs from the shape\u2010parent of its endpoint, re-create it",
                    "+    if (newParent && connection.parent !== newParent) {",
                    "+      // remove the old association under the wrong parent",
                    "+      modeling.removeConnection(connection);",
                    "+",
                    "+      // re-connect under the correct parent",
                    "+      modeling.connect(source, target, {",
                    "+        type: 'bpmn:Association',",
                    "+        waypoints: connection.waypoints.slice()",
                    "+      });",
                    "+    }",
                    "+  }"
                ]
            }
        ]
    }
}