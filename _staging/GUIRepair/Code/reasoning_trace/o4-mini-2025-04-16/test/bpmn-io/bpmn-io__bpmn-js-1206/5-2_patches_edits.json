                "REPLACE": [
                    "  this.preExecute('elements.move', function(context) {",
                    "    var shapes = context.shapes,",
                    "        host = context.newHost;",
                    "",
                    "    // only detach boundary events when they are moved off of their host",
                    "    if (!host) {",
                    "      var keptShapes    = [],",
                    "          replacedShapes = [];",
                    "",
                    "      shapes.forEach(function(s) {",
                    "        // for each boundary event: convert to an intermediate event",
                    "        if (!isLabel(s) && is(s, 'bpmn:BoundaryEvent')) {",
                    "          var eventDefinition = getEventDefinition(s),",
                    "              config;",
                    "",
                    "          if (eventDefinition) {",
                    "            config = {",
                    "              type: 'bpmn:IntermediateCatchEvent',",
                    "              eventDefinitionType: eventDefinition.$type",
                    "            };",
                    "          } else {",
                    "            config = {",
                    "              type: 'bpmn:IntermediateThrowEvent'",
                    "            };",
                    "          }",
                    "",
                    "          // perform the replacement",
                    "          var newShape = bpmnReplace.replaceElement(s, config, {",
                    "            layoutConnection: false",
                    "          });",
                    "",
                    "          replacedShapes.push(newShape);",
                    "        } else {",
                    "          // keep non\u2010boundary shapes untouched",
                    "          keptShapes.push(s);",
                    "        }",
                    "      });",
                    "",
                    "      // if we replaced any, update the moved shapes array",
                    "      if (replacedShapes.length) {",
                    "        context.shapes = keptShapes.concat(replacedShapes);",
                    "      }",
                    "    }",
                    "  }, true);"
                ]
            }
        ]
    }
