{
    "1/1": {
        "lib/features/popup-menu/ReplaceMenuProvider.js": [
            {
                "SEARCH": [
                    "// this is the existing DataObjectReference header handling",
                    "if (is(element, 'bpmn:DataObjectReference')) {",
                    "headerEntries = headerEntries.concat(this._getDataObjectIsCollection(element));",
                    "}"
                ],
                "REPLACE": [
                    "  // add header entries for DataObjectReference \u2194 DataStoreReference switching",
                    "  if (is(element, 'bpmn:DataObjectReference')) {",
                    "    // switch to DataStoreReference",
                    "    headerEntries.push(this._getReplaceDataObjectToDataStore(element));",
                    "    headerEntries = headerEntries.concat(this._getDataObjectIsCollection(element));",
                    "  }",
                    "  if (is(element, 'bpmn:DataStoreReference')) {",
                    "    // switch to DataObjectReference",
                    "    headerEntries.push(this._getReplaceDataStoreToDataObject(element));",
                    "  }"
                ]
            },
            {
                "SEARCH": [
                    "var dataObjectEntries = [",
                    "{",
                    "id: 'toggle-is-collection',",
                    "className: 'bpmn-icon-parallel-mi-marker',",
                    "title: translate('Collection'),",
                    "active: isCollection,",
                    "action: toggleIsCollection,",
                    "}",
                    "];",
                    "return dataObjectEntries;",
                    "};"
                ],
                "REPLACE": [
                    "  var dataObjectEntries = [",
                    "    {",
                    "      id: 'toggle-is-collection',",
                    "      className: 'bpmn-icon-parallel-mi-marker',",
                    "      title: translate('Collection'),",
                    "      active: isCollection,",
                    "      action: toggleIsCollection,",
                    "    }",
                    "  ];",
                    "  return dataObjectEntries;",
                    "};",
                    "",
                    "/**",
                    " * Provide replace entry to switch from DataObjectReference to DataStoreReference.",
                    " */",
                    "ReplaceMenuProvider.prototype._getReplaceDataObjectToDataStore = function(element) {",
                    "  var translate = this._translate,",
                    "      replaceElement = this._bpmnReplace.replaceElement;",
                    "",
                    "  return {",
                    "    id: 'replace-with-data-store-reference',",
                    "    className: 'bpmn-icon-data-store',",
                    "    title: translate('Switch to Data Store Reference'),",
                    "    action: function() {",
                    "      replaceElement(element, { type: 'bpmn:DataStoreReference' });",
                    "    }",
                    "  };",
                    "};",
                    "",
                    "/**",
                    " * Provide replace entry to switch from DataStoreReference to DataObjectReference.",
                    " */",
                    "ReplaceMenuProvider.prototype._getReplaceDataStoreToDataObject = function(element) {",
                    "  var translate = this._translate,",
                    "      replaceElement = this._bpmnReplace.replaceElement;",
                    "",
                    "  return {",
                    "    id: 'replace-with-data-object-reference',",
                    "    className: 'bpmn-icon-data-object',",
                    "    title: translate('Switch to Data Object Reference'),",
                    "    action: function() {",
                    "      replaceElement(element, { type: 'bpmn:DataObjectReference' });",
                    "    }",
                    "  };",
                    "};"
                ]
            }
