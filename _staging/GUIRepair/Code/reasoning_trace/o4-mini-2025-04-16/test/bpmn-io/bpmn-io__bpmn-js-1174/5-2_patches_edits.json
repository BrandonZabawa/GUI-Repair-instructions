{
    "1/1": {
        "lib/features/grid-snapping/behavior/LayoutConnectionBehavior.js": [
            {
                "SEARCH": [
                    "if (hints.connectionStart || hints.connectionEnd) {",
                    "return;",
                    "}"
                ],
                "REPLACE": [
                    "    // only skip snapping during an *initial* creation (both ends),",
                    "    // but allow snapping when you reconnect one end (to create loops)",
                    "    if (hints.connectionStart && hints.connectionEnd) {",
                    "      return;",
                    "    }"
                ]
            }
        ],
        "lib/features/modeling/BpmnLayouter.js": [
            {
                "SEARCH": [
                    "if (source === target) {",
                    "manhattanOptions = {",
                    "preferredLayouts: [ 'b:l' ]",
                    "};",
                    "} else"
                ],
                "REPLACE": [
                    "    if (source === target) {",
                    "      // when looping back to the same element, preserve existing docking/waypoints",
                    "      manhattanOptions = {",
                    "        preferredLayouts: [ 'b:l' ],",
                    "        preserveDocking: 'all'",
                    "      };",
                    "    } else"
                ]
            }
        ]
    }
}