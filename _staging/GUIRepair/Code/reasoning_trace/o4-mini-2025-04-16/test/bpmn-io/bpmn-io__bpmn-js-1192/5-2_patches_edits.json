                    "return false;",
                    "}",
                    "",
                    "// disallow copying boundary\u2010events if their host isn\u2019t also in the selection",
                    "if (is(element, 'bpmn:BoundaryEvent') && !includes(elements, element.host)) {",
                    "return false;",
                    "}",
                    "",
                    "return true;",
                    "}"
                ],
