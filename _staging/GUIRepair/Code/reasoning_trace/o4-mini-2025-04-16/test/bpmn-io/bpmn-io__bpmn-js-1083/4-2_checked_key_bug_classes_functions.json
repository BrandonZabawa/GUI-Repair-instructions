            "function_code": [
                "export function getBoundaryAttachment(position, targetBounds) {",
                "",
                "  var orientation = getOrientation(position, targetBounds, -15);",
                "",
                "  if (orientation !== 'intersect') {",
                "    return orientation;",
                "  } else {",
                "    return null;",
                "  }",
                "}"
