{
    "1/1": {
        "lib/features/ordering/BpmnOrderingProvider.js": [
            {
                "SEARCH": [
                    "var orders = [",
                    "{ type: 'bpmn:SubProcess', order: { level: 6 } },",
                    "{",
                    "type: 'bpmn:SequenceFlow',",
                    "order: {",
                    "level: 3,",
                    "containers: [",
                    "'bpmn:Participant',",
                    "'bpmn:FlowElementsContainer'",
                    "]",
                    "}",
                    "},"
                ],
                "REPLACE": [
                    "  var orders = [",
                    "    // make sure group borders are always on top of all other elements",
                    "    { type: 'bpmn:Group',      order: { level: 7 } },",
                    "    { type: 'bpmn:SubProcess', order: { level: 6 } },",
                    "    {",
                    "      type: 'bpmn:SequenceFlow',",
                    "      order: {",
                    "        level: 3,",
                    "        containers: [",
                    "          'bpmn:Participant',",
                    "          'bpmn:FlowElementsContainer'",
                    "        ]",
                    "      }",
                    "    },"
                ]
            }
        ]
    }
}