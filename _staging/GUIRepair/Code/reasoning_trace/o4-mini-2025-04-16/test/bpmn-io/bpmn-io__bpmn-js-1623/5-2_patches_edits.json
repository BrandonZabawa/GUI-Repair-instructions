                "REPLACE": [
                    "  eventBus.on('import.done', function() {",
                    "    elementRegistry.filter(function(e) {",
                    "      return self.canDrillDown(e);",
                    "    }).map(function(el) {",
                    "      self.addOverlay(el);",
                    "    });",
                    "  });",
                    "",
                    "  // when deep\u2010link or manual root change happens, re\u2010add + re\u2010show overlays",
                    "  eventBus.on('root.set', function() {",
                    "    // re-attach overlays on all collapsed SubProcess shapes",
                    "    elementRegistry",
                    "      .filter(function(e) { return self.canDrillDown(e); })",
                    "      .forEach(function(el) { self.addOverlay(el); });",
                    "",
                    "    // update empty\u2010marker state on all overlays",
                    "    elementRegistry",
                    "      .getAll()",
                    "      .forEach(function(e) { self.updateDrilldownOverlay(e); });",
                    "  });"
                ]
            }
