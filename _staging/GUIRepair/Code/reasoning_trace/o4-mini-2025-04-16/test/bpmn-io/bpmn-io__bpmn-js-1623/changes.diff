+  // when deep‐link or manual root change happens, re‐add + re‐show overlays
+  eventBus.on('root.set', function() {
+    // re-attach overlays on all collapsed SubProcess shapes
+    elementRegistry
+      .filter(function(e) { return self.canDrillDown(e); })
+      .forEach(function(el) { self.addOverlay(el); });
+
+    // update empty‐marker state on all overlays
+    elementRegistry
+      .getAll()
+      .forEach(function(e) { self.updateDrilldownOverlay(e); });
+  });
+
 }
 
