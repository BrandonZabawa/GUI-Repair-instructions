                    "  local function resolveCellAnnotes(codeBlockEl, processAnnotation) ",
                    "",
                    "    -- determine language for annotation lookup (handles both",
                    "    -- \u201clanguage-xyz\u201d and bare \u201cxyz\u201d classes)",
                    "    local lang",
                    "    for _, c in ipairs(codeBlockEl.attr.classes) do",
                    "      local cnorm = c",
                    "      -- strip leading \"language-\"",
                    "      if c:match(\"^language%-\") then",
                    "        cnorm = c:sub(#\"language-\" + 1)",
                    "      end",
                    "      if kLangCommentChars[cnorm] then",
                    "        lang = cnorm",
                    "        break",
                    "      end",
                    "    end",
                    "    local annotationProvider = annoteProvider(lang)",
                    "    if annotationProvider ~= nil then"
                ]
            }
        ]
