                "REPLACE": [
                    "    // make the filter paths windows safe",
                    "    allDefaults.filters = allDefaults.filters.map((filter) => {",
                    "      if (typeof (filter) === \"string\") {",
                    "        return pandocMetadataPath(filter);",
                    "      } else {",
                    "        return {",
                    "          type: filter.type,",
                    "          path: pandocMetadataPath(filter.path),",
                    "        };",
                    "      }",
                    "    });",
                    "",
                    "    // disable the built-in crossref filter when the user explicitly",
                    "    // requests crossref: false in their format metadata",
                    "    if (options.format.metadata.crossref === false) {",
                    "      allDefaults.filters = allDefaults.filters.filter((filter) => {",
                    "        // filter may be a string or an object { type, path }",
                    "        const filterPath = typeof filter === \"string\" ? filter : filter.path;",
                    "        // drop any lua filter named `crossref.lua`",
                    "        return !filterPath.endsWith(\"/filters/crossref.lua\");",
                    "      });",
                    "    }"
                ]
            }
        ]
