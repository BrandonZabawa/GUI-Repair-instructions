{
    "1/1": {
        "src/resources/filters/crossref/theorems.lua": [
            {
                "SEARCH": [
                    "if _quarto.format.isLatexOutput() then",
                    "local preamble = pandoc.Para(pandoc.RawInline(\"latex\",",
                    "\"\\\\begin{\" .. theoremType.env .. \"}\"))",
                    "preamble.content:insert(pandoc.RawInline(\"latex\", \"[\"))",
                    "if name then",
                    "tappend(preamble.content, name)",
                    "end",
                    "preamble.content:insert(pandoc.RawInline(\"latex\",",
                    "\"\\\\label{\" .. label .. \"}\"",
                    "))",
                    "el.content:insert(1, preamble)"
                ],
                "REPLACE": [
                    "        if _quarto.format.isLatexOutput() then",
                    "          -- insert raw block for theorem begin to avoid extra vspace and remove hypertarget",
                    "          local name_opt = \"\"",
                    "          if name then",
                    "            name_opt = \"[\" .. pandoc.utils.stringify(name) .. \"]\"",
                    "          end",
                    "          el.content:insert(1,",
                    "            pandoc.RawBlock(\"latex\",",
                    "              \"\\\\begin{\" .. theoremType.env .. \"}\" ..",
                    "              name_opt .. \"\\\\label{\" .. label .. \"}\"",
                    "            ))"
                ]
            },
            {
                "SEARCH": [
                    "el.content:insert(pandoc.Para(pandoc.RawInline(\"latex\",",
                    "\"\\\\end{\" .. theoremType.env .. \"}\"",
                    ")))",
                    "elseif _quarto.format.isJatsOutput() then"
                ],
                "REPLACE": [
                    "          el.content:insert(",
                    "            pandoc.RawBlock(\"latex\",",
                    "              \"\\\\end{\" .. theoremType.env .. \"}\"",
                    "            ))",
                    "        elseif _quarto.format.isJatsOutput() then"
                ]
            },
            {
                "SEARCH": [
                    "else",
                    "-- see if this is a proof, remark, or solution",
                    "local proof = proofType(el)",
                    "if proof ~= nil then",
                    "",
                    "-- ensure requisite latex is injected",
                    "crossref.usingTheorems = true",
                    "",
                    "if proof.env ~= \"proof\" then",
                    "el.attr.classes:insert(\"proof\")",
                    "end",
                    "",
                    "-- capture then remove name",
                    "local name = markdownToInlines(el.attr.attributes[\"name\"])",
                    "if not name or #name == 0 then",
                    "name = resolveHeadingCaption(el)",
                    "end",
                    "el.attr.attributes[\"name\"] = nil",
                    "",
                    "-- output",
                    "if _quarto.format.isLatexOutput() then",
                    "local preamble = pandoc.Para(pandoc.RawInline(\"latex\",",
                    "\"\\\\begin{\" .. proof.env .. \"}\"))",
                    "if name ~= nil then",
                    "preamble.content:insert(pandoc.RawInline(\"latex\", \"[\"))",
                    "tappend(preamble.content, name)",
                    "preamble.content:insert(pandoc.RawInline(\"latex\", \"]\"))",
                    "end",
                    "el.content:insert(1, preamble)"
                ],
                "REPLACE": [
                    "        else",
                    "          -- see if this is a proof, remark, or solution",
                    "          local proof = proofType(el)",
                    "          if proof ~= nil then",
                    "",
                    "            -- ensure requisite latex is injected",
                    "            crossref.usingTheorems = true",
                    "",
                    "            if proof.env ~= \"proof\" then",
                    "              el.attr.classes:insert(\"proof\")",
                    "            end",
                    "",
                    "            -- capture then remove name",
                    "            local name = markdownToInlines(el.attr.attributes[\"name\"])",
                    "            if not name or #name == 0 then",
                    "              name = resolveHeadingCaption(el)",
                    "            end",
                    "            el.attr.attributes[\"name\"] = nil ",
                    "",
                    "            -- output",
                    "            if _quarto.format.isLatexOutput() then",
                    "              -- insert raw block for proof begin to avoid extra vspace",
                    "              local name_opt = \"\"",
                    "              if name ~= nil then",
                    "                name_opt = \"[\" .. pandoc.utils.stringify(name) .. \"]\"",
                    "              end",
                    "              el.content:insert(1,",
                    "                pandoc.RawBlock(\"latex\",",
                    "                  \"\\\\begin{\" .. proof.env .. \"}\" .. name_opt",
                    "                ))"
                ]
            },
            {
                "SEARCH": [
                    "el.content:insert(pandoc.Para(pandoc.RawInline(\"latex\",",
                    "\"\\\\end{\" .. proof.env .. \"}\"",
                    ")))",
                    "elseif _quarto.format.isJatsOutput() then"
                ],
                "REPLACE": [
                    "              el.content:insert(",
                    "                pandoc.RawBlock(\"latex\",",
                    "                  \"\\\\end{\" .. proof.env .. \"}\"",
                    "                ))",
                    "            elseif _quarto.format.isJatsOutput() then"
                ]
            }
        ]
    }
}