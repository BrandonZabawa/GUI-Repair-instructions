{
    "1/1": {
        "src/resources/filters/crossref/theorems.lua": [
            {
                "SEARCH": [
                    "-- If this theorem has no content, then create a placeholder",
                    "if #el.content == 0 then",
                    "el.content[1] = pandoc.Para({})",
                    "end",
                    "",
                    "-- prepend the prefix",
                    "local caption = el.content[1]",
                    "tprepend(caption.content, {",
                    "pandoc.Span(",
                    "pandoc.Strong(prefix),",
                    "pandoc.Attr(\"\", { \"theorem-title\" })",
                    ")",
                    "})"
                ],
                "REPLACE": [
                    "          -- If this theorem has no content, then create a placeholder",
                    "          if #el.content == 0 then",
                    "            el.content[1] = pandoc.Para({})",
                    "          end",
                    "",
                    "          -- prepend the prefix, inserting as its own paragraph",
                    "          local span = pandoc.Span(",
                    "            pandoc.Strong(prefix),",
                    "            pandoc.Attr(\"\", { \"theorem-title\" })",
                    "          )",
                    "          local first = el.content[1]",
                    "          if first.t == \"Para\" then",
                    "            -- normal case: paragraph caption, inject at front",
                    "            tprepend(first.content, { span })",
                    "          else",
                    "            -- special case: first block is a list (BulletList/OrderedList),",
                    "            -- so insert the caption paragraph before the list",
                    "            el.content:insert(1, pandoc.Para({ span }))",
                    "          end"
                ]
            }
        ]
    }
}