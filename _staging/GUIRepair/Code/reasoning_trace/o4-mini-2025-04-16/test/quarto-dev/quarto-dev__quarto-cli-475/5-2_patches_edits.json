{
    "1/1": {
        "src/resources/filters/quarto-pre/callout.lua": [
            {
                "SEARCH": [
                    "if calloutAppearance == kCalloutAppearanceDefault then",
                    "if caption == nil then",
                    "caption = displayName(type)",
                    "else",
                    "caption = pandoc.utils.stringify(caption)",
                    "end",
                    "callout = latexCalloutBoxDefault(caption, type, icon)"
                ],
                "REPLACE": [
                    "  if calloutAppearance == kCalloutAppearanceDefault then",
                    "    if caption == nil then",
                    "      caption = displayName(type)",
                    "    else",
                    "      -- render the caption AST back to LaTeX (preserving **bold** and `code`)",
                    "      caption = pandoc.write(pandoc.Pandoc({ pandoc.Para(caption) }), FORMAT)",
                    "    end",
                    "    callout = latexCalloutBoxDefault(caption, type, icon)"
                ]
            },
            {
                "SEARCH": [
                    "local options = {",
                    "colframe = frameColor,",
                    "colbacktitle = color ..'!10!white',",
                    "coltitle = 'black',",
                    "colback = 'white',",
                    "opacityback = 0,",
                    "opacitybacktitle =  0.6,",
                    "left = leftPad,",
                    "leftrule = leftBorderWidth,",
                    "toprule = borderWidth,",
                    "bottomrule = borderWidth,",
                    "rightrule = borderWidth,",
                    "arc = borderRadius,",
                    "title = caption,",
                    "titlerule = '0mm',",
                    "toptitle = '1mm',",
                    "bottomtitle = '1mm',",
                    "}"
                ],
                "REPLACE": [
                    "    local options = {",
                    "      colframe = frameColor,",
                    "      colbacktitle = color ..'!10!white',",
                    "      coltitle = 'black',",
                    "      colback = 'white',",
                    "      opacityback = 0,",
                    "      opacitybacktitle =  0.6,",
                    "      left = leftPad,",
                    "      leftrule = leftBorderWidth,",
                    "      toprule = borderWidth, ",
                    "      bottomrule = borderWidth,",
                    "      rightrule = borderWidth,",
                    "      arc = borderRadius,",
                    "      -- wrap in braces so commas, % etc. are not treated as tcolorbox options",
                    "      title = '{' .. caption .. '}',",
                    "      titlerule = '0mm',",
                    "      toptitle = '1mm',",
                    "      bottomtitle = '1mm',",
                    "    }"
                ]
            }
        ]
    }
}