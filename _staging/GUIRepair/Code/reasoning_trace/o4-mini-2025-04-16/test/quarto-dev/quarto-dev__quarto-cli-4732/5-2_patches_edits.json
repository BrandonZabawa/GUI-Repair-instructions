                "REPLACE": [
                    "const kHandlers: EmbedHandler[] = [",
                    "  {",
                    "    name: \"Jupyter Notebook Embed\",",
                    "    handle(",
                    "      filename: string,",
                    "      params: Record<string, unknown>,",
                    "      _handlerContext: LanguageCellHandlerContext,",
                    "    ) {",
                    "      const markdownFragments: EitherString[] = [];",
                    "",
                    "      // Resolve the filename into a path",
                    "      const notebookAddress = parseNotebookAddress(filename);",
                    "      if (notebookAddress) {",
                    "        const outputs = params.outputs as string | undefined;",
                    "        const placeHolder = notebookMarkdownPlaceholder(filename, {",
                    "          echo: params.echo !== undefined ? params.echo as boolean : false,",
                    "          warning: false,",
                    "          asis: true,",
                    "          eval: false,",
                    "        }, outputs);",
                    "",
                    "        markdownFragments.push(placeHolder);",
                    "        return Promise.resolve({",
                    "          handled: true,",
                    "          markdownFragments,",
                    "          resources: [",
                    "            notebookAddress.path,",
                    "          ],",
                    "        });",
                    "      } else {",
                    "        return Promise.resolve({",
                    "          handled: false,",
                    "          markdownFragments: [],",
                    "        });",
                    "      }",
                    "    },",
                    "  },",
                    "  {",
                    "    name: \"Local File Embed\",",
                    "    async handle(",
                    "      filename: string,",
                    "      params: Record<string, unknown>,",
                    "      handlerContext: LanguageCellHandlerContext,",
                    "    ) {",
                    "      // Read the local file from disk",
                    "      // handlerContext.resolvePath should turn relative names into a full path",
                    "      const path = handlerContext.resolvePath(filename);",
                    "      const text = await Deno.readTextFile(path);",
                    "",
                    "      // Optional language for the code fence",
                    "      const lang = (params.lang as string) || \"\";",
                    "      const fenceStart = \"```\" + lang + \"\\n\";",
                    "      const fenceEnd = \"\\n```\";",
                    "",
                    "      return {",
                    "        handled: true,",
                    "        // Emit a single fenced\u2010code fragment containing the file contents",
                    "        markdownFragments: [fenceStart + text + fenceEnd],",
                    "        // Allow resource\u2010tracking (e.g. for watching)",
                    "        resources: [path],",
                    "      };",
                    "    },",
                    "  },",
                    "];"
                ]
            }
        ]
