                "REPLACE": [
                    "export function joinUrl(baseUrl: string, path: string) {",
                    "  const baseHasSlash = baseUrl.endsWith(\"/\");",
                    "",
                    "  // normalize to forward-slashes",
                    "  path = pathWithForwardSlashes(path);",
                    "",
                    "  // percent-encode each segment so commas, colons, etc. become safe",
                    "  const encodedPath = path",
                    "    .split(\"/\")",
                    "    .map(segment => encodeURIComponent(segment))",
                    "    .join(\"/\");",
                    "",
                    "  const pathHasSlash = encodedPath.startsWith(\"/\");",
                    "",
                    "  let url: string;",
                    "  if (baseHasSlash && pathHasSlash) {",
                    "    url = `${baseUrl}${encodedPath.slice(1)}`;",
                    "  } else if (!baseHasSlash && !pathHasSlash) {",
                    "    url = `${baseUrl}/${encodedPath}`;",
                    "  } else {",
                    "    url = `${baseUrl}${encodedPath}`;",
                    "  }",
                    "",
                    "  return url;",
                    "}"
                ]
            }
        ]
