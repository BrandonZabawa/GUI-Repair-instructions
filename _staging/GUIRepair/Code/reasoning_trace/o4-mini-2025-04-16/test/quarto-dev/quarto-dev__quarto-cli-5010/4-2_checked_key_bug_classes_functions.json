            "function_code": [
                "export function ensureProtocolAndTrailingSlash(url: string) {",
                "  if (!url.startsWith(\"http\")) {",
                "    url = `https://${url}`;",
                "  }",
                "  url = ensureTrailingSlash(url);",
                "  return url;",
                "}"
            ]
        },
