{
    "1/1": {
        "components/index.js": [
            {
                "SEARCH": [
                    "var pathToLanguage = './prism-' + language;",
                    "delete require.cache[require.resolve(pathToLanguage)];",
                    "delete Prism.languages[language];",
                    "require(pathToLanguage);"
                ],
                "REPLACE": [
                    "// Support \u201cgcode\u201d \u2192 \u201creprap_gcode\u201d aliasing",
                    "var normalizedLang = language === 'gcode' ? 'reprap_gcode' : language;",
                    "var pathToLanguage    = './prism-' + normalizedLang;",
                    "delete require.cache[require.resolve(pathToLanguage)];",
                    "delete Prism.languages[language];",
                    "require(pathToLanguage);",
                    "// If the user asked for \u201cgcode\u201d, copy the loaded reprap_gcode grammar",
                    "if (language === 'gcode' && Prism.languages.reprap_gcode) {",
                    "Prism.languages.gcode = Prism.languages.reprap_gcode;",
                    "}"
                ]
            }
        ]
    },
