+'strike': {
+// ~~strike through~~
+// ~strike~
+pattern: createInline(/(~~?)(?:(?!~)<inner>)+?\2/.source),
+lookbehind: true,
+greedy: true,
+inside: {
+'content': {
+pattern: /(^~~?)[\s\S]+(?=\1$)/,
+lookbehind: true,
+inside: {} // see below
+},
+'punctuation': /~~?/
+}
+},
+
+// Insert a dedicated image token before the general link token.
+'image': {
+// ![alt](url "Optional title")
+pattern: createInline(/!\[(?:(?!\])<inner>)+\]\((?:\S+|<(?:\\.|[^>\\])+>)(?:[ \t]+(?:"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'|\((?:\\.|[^)\\])*\))?)\)/.source),
+lookbehind: true,
+greedy: true,
+inside: {
+// alt text between ![ and ]
+'alt': {
+pattern: /(^!\[)[^\]]+(?=\]\()/,
+lookbehind: true
+},
+// src URL between ( and )
+'src': {
+pattern: /(\()\S+(?=\))/,
+lookbehind: true
+},
+// optional title in quotes or parens
+'title': {
+pattern: /(?:"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'|\((?:\\.|[^)\\])*\))(?=\))/,
+},
+'punctuation': /!\[|\]\(|\)/
+}
+},
