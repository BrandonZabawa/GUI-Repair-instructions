{
    "1/1": {
        "components/prism-fsharp.js": [
            {
                "SEARCH": [
                    "Prism.languages.insertBefore('fsharp', 'keyword', {",
                    "'preprocessor': {",
                    "pattern: /^[^\\r\\n\\S]*#.*/m,",
                    "alias: 'property',",
                    "inside: {",
                    "'directive': {",
                    "pattern: /(\\s*#)\\b(?:else|endif|if|light|line|nowarn)\\b/,",
                    "lookbehind: true,",
                    "alias: 'keyword'",
                    "}",
                    "}",
                    "}",
                    "});"
                ],
                "REPLACE": [
                    "Prism.languages.insertBefore('fsharp', 'keyword', {",
                    "'preprocessor': {",
                    "pattern: /^[^\\r\\n\\S]*#.*/m,",
                    "alias: 'property',",
                    "inside: {",
                    "'directive': {",
                    "pattern: /(\\s*#)\\b(?:else|endif|if|light|line|nowarn)\\b/,",
                    "lookbehind: true,",
                    "alias: 'keyword'",
                    "}",
                    "}",
                    "}",
                    "});",
                    "// Highlight F# type annotations (e.g. \": int\" or \"(x: MyType)\")",
                    "Prism.languages.insertBefore('fsharp', 'operator', {",
                    "'type-annotation': {",
                    "// match either an identifier or a closing paren, then colon and a type name (possibly namespaced)",
                    "pattern: /(\\b\\w+|\\))\\s*:\\s*[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*/,",
                    "lookbehind: true,",
                    "inside: {",
                    "'punctuation': /:/,",
                    "'type': /\\b[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*\\b/",
                    "}",
                    "}",
                    "});"
                ]
            }
        ]
    },
