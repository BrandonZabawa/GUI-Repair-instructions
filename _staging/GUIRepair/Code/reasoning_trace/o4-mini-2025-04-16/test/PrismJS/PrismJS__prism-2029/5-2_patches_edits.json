                    "/`[^`]*`[cwd]?/,",
                    "// Double\u2010quoted (and any remaining backtick) strings",
                    "/([\"`])(?:\\\\[\\s\\S]|(?!\\1)[^\\\\])*\\1[cwd]?/"
                ]
            }
        ]
