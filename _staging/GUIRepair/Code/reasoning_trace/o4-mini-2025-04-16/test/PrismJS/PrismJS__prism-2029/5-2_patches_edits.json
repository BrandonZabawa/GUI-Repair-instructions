{
    "1/1": {
        "components/prism-d.js": [
            {
                "SEARCH": [
                    "// Characters",
                    "/'(?:\\\\'|\\\\?[^']+)'/,",
                    "/([\"`])(?:\\\\[\\s\\S]|(?!\\1)[^\\\\])*\\\\1[cwd]?/"
                ],
                "REPLACE": [
                    "// Characters",
                    "/'(?:\\\\'|\\\\?[^']+)'/,",
