                ],
                "REPLACE": [
                    "Prism.languages.insertBefore('inside', 'attr-name', {",
                    "'spread': {",
                    "// Support both simple and nested object spread: {...foo} and {...{ foo, bar }}",
                    "pattern: /\\{\\s*\\.\\.\\.\\s*(?:\\{[^}]*\\}|[a-z_$][\\w$]*(?:\\.[a-z_$][\\w$]*)*)\\s*\\}/,",
                    "inside: {",
                    "'punctuation': /\\.{3}|[{}.]/,",
                    "// match everything up to the closing brace (identifiers, commas, spaces, etc.)",
                    "'attr-value': /[^}]+/",
                    "}",
                    "}",
                    "}, Prism.languages.jsx.tag);"
                ]
            }
