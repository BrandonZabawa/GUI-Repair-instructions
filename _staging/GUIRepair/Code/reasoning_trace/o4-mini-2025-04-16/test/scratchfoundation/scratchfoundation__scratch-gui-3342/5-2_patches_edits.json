                    "const BlocksComponent = props => {",
                    "    const {",
                    "        componentRef,",
                    "        watermarkUrl,",
                    "        ...componentProps",
                    "    } = props;",
                    "    // Make the blocks container relative so we can absolutely position the watermark",
                    "    return (",
                    "        <Box",
                    "            className={styles.blocks}",
                    "            componentRef={componentRef}",
                    "            style={{position: 'relative'}}",
                    "            {...componentProps}",
                    "        >",
                    "            {/*",
                    "                If we have a watermarkUrl, render the invisible (pointerEvents:none) img",
                    "                20px from the top, flush right to the zoom controls, 48\u00d748px max, 35% opacity.",
                    "            */}",
                    "            {watermarkUrl && (",
                    "                <img",
                    "                    src={watermarkUrl}",
                    "                    alt=\"\"",
                    "                    style={{",
                    "                        position: 'absolute',",
                    "                        top: '20px',",
                    "                        right: '20px',",
                    "                        width: '48px',",
                    "                        height: '48px',",
                    "                        maxWidth: '48px',",
                    "                        maxHeight: '48px',",
                    "                        opacity: 0.35,",
                    "                        pointerEvents: 'none',",
                    "                        zIndex: 0",
                    "                    }}",
                    "                />",
                    "            )}",
                    "        </Box>",
                    "    );",
                    "};"
                ]
            }
        ],
