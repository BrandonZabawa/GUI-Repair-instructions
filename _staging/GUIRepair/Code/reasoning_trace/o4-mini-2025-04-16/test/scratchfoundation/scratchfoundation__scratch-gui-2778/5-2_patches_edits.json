{
    "1/1": {
        "package.json": [
            {
                "SEARCH": [
                    "\"devDependencies\": {",
                    "\"arraybuffer-loader\": \"^1.0.3\",",
                    "\"autoprefixer\": \"^8.1.0\",",
                    "\"babel-core\": \"^6.23.1\","
                ],
                "REPLACE": [
                    "  \"devDependencies\": {",
                    "    \"arraybuffer-loader\": \"^1.0.3\",",
                    "    \"autoprefixer\": \"^9.0.0\",",
                    "    \"babel-core\": \"^6.23.1\","
                ]
            }
        ],
        "webpack.config.js": [
            {
                "SEARCH": [
                    "{",
                    "loader: 'postcss-loader',",
                    "options: {",
                    "ident: 'postcss',",
                    "plugins: function () {",
                    "return [",
                    "postcssImport,",
                    "postcssVars,",
                    "autoprefixer({",
                    "browsers: ['last 3 versions', 'Safari >= 8', 'iOS >= 8']",
                    "})",
                    "];",
                    "}",
                    "}",
                    "}"
                ],
                "REPLACE": [
                    "            {",
                    "                loader: 'postcss-loader',",
                    "                options: {",
                    "                    ident: 'postcss',",
                    "                    plugins: function () {",
                    "                        return [",
                    "                            postcssImport,",
                    "                            postcssVars,",
                    "                            autoprefixer({",
                    "                                overrideBrowserslist: ['last 3 versions', 'Safari >= 8', 'iOS >= 8']",
                    "                            })",
                    "                        ];",
                    "                    }",
                    "                }",
                    "            }"
                ]
            }
        ]
    }
}