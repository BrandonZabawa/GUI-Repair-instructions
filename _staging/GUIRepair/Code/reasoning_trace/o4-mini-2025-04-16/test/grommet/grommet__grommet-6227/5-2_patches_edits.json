                "REPLACE": [
                    "      useEffect(() => {",
                    "        const index = requiredFields.current.indexOf(name);",
                    "        if (required) {",
                    "          if (index === -1) requiredFields.current.push(name);",
                    "        } else if (index !== -1) requiredFields.current.splice(index, 1);",
                    "",
                    "        if (validateArg || required) {",
                    "          if (!validationRulesRef.current[name]) {",
                    "            validationRulesRef.current[name] = {};",
                    "          }",
                    "          validationRulesRef.current[name].field = validateName(",
                    "            validateArg,",
                    "            required,",
                    "          );",
                    "          // When this field unmounts, clean up both validation rules",
                    "          // and the required list so it no longer blocks form validity.",
                    "          return () => {",
                    "            // remove this field's validation entry",
                    "            delete validationRulesRef.current[name].field;",
                    "            // if there are no more rules for this name, remove the object",
                    "            if (",
                    "              !validationRulesRef.current[name] ||",
                    "              Object.keys(validationRulesRef.current[name]).length === 0",
                    "            ) {",
                    "              delete validationRulesRef.current[name];",
                    "            }",
                    "            // also remove from the requiredFields list",
                    "            const idx = requiredFields.current.indexOf(name);",
                    "            if (idx !== -1) {",
                    "              requiredFields.current.splice(idx, 1);",
                    "            }",
                    "          };",
                    "        }",
                    "",
                    "        return undefined;",
                    "      }, [error, name, required, validateArg, disabled]);"
                ]
            }
        ]
    }
