{
    "1/1": {
        "lighthouse-core/formatters/table.js": [
            {
                "SEARCH": [
                    "case 'code':",
                    "return '`' + value.trim() + '`';",
                    "case 'pre':",
                    "return '```' + '\\n' + result[key].trim() + '```';"
                ],
                "REPLACE": [
                    "          case 'code': {",
                    "            const trimmed = value.trim();",
                    "            // If the string already starts with a back\u2010tick, return raw.",
                    "            if (trimmed.startsWith('`')) {",
                    "              return trimmed;",
                    "            }",
                    "            // Otherwise wrap in inline\u2010code ticks.",
                    "            return '`' + trimmed + '`';",
                    "          }",
                    "          case 'pre':",
                    "            return '```' + '\\n' + result[key].trim() + '```';"
                ]
            }
        ]
    }
}