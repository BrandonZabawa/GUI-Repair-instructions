{
    "1/1": {
        "lighthouse-core/lib/dependency-graph/network-node.js": [
            {
                "SEARCH": [
                    "/**",
                    "* @return {boolean}",
                    "*/",
                    "hasRenderBlockingPriority() {",
                    "const priority = this._record.priority();",
                    "const isScript = this._record._resourceType === WebInspector.resourceTypes.Script;",
                    "return priority === 'VeryHigh' || (priority === 'High' && isScript);",
                    "}"
                ],
                "REPLACE": [
                    "  /** ",
                    "   * @return {boolean} ",
                    "   */ ",
                    "  hasRenderBlockingPriority() { ",
                    "    const priority = this._record.priority(); ",
                    "    const isScript = this._record._resourceType === WebInspector.resourceTypes.Script; ",
                    "    // If the request was kicked off by a <link rel=\"preload\">, it should not",
                    "    // contribute to the \"critical request chain\" even though it may load at High priority.",
                    "    const isPreload = this._record._initiator && this._record._initiator.type === 'preload'; ",
                    "    return !isPreload && (priority === 'VeryHigh' || (priority === 'High' && isScript)); ",
                    "  }"
                ]
            }
        ]
    }
}