                "REPLACE": [
                    "  static isCritical(request) {",
                    "    const resourceTypeCategory = request._resourceType && request._resourceType._category;",
                    "",
                    "    // Exclude iframes (they're not render-blocking)",
                    "    if (resourceTypeCategory === 'iframe') {",
                    "      return false;",
                    "    }",
                    "",
                    "    // Exclude data URIs entirely (not real network requests)",
                    "    if (request.url && request.url.startsWith('data:')) {",
                    "      return false;",
                    "    }",
                    "",
                    "    // XHRs are fetched at High priority, but we exclude them, as they are unlikely to be critical"
                ]
            }
        ]
