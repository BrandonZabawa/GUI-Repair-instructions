            {
                "SEARCH": [
                    "static isCritical(request) {",
                    "const resourceTypeCategory = request._resourceType && request._resourceType._category;",
                    "",
                    "// XHRs are fetched at High priority, but we exclude them, as they are unlikely to be critical"
