diff --git a/lighthouse-core/computed/load-simulator.js b/lighthouse-core/computed/load-simulator.js
index af34f9d1d..6a41d63a3 100644
--- a/lighthouse-core/computed/load-simulator.js
+++ b/lighthouse-core/computed/load-simulator.js
@@ -58,7 +58,10 @@ class LoadSimulator {
         if (throttling) {
           options.rtt = throttling.rttMs;
           options.throughput = throttling.throughputKbps * 1024;
+          // Lantern: account for both CPU and layout slowdown so simulated tasks
