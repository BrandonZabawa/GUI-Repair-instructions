{
    "1/1": {
        "lighthouse-core/report/v2/renderer/report-renderer.js": [
            {
                "SEARCH": [
                    "report.runtimeConfig.environment.forEach(runtime => {",
                    "const item = this._dom.cloneTemplate('#tmpl-lh-env__items', env);",
                    "this._dom.find('.lh-env__name', item).textContent = runtime.name;",
                    "this._dom.find('.lh-env__description', item).textContent = runtime.description;",
                    "this._dom.find('.lh-env__enabled', item).textContent =",
                    "runtime.enabled ? 'Enabled' : 'Disabled';",
                    "env.appendChild(item);",
                    "});",
                    "",
                    "return header;"
                ],
                "REPLACE": [
                    "    report.runtimeConfig.environment.forEach(runtime => {",
                    "      const item = this._dom.cloneTemplate('#tmpl-lh-env__items', env);",
                    "      this._dom.find('.lh-env__name', item).textContent = runtime.name;",
                    "      this._dom.find('.lh-env__description', item).textContent = runtime.description;",
                    "      this._dom.find('.lh-env__enabled', item).textContent =",
                    "          runtime.enabled ? 'Enabled' : 'Disabled';",
                    "      env.appendChild(item);",
                    "    });",
                    "",
                    "    // If the JSON came back with runtimeWarnings (e.g. headless\u2010Chrome network throttling),",
                    "    // render each warning as a banner note right under the header.",
                    "    if (report.runtimeWarnings && report.runtimeWarnings.length) {",
                    "      report.runtimeWarnings.forEach(warning => {",
                    "        const warningEl = this._dom.createElement('div', 'lh-note');",
                    "        warningEl.textContent = warning;",
                    "        header.appendChild(warningEl);",
                    "      });",
                    "    }",
                    "",
                    "    return header;"
                ]
            }
        ]
    }
}