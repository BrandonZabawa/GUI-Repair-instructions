{
    "1/1": {
        "lighthouse-core/audits/user-timings.js": [
            {
                "SEARCH": [
                    "tabTrace.processEvents.filter(evt => {",
                    "if (!evt.cat.includes('blink.user_timing')) {",
                    "return false;",
                    "}"
                ],
                "REPLACE": [
                    "    tabTrace.processEvents.filter(evt => {",
                    "      if (!evt.cat.includes('blink.user_timing')) {",
                    "        return false;",
                    "      }",
                    "      // ignore injected ad/goog userTiming marks/measures",
                    "      if (evt.name.startsWith('ad_') || evt.name.startsWith('goog_')) {",
                    "        return false;",
                    "      }"
                ]
            }
        ]
    }
}