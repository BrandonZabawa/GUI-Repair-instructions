                    "",
                    "function printRuntimeErrorAndExit(err) {",
                    "  let messageToPrint = err.message;",
                    "",
                    "  // if we stashed a raw template, now is the time to format it once the i18n data is loaded",
                    "  if (err._rawMessageTemplate) {",
                    "    try {",
                    "      messageToPrint = str_(",
                    "        err._rawMessageTemplate,",
                    "        err._rawMessageValues || {}",
                    "      );",
                    "    } catch (e) {",
                    "      // fallback to the code if something went wrong",
                    "      messageToPrint = err.message;",
                    "    }",
                    "  }",
                    "",
                    "  console.error('Runtime error encountered:', messageToPrint);",
                    "  if (err.stack) {",
