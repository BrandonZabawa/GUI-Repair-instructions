{
    "1/1": {
        "core/audits/dobetterweb/dom-size.js": [
            {
                "SEARCH": [
                    "/** @type {LH.Audit.Details.Table['headings']} */",
                    "const headings = [",
                    "{key: 'statistic', valueType: 'text', label: str_(UIStrings.columnStatistic)},",
                    "{key: 'node',      valueType: 'node', label: str_(i18n.UIStrings.columnElement)},",
                    "{key: 'value',     valueType: 'numeric', label: str_(UIStrings.columnValue)},",
                    "];"
                ],
                "REPLACE": [
                    "    /** @type {LH.Audit.Details.Table['headings']} */",
                    "    const headings = [",
                    "      {key: 'statistic',  valueType: 'text', label: str_(UIStrings.columnStatistic)},",
                    "      {key: 'node',       valueType: 'node', label: str_(i18n.UIStrings.columnElement)},",
                    "      // Switch value column to text so we can render an integer string",
                    "      {key: 'value',      valueType: 'text', label: str_(UIStrings.columnValue)},",
                    "    ];"
                ]
            },
            {
                "SEARCH": [
                    "/** @type {LH.Audit.Details.Table['items']} */",
                    "const items = [",
                    "{",
                    "statistic: str_(UIStrings.statisticDOMElements),",
                    "value: stats.totalBodyElements,",
                    "},",
                    "{",
                    "node: Audit.makeNodeItem(stats.depth),",
                    "statistic: str_(UIStrings.statisticDOMDepth),",
                    "value: stats.depth.max,",
                    "},",
                    "{",
                    "node: Audit.makeNodeItem(stats.width),",
                    "statistic: str_(UIStrings.statisticDOMWidth),",
                    "value: stats.width.max,",
                    "},",
                    "];"
                ],
                "REPLACE": [
                    "    /** @type {LH.Audit.Details.Table['items']} */",
                    "    const items = [",
                    "      {",
                    "        statistic: str_(UIStrings.statisticDOMElements),",
                    "        value: stats.totalBodyElements,",
                    "        // Show as integer with grouping, no \".0\"",
                    "        displayValue: stats.totalBodyElements.toLocaleString(),",
                    "      },",
                    "      {",
                    "        node: Audit.makeNodeItem(stats.depth),",
                    "        statistic: str_(UIStrings.statisticDOMDepth),",
                    "        value: stats.depth.max,",
                    "        displayValue: stats.depth.max.toLocaleString(),",
                    "      },",
                    "      {",
                    "        node: Audit.makeNodeItem(stats.width),",
                    "        statistic: str_(UIStrings.statisticDOMWidth),",
                    "        value: stats.width.max,",
                    "        displayValue: stats.width.max.toLocaleString(),",
                    "      },",
                    "    ];"
                ]
            }
        ]
    }
}