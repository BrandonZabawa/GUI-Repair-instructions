{
    "1/1": {
        "lighthouse-core/report/html/renderer/details-renderer.js": [
            {
                "SEARCH": [
                    "_renderBytes(details) {",
                    "// TODO: handle displayUnit once we have something other than 'kb'",
                    "// Note that 'kb' is historical and actually represents KiB.",
                    "const value = Util.i18n.formatBytesToKiB(details.value, details.granularity);",
                    "const textEl = this._renderText(value);",
                    "textEl.title = Util.i18n.formatBytes(details.value);",
                    "return textEl;",
                    "}"
                ],
                "REPLACE": [
                    "  _renderBytes(details) {",
                    "    // TODO: handle displayUnit once we have something other than 'kb'",
                    "    // Note that 'kb' is historical and actually represents KiB.",
                    "    // Always show one decimal digit (e.g. \"18.0 KiB\") for better column alignment.",
                    "    let value = Util.i18n.formatBytesToKiB(details.value, details.granularity);",
                    "    // If it\u2019s an integer KiB (no \".\"), append \".0\"",
                    "    if (/^\\d+\\s*KiB$/.test(value)) {",
                    "      value = value.replace(/(\\d+)\\s*KiB$/, '$1.0 KiB');",
                    "    }",
                    "    const textEl = this._renderText(value);",
                    "    textEl.title = Util.i18n.formatBytes(details.value);",
                    "    return textEl;",
                    "  }"
                ]
            }
        ]
    }
}