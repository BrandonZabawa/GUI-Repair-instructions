{
    "1/1": {
        "lighthouse-core/report/v2/report-generator.js": [
            {
                "SEARCH": [
                    "/**",
                    "* @param {!Object} reportAsJson",
                    "* @return {string}",
                    "*/",
                    "generateReportHtml(reportAsJson) {",
                    "const sanitizedJson = JSON.stringify(reportAsJson).replace(/</g, '\\\\u003c');",
                    "const sanitizedJavascript = REPORT_JAVASCRIPT.replace(/<\\//g, '\\\\u003c/');"
                ],
                "REPLACE": [
                    "  /** ",
                    "   * @param {!Object} reportAsJson",
                    "   * @return {string}",
                    "   */",
                    "  generateReportHtml(reportAsJson) {",
                    "    // Escape `<` so we don't break out of the <script> tag,",
                    "    // then also escape Unicode 2028/2029 which JS treats as real line breaks.",
                    "    const sanitizedJson = JSON.stringify(reportAsJson)",
                    "        .replace(/</g, '\\\\u003c')",
                    "        .replace(/\\u2028/g, '\\\\u2028')",
                    "        .replace(/\\u2029/g, '\\\\u2029');",
                    "    const sanitizedJavascript = REPORT_JAVASCRIPT.replace(/<\\//g, '\\\\u003c/');"
                ]
            }
        ]
    }
}