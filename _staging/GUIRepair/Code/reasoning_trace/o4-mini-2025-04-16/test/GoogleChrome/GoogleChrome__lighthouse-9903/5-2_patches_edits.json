{
    "1/1": {
        "lighthouse-core/audits/uses-rel-preconnect.js": [
            {
                "SEARCH": [
                    "// all the <link rel=preconnect> hints on the page",
                    "const preconnectLinks = artifacts.LinkElements.filter(el => el.rel === 'preconnect');",
                    "const preconnectOrigins = new Set(preconnectLinks.map(link => URL.getOrigin(link.href || '')));"
                ],
                "REPLACE": [
                    "    // all the <link rel=preconnect> or <link rel=dns-prefetch> hints on the page",
                    "    const preconnectLinks = artifacts.LinkElements.filter(",
                    "      el => el.rel === 'preconnect' || el.rel === 'dns-prefetch'",
                    "    );",
                    "    const preconnectOrigins = new Set(preconnectLinks.map(link => URL.getOrigin(link.href || '')));"
                ]
            },
            {
                "SEARCH": [
                    "results = results",
                    ".sort((a, b) => b.wastedMs - a.wastedMs);"
                ],
                "REPLACE": [
                    "    // sort descending by potential savings, then only keep the top 6 origins",
                    "    results = results",
                    "      .sort((a, b) => b.wastedMs - a.wastedMs)",
                    "      .slice(0, 6);"
                ]
            }
        ]
    }
}