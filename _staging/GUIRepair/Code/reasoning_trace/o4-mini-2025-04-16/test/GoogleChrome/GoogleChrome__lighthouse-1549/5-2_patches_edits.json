    "1/1": {
        "lighthouse-core/audits/user-timings.js": [
            {
                "SEARCH": [
                    "userTimings.forEach(ut => {",
                    "ut.startTime -= navigationStartTime;",
                    "if (!ut.isMark) {",
                    "ut.endTime -= navigationStartTime;",
                    "ut.duration = ut.duration;",
                    "}",
                    "});"
                ],
                "REPLACE": [
                    "  userTimings.forEach(ut => {",
                    "    // Clamp the offset so nothing appears before 0ms",
                    "    ut.startTime = Math.max(0, ut.startTime - navigationStartTime);",
                    "    if (!ut.isMark) {",
                    "      ut.endTime = Math.max(0, ut.endTime - navigationStartTime);",
                    "      // duration remains the same, since subtracting nav start",
                    "    }",
                    "  });"
                ]
            }
        ]
    }
}