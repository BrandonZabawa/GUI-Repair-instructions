{
    "1/1": {
        "lighthouse-core/audits/byte-efficiency/offscreen-images.js": [
            {
                "SEARCH": [
                    "if (!image.networkRecord) {",
                    "return results;",
                    "}",
                    "",
                    "const processed = OffscreenImages.computeWaste(image, viewportDimensions);"
                ],
                "REPLACE": [
                    "      if (!image.networkRecord) {",
                    "        return results;",
                    "      }",
                    "",
                    "      // Ignore SVG images entirely (they often report zero width/height)",
                    "      if (image.networkRecord.mimeType === 'image/svg+xml') {",
                    "        return results;",
                    "      }",
                    "",
                    "      const processed = OffscreenImages.computeWaste(image, viewportDimensions);"
                ]
            }
        ]
    }
}