{
    "1/1": {
        "lighthouse-core/lib/dependency-graph/simulator/connection-pool.js": [
            {
                "SEARCH": [
                    "for (const [origin, records] of recordsByOrigin.entries()) {",
                    "const connections = [];",
                    "const additionalRtt = additionalRttByOrigin.get(origin) || 0;",
                    "const responseTime = serverResponseTimeByOrigin.get(origin) || DEFAULT_SERVER_RESPONSE_TIME;"
                ],
                "REPLACE": [
                    "    for (const [origin, records] of recordsByOrigin.entries()) {",
                    "      const connections = [];",
                    "      const additionalRtt = additionalRttByOrigin.get(origin) || 0;",
                    "      // Data URIs are local and should never incur any server response latency.",
                    "      const isDataUri = records[0].parsedURL.scheme === 'data';",
                    "      const responseTime = isDataUri",
                    "        ? 0",
                    "        : (serverResponseTimeByOrigin.get(origin) || DEFAULT_SERVER_RESPONSE_TIME);"
                ]
            }
        ]
    }
}