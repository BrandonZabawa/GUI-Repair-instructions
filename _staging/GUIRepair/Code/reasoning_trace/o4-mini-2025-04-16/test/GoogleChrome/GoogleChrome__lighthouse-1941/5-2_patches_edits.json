{
    "1/1": {
        "lighthouse-core/report/v2/report-generator.js": [
            {
                "SEARCH": [
                    "generateReportHtml(reportAsJson) {",
                    "const sanitizedJson = JSON.stringify(reportAsJson).replace(/</g, '\\\\u003c');",
                    "const sanitizedJavascript = REPORT_JAVASCRIPT.replace(/<\\\\//g, '\\\\u003c/');",
                    "return REPORT_TEMPLATE",
                    ".replace(/%%LIGHTHOUSE_JSON%%/, sanitizedJson)",
                    ".replace(/%%LIGHTHOUSE_JAVASCRIPT%%/, sanitizedJavascript);",
                    "}"
                ],
                "REPLACE": [
                    "  generateReportHtml(reportAsJson) {",
                    "    const sanitizedJson = JSON.stringify(reportAsJson).replace(/</g, '\\\\u003c');",
                    "    const sanitizedJavascript = REPORT_JAVASCRIPT",
                    "      .replace(/<\\\\//g, '\\\\u003c/')",
                    "      // Escape every '$' so that when this string is used",
                    "      // as the replacement text, no '$' sequences are treated",
                    "      // as special tokens (eg. $', $&, etc).",
                    "      .replace(/\\$/g, '$$$$');",
                    "    return REPORT_TEMPLATE",
                    "      .replace(/%%LIGHTHOUSE_JSON%%/, sanitizedJson)",
                    "      .replace(/%%LIGHTHOUSE_JAVASCRIPT%%/, sanitizedJavascript);",
                    "  }"
                ]
            }
        ]
    }
}