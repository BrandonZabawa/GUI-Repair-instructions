                "REPLACE": [
                    "    // And get all its listeners of interest in the default context.",
                    "    const {listeners: defaultListeners} =",
                    "      await session.sendCommand('DOMDebugger.getEventListeners', {objectId});",
                    "    const filteredDefault = defaultListeners",
                    "      .filter(GlobalListeners._filterForAllowlistedTypes)",
                    "      .map(listener => {",
                    "        const {type, scriptId, lineNumber, columnNumber} = listener;",
                    "        return {type, scriptId, lineNumber, columnNumber};",
                    "      });",
                    "",
                    "    // Also collect listeners from the isolated execution context (e.g. extensions/content scripts).",
                    "    const executionContext = passContext.driver.executionContext;",
                    "    // Create or retrieve the isolated context for the main frame.",
                    "    const isolatedContextId = await executionContext._getOrCreateIsolatedContextId();",
                    "",
                    "    // Get a handle to `window` in that isolated context.",
                    "    const {result: {objectId: isolatedObjectId}} =",
                    "      await session.sendCommand('Runtime.evaluate', {",
                    "        expression: 'window',",
                    "        returnByValue: false,",
                    "        contextId: isolatedContextId,",
                    "      });",
                    "",
                    "    // Fetch its event listeners as well.",
                    "    const {listeners: isolatedListeners} =",
                    "      await session.sendCommand('DOMDebugger.getEventListeners', {objectId: isolatedObjectId});",
                    "    const filteredIsolated = isolatedListeners",
                    "      .filter(GlobalListeners._filterForAllowlistedTypes)",
                    "      .map(listener => {",
                    "        const {type, scriptId, lineNumber, columnNumber} = listener;",
                    "        return {type, scriptId, lineNumber, columnNumber};",
                    "      });",
                    "",
                    "    // Merge and dedupe listeners from both contexts.",
                    "    const allListeners = filteredDefault.concat(filteredIsolated);",
                    "    return this.dedupeListeners(allListeners);"
                ]
            }
        ]
    }
