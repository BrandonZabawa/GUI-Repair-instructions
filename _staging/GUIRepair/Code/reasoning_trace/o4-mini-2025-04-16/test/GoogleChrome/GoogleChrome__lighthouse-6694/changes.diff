+    // Gather any <link rel="preconnect"> or <link rel="dns-prefetch"> hints from the HTML
+    const linkElements = artifacts.LinkElements || [];
+    const preconnectedOrigins = new Set(
+      linkElements
+        .filter(el =>
+          // el.rel might be a string or array of strings
+          el.rel === 'preconnect' ||
+          el.rel === 'dns-prefetch' ||
+          (Array.isArray(el.rel) &&
+            (el.rel.includes('preconnect') || el.rel.includes('dns-prefetch')))
+        )
+        .map(el => {
+          try {
+            return new URL(el.href).origin;
+          } catch (_) {
+            return null;
+          }
+        })
+        .filter(origin => origin)
+    );
