        "lighthouse-core/report/html/renderer/category-renderer.js": [
            {
                "SEARCH": [
                    "// Render each clump.",
                    "for (const [clumpId, auditRefs] of clumps) {",
                    "if (auditRefs.length === 0) continue;",
                    "",
                    "if (clumpId === 'failed') {",
                    "const clumpElem = this.renderUnexpandableClump(auditRefs, groupDefinitions);",
                    "clumpElem.classList.add(`lh-clump--failed`);",
                    "element.appendChild(clumpElem);",
                    "continue;",
                    "}",
                    "",
                    "const description = clumpId === 'manual'",
                    "? category.manualDescription",
                    ": undefined;",
                    "const clumpElem = this.renderClump(clumpId, {auditRefs, description});",
                    "element.appendChild(clumpElem);"
                ],
                "REPLACE": [
                    "      // Render each clump.",
                    "      for (const [clumpId, auditRefs] of clumps) {",
                    "        if (auditRefs.length === 0) continue;",
                    "",
                    "        if (clumpId === 'failed') {",
                    "          const clumpElem = this.renderUnexpandableClump(auditRefs, groupDefinitions);",
                    "          clumpElem.classList.add(`lh-clump--failed`);",
                    "          element.appendChild(clumpElem);",
                    "          continue;",
                    "        }",
                    "",
                    "        const description = clumpId === 'manual'",
                    "          ? category.manualDescription",
                    "          : undefined;",
                    "        const clumpElem = this.renderClump(clumpId, {auditRefs, description});",
                    "        element.appendChild(clumpElem);",
                    "",
                    "        // After the passed audits clump, render a consolidated warnings block.",
                    "        if (clumpId === 'passed') {",
                    "          // Gather all warning messages from the passed audits",
                    "          const allWarnings = [];",
                    "          for (const auditRef of auditRefs) {",
                    "            if (Array.isArray(auditRef.result.warnings) && auditRef.result.warnings.length) {",
                    "              allWarnings.push(...auditRef.result.warnings);",
                    "            }",
                    "          }",
                    "",
                    "          if (allWarnings.length > 0) {",
                    "            // Build the warnings container",
                    "            const warningsEl = this.dom.createElement('div', 'lh-warnings');",
                    "            // Add the heading (\"Warnings:\")",
                    "            warningsEl.textContent = Util.UIStrings.warningHeader;",
                    "            // Create a UL and append each warning as an <li>",
                    "            const warningsUl = this.dom.createChildOf(warningsEl, 'ul');",
                    "            for (const warning of allWarnings) {",
                    "              const li = this.dom.createChildOf(warningsUl, 'li');",
                    "              li.textContent = warning;",
                    "            }",
                    "            // Append the block right after the passed clump",
                    "            element.appendChild(warningsEl);",
                    "          }",
                    "        }"
                ]
            }
        ]
    }
}