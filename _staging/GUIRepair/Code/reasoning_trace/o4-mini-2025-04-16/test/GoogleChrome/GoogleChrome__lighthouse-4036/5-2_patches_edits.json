        "lighthouse-core/audits/dobetterweb/external-anchors-use-rel-noopener.js": [
            {
                "SEARCH": [
                    ".filter(anchor => {",
                    "// Ignore href's that are not real links",
                    "return !anchor.href || !anchor.href.toLowerCase().startsWith('javascript:');",
                    "})"
                ],
                "REPLACE": [
                    "      .filter(anchor => {",
                    "        // Ignore href's that are not real links (javascript: and mailto:)",
                    "        if (!anchor.href) {",
                    "          return true;",
                    "        }",
                    "        const lcHref = anchor.href.toLowerCase();",
                    "        return !(lcHref.startsWith('javascript:') || lcHref.startsWith('mailto:'));",
                    "      })"
                ]
            }
        ]
    }
}