{
    "1/1": {
        "src/ol/render/canvas/Executor.js": [
            {
                "SEARCH": [
                    "case CanvasInstruction.CIRCLE:",
                    "d = /** @type {number} */ (instruction[1]);",
                    "const x1 = pixelCoordinates[d];",
                    "const y1 = pixelCoordinates[d + 1];",
                    "const x2 = pixelCoordinates[d + 2];",
                    "const y2 = pixelCoordinates[d + 3];",
                    "const dx = x2 - x1;",
                    "const dy = y2 - y1;",
                    "const r = Math.sqrt(dx * dx + dy * dy);",
                    "context.moveTo(x1 + r, y1);",
                    "context.arc(x1, y1, r, 0, 2 * Math.PI, true);",
                    "++i;",
                    "break;"
                ],
                "REPLACE": [
                    "        case CanvasInstruction.CIRCLE:",
                    "          d = /** @type {number} */ (instruction[1]);",
                    "          const x1orig = pixelCoordinates[d];",
                    "          const y1orig = pixelCoordinates[d + 1];",
                    "          const x2 = pixelCoordinates[d + 2];",
                    "          const y2 = pixelCoordinates[d + 3];",
                    "          const dx = x2 - x1orig;",
                    "          const dy = y2 - y1orig;",
                    "          const rOrig = Math.sqrt(dx * dx + dy * dy);",
                    "          if (snapToPixel) {",
                    "            // round center and radius to integer pixels to avoid jitter",
                    "            const cx = Math.round(x1orig);",
                    "            const cy = Math.round(y1orig);",
                    "            const r = Math.round(rOrig);",
                    "            context.moveTo(cx + r, cy);",
                    "            context.arc(cx, cy, r, 0, 2 * Math.PI, true);",
                    "          } else {",
                    "            // accurate rendering when not snapping",
                    "            context.moveTo(x1orig + rOrig, y1orig);",
                    "            context.arc(x1orig, y1orig, rOrig, 0, 2 * Math.PI, true);",
                    "          }",
                    "          ++i;",
                    "          break;"
                ]
            }
        ]
    }
