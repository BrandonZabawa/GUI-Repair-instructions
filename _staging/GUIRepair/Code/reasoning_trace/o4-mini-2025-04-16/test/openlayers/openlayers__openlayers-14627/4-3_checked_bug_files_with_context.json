        "  new EPSG3857Projection('EPSG:102113'),",
        "  new EPSG3857Projection('EPSG:900913'),",
        "  new EPSG3857Projection('http://www.opengis.net/def/crs/EPSG/0/3857'),",
        "  new EPSG3857Projection('http://www.opengis.net/gml/srs/epsg.xml#3857'),",
        "];",
        "",
        "/**",
