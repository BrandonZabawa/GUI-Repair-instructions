                "REPLACE": [
                    "function readVec2(node) {",
                    "  const xunits = node.getAttribute('xunits');",
                    "  const yunits = node.getAttribute('yunits');",
                    "  // Determine anchor origin: in KML, fraction/pixel units are measured",
                    "  // from the top-left; insetPixels units are measured from bottom-right.",
                    "  let origin;",
                    "  if (xunits === 'insetPixels') {",
                    "    // x measured from right",
                    "    if (yunits === 'insetPixels') {",
                    "      // y measured from bottom",
                    "      origin = IconOrigin.BOTTOM_RIGHT;",
                    "    } else {",
                    "      // y measured from top",
                    "      origin = IconOrigin.TOP_RIGHT;",
                    "    }",
                    "  } else {",
                    "    // x measured from left",
                    "    if (yunits === 'insetPixels') {",
                    "      // y measured from bottom",
                    "      origin = IconOrigin.BOTTOM_LEFT;",
                    "    } else {",
                    "      // y measured from top",
                    "      origin = IconOrigin.TOP_LEFT;",
                    "    }",
                    "  }",
                    "  return {",
                    "    x: parseFloat(node.getAttribute('x')),",
                    "    xunits: ICON_ANCHOR_UNITS_MAP[xunits],",
                    "    y: parseFloat(node.getAttribute('y')),",
                    "    yunits: ICON_ANCHOR_UNITS_MAP[yunits],",
                    "    origin: origin,",
                    "  };",
                    "}"
                ]
            }
        ]
    }
