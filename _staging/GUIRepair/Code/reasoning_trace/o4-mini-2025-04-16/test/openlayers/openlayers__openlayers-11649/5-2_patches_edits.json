                    "      // if proj4 def has no units, assume degrees; geographic longlat should be \"neu\"",
                    "      const units = def.units || 'degrees';",
                    "      const axisOrientation = def.axis || (units === 'degrees' ? 'neu' : 'enu');",
                    "      // def.to_meter only applies for linear units; for degrees, Projection will pick up METERS_PER_UNIT",
                    "      const metersPerUnit = def.to_meter;",
                    "      addProjection(",
                    "        new Projection({",
                    "          code: code,",
                    "          units: units,",
                    "          axisOrientation: axisOrientation,",
                    "          metersPerUnit: metersPerUnit,",
                    "        })",
