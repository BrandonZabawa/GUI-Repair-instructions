                    "    if (!this.helper && !!this.getLayer().getSource()) {",
                    "      if (!map.__sharedWebGLHelper) {",
                    "        map.__sharedWebGLHelper = new WebGLHelper({",
                    "          postProcesses: this.postProcesses_,",
                    "          uniforms: this.uniforms_,",
                    "        });",
                    "      }",
                    "      this.helper = map.__sharedWebGLHelper;",
                    "",
                    "      // If the layer declares a className, apply it to the shared canvas",
                    "      const className = this.getLayer().getClassName();",
                    "      if (className) {",
                    "        this.helper.getCanvas().className = className;",
                    "      }",
