                "REPLACE": [
                    "function readMultiPolygonGeometry(object) {",
                    "  // Filter out any empty rings so that deflateMultiCoordinatesArray()",
                    "  // never sees a zero\u2010length ring and produces an undefined end index.",
                    "  const coords = object['coordinates'].map(",
                    "    polygon => polygon.filter(",
                    "      ring => Array.isArray(ring) && ring.length > 0",
                    "    )",
                    "  );",
                    "  return new MultiPolygon(coords);",
                    "}"
                ]
            }
        ]
    }
