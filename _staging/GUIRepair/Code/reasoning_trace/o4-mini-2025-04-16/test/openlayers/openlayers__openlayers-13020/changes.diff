+  /**
+   * Replace the layer style (color, brightness, contrast, gamma, etc.)
+   * and trigger a re-render without re-fetching the tiles.
+   * @param {Style} style New style to apply to the layer.
+   * @api
+   */
+  setStyle(style) {
+    // Update the stored style object
+    this.style_ = style || {};
+    // Reset any style variables
+    this.styleVariables_ = this.style_.variables || {};
+    // Notify OL that the layer has changed (will re-parse shaders on next render)
+    this.changed();
+  }
