    "1/1": {
        "src/ol/format/KML.js": [
            {
                "SEARCH": [
                    "if (drawName) {",
                    "name = /** @type {string} */ (feature.get('name'));",
                    "drawName = drawName && !!name;",
                    "}"
                ],
                "REPLACE": [
                    "      if (drawName) {",
                    "        name = /** @type {string} */ (feature.get('name'));",
                    "        // decode HTML entities in the name so \"&apos;\" \u2192 \"'\" etc.",
                    "        name = name.replace(/&apos;/g, \"'\")",
                    "                   .replace(/&quot;/g, '\"')",
                    "                   .replace(/&lt;/g, '<')",
                    "                   .replace(/&gt;/g, '>')",
                    "                   .replace(/&amp;/g, '&');",
                    "        drawName = drawName && !!name;",
                    "      }"
                ]
            }
        ]
    }
}