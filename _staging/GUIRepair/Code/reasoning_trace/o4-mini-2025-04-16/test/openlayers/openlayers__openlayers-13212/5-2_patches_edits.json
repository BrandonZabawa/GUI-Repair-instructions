                ],
                "REPLACE": [
                    "  /**",
                    "   * @private",
                    "   * Load a single\u2010tile GeoTIFF via the provided URL template and compose it",
                    "   * using the existing loadTile_ routine.",
                    "   */",
                    "  loadTileTemplate_(z, x, y) {",
                    "    const url = this.urlTemplate_",
                    "      .replace('{z}', z)",
                    "      .replace('{x}', x)",
                    "      .replace('{y}', y);",
                    "    return tiffFromUrl(url)",
                    "      .then(getImagesForTIFF)",
                    "      .then((images) => {",
                    "        // set up the internal structures as a single\u2010source pyramid:",
                    "        this.sourceImagery_    = [images.reverse()];",
                    "        this.resolutionFactors_ = [1];",
                    "        this.samplesPerPixel_  = images[0].getSamplesPerPixel();",
                    "        this.nodataValues_     = [images.map(img => img.getGDALNoData() || NaN)];",
                    "        this.metadata_         = [images.map(img => img.getGDALMetadata())];",
                    "        // delegate to the standard loader for compositing",
                    "        return this.loadTile_(z, x, y);",
                    "      });",
                    "  }",
                    "}"
                ]
            }
