                    "          ? userBaseline",
                    "          : (textStyle.getText() && textStyle.getText().indexOf('\\n') !== -1",
                    "             ? 'top'",
                    "             : defaultTextBaseline);",
                    "      textState.backgroundFill = textStyle.getBackgroundFill();",
                    "      textState.backgroundStroke = textStyle.getBackgroundStroke();",
