                    "        const factorX = refRes / srcRes[0];",
                    "        const factorY = refRes / srcRes[1];",
                    "        this.resolutionFactors_[sourceIndex] = [factorX, factorY];",
                    "        // scale sourceResolutions for check",
                    "        const scaledSourceResolutions = sourceResolutions.map(",
