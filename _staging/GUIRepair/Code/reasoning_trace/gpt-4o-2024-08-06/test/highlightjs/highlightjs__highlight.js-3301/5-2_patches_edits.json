{
    "1/1": {
        "src/languages/css.js": [
            {
                "SEARCH": [
                    "{",
                    "begin: ':',",
                    "end: '[;}]',",
                    "contains: [",
                    "modes.HEXCOLOR,",
                    "modes.IMPORTANT,",
                    "modes.CSS_NUMBER_MODE,",
                    "...STRINGS,"
                ],
                "REPLACE": [
                    "{",
                    "begin: ':',",
                    "end: '[;}]',",
                    "contains: [",
                    "hljs.C_BLOCK_COMMENT_MODE, // Add this line to handle inline comments",
                    "modes.HEXCOLOR,",
                    "modes.IMPORTANT,",
                    "modes.CSS_NUMBER_MODE,",
                    "...STRINGS,"
                ]
            }
        ]
    }
}