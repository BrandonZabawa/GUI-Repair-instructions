{
    "1/1": {
        "src/languages/python.js": [
            {
                "SEARCH": [
                    "{",
                    "className: 'meta',",
                    "begin: /^[\\t ]*@/, end: /$/",
                    "},"
                ],
                "REPLACE": [
                    "{",
                    "className: 'meta',",
                    "begin: /^[\\t ]*@/,",
                    "end: /(?=#)|$/,",
                    "contains: [hljs.HASH_COMMENT_MODE]",
                    "},"
                ]
            }
        ]
    }
