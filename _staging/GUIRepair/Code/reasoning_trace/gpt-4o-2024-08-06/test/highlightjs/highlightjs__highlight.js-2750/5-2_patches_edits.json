{
    "1/1": {
        "src/languages/javascript.js": [
            {
                "SEARCH": [
                    "const SUBST = {",
                    "className: 'subst',",
                    "begin: '\\\\$\\\\{',",
                    "end: '\\\\}',",
                    "keywords: KEYWORDS,",
                    "contains: [] // defined later",
                    "};"
                ],
                "REPLACE": [
                    "const SUBST = {",
                    "className: 'subst',",
                    "begin: '\\\\$\\\\{',",
                    "end: '\\\\}',",
                    "keywords: KEYWORDS,",
                    "contains: [",
                    "'self', // Allow nested substitutions",
                    "hljs.APOS_STRING_MODE,",
                    "hljs.QUOTE_STRING_MODE,",
                    "HTML_TEMPLATE,",
                    "CSS_TEMPLATE,",
                    "TEMPLATE_STRING,",
                    "NUMBER,",
                    "hljs.REGEXP_MODE",
                    "]",
                    "};"
                ]
            }
        ],
        "src/languages/typescript.js": [
            {
                "SEARCH": [
                    "const tsLanguage = javascript(hljs);"
                ],
                "REPLACE": [
                    "const tsLanguage = javascript(hljs);",
                    "",
                    "// Ensure nested substitutions are handled",
                    "tsLanguage.contains.forEach(mode => {",
                    "if (mode.className === 'subst') {",
                    "mode.contains.unshift('self');",
                    "}",
                    "});"
                ]
            }
        ]
    }
}