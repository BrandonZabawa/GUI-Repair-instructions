{
    "1/5": {
        "src/languages/latex.js": [
            {
                "SEARCH": [
                    "{",
                    "className: 'string', // because it looks like attributes in HTML tags",
                    "variants: [",
                    "{begin: /\\[/, end: /\\]/},",
                    "{begin: /\\{/, end: /\\}/}",
                    "]",
                    "}"
                ],
                "REPLACE": [
                    "{",
                    "begin: /\\{/, end: /\\}/,",
                    "contains: [",
                    "COMMAND, // Allow LaTeX commands inside braces",
                    "{",
                    "className: 'formula',",
                    "contains: [COMMAND],",
                    "relevance: 0,",
                    "variants: [",
                    "{begin: /\\$/, end: /\\$/}",
                    "]",
                    "}",
                    "]",
                    "}"
                ]
            }
        ]
    },
    "2/5": {
        "src/languages/latex.js": [
            {
                "SEARCH": [
                    "{",
                    "className: 'string',",
                    "variants: [",
                    "{begin: /\\\\[/, end: /\\\\]/},",
                    "{begin: /\\\\{/, end: /\\\\}/}",
                    "]",
                    "}"
                ],
                "REPLACE": [
                    "{",
                    "variants: [",
                    "{begin: /\\\\[\\\\[]/, end: /\\\\[\\\\]]/},  // match only double square brackets",
