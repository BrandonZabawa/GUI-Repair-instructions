                    "{begin: /\\[/, end: /\\]/},",
                    "{begin: /\\{/, end: /\\}/}",
                    "]",
                    "}"
                ],
                "REPLACE": [
                    "{",
                    "begin: /\\{/, end: /\\}/,",
                    "contains: [",
