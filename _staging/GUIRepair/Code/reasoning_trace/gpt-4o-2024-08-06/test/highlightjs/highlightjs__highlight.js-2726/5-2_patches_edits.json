                    "keyword: '\\\\eTiX \\\\TeX \\\\! \\\\~ \\\\begin \\\\end \\\\frac \\\\text \\\\textbf'",
                    "},",
                    "contains: [",
                    "COMMAND,",
                    "{",
                    "begin: /\\\\[{}]/",
                    "},",
                    "{",
                    "className: 'formula',",
                    "variants: [",
                    "{begin: /\\\\/, end: /\\\\$/},",
                    "{begin: /\\$/ , end: /\\$/}",
                    "]",
                    "}",
                    "]"
                ]
            }
        ]
    },
    "5/5": {
        "src/languages/latex.js": [
            {
