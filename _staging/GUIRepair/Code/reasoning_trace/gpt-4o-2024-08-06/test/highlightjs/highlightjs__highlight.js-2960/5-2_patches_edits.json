{
    "1/1": {
        "src/languages/perl.js": [
            {
                "SEARCH": [
                    "{",
                    "className: 'regexp',",
                    "begin: /(m|qr)?\\//,",
                    "end: regex.concat(",
                    "/\\//,",
                    "REGEX_MODIFIERS",
                    "),",
                    "contains: [ hljs.BACKSLASH_ESCAPE ],",
                    "relevance: 0 // allows empty \"//\" which is a common comment delimiter in other languages",
                    "}"
                ],
                "REPLACE": [
                    "{",
                    "className: 'regexp',",
                    "begin: /(m|qr)?([\\/#|!{<\\[])/,",
                    "end: regex.concat(",
                    "/\\2/,",
                    "REGEX_MODIFIERS",
                    "),",
                    "contains: [ hljs.BACKSLASH_ESCAPE ],",
                    "relevance: 0 // allows empty \"//\" which is a common comment delimiter in other languages",
                    "}"
                ]
            }
        ]
    }
}