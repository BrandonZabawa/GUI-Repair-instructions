{
    "1/1": {
        "src/languages/powershell.js": [
            {
                "SEARCH": [
                    "const PS_ARGUMENTS = {",
                    "variants: [",
                    "// PS literals are pretty verbose so it's a good idea to accent them a bit.",
                    "{",
                    "className: 'operator',",
                    "begin: '('.concat(COMPARISON_OPERATORS, ')\\\\b')",
                    "},",
                    "{",
                    "className: 'literal',",
                    "begin: /(-)[\\w\\d]+/,",
                    "relevance: 0",
                    "}",
                    "]",
                    "};"
                ],
                "REPLACE": [
                    "const PS_ARGUMENTS = {",
                    "variants: [",
                    "// PS literals are pretty verbose so it's a good idea to accent them a bit.",
                    "{",
                    "className: 'operator',",
                    "begin: '('.concat(COMPARISON_OPERATORS, ')\\\\b')",
                    "},",
                    "{",
                    "className: 'literal',",
                    "begin: /(--?)[\\w\\d]+/,",
                    "relevance: 0",
                    "}",
                    "]",
                    "};"
                ]
            }
        ]
    }
}