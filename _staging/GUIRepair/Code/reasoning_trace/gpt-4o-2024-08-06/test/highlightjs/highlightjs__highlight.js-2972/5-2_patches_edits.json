{
    "1/1": {
        "src/languages/python.js": [
            {
                "SEARCH": [
                    "contains: ['self', PROMPT, NUMBER, STRING, hljs.HASH_COMMENT_MODE],"
                ],
                "REPLACE": [
                    "contains: ['self', PROMPT, NUMBER, STRING, hljs.HASH_COMMENT_MODE, {",
                    "className: 'type',",
                    "begin: /:\\s*/, end: /[,)]/,",
                    "excludeBegin: true,",
                    "excludeEnd: true,",
                    "relevance: 0",
                    "}],"
                ]
            }
        ]
    }
}