{
    "1/1": {
        "src/languages/kotlin.js": [
            {
                "SEARCH": [
                    "className: 'class',",
                    "beginKeywords: 'class interface trait', // remove 'trait' when removed from KEYWORDS",
                    "end: /[:\\{(]|$/,",
                    "excludeEnd: true,",
                    "illegal: 'extends implements',",
                    "contains: [",
                    "{ beginKeywords: 'public protected internal private constructor' },",
                    "hljs.UNDERSCORE_TITLE_MODE,",
                    "{",
                    "className: 'type',",
                    "begin: /</,",
                    "end: />/,",
                    "excludeBegin: true,",
                    "excludeEnd: true,",
                    "relevance: 0",
                    "},",
                    "{",
                    "className: 'type',",
                    "begin: /[,:]\\s*/,",
                    "end: /[<\\(,]|$/,",
                    "excludeBegin: true,",
                    "returnEnd: true",
                    "},",
                    "ANNOTATION_USE_SITE,",
                    "ANNOTATION",
                    "]"
                ],
                "REPLACE": [
                    "className: 'class',",
                    "beginKeywords: 'class interface trait', // remove 'trait' when removed from KEYWORDS",
                    "end: /[:\\{(]|$/,",
                    "excludeEnd: true,",
                    "illegal: 'extends implements',",
                    "contains: [",
                    "{ beginKeywords: 'public protected internal private constructor' },",
                    "hljs.UNDERSCORE_TITLE_MODE,",
                    "{",
                    "className: 'type',",
                    "begin: /</,",
                    "end: />/,",
                    "excludeBegin: true,",
                    "excludeEnd: true,",
                    "relevance: 0",
                    "},",
                    "{",
                    "className: 'type',",
                    "begin: /[,:]\\s*/,",
                    "end: /[<\\(,]|$/,",
                    "excludeBegin: true,",
                    "returnEnd: true,",
                    "contains: [",
                    "{",
                    "className: 'punctuation',",
                    "begin: /[()]/,",
                    "relevance: 0",
                    "}",
                    "]",
                    "},",
                    "ANNOTATION_USE_SITE,",
                    "ANNOTATION",
                    "]"
                ]
            }
        ]
    }
}