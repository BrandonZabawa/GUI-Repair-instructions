diff --git a/lib/rules/no-unused-vars.js b/lib/rules/no-unused-vars.js
index 5dd632fdb..3b34fc414 100644
--- a/lib/rules/no-unused-vars.js
+++ b/lib/rules/no-unused-vars.js
@@ -143,12 +143,21 @@ module.exports = {
 
                 return variable.defs
                     .filter(def => def.name.type === "Identifier")
-                    .some(def => (
-                        def.node.id &&
-                        def.node.id.type === "ObjectPattern" &&
-                        def.node.id.properties.length &&
-                        restProperties.has(def.node.id.properties[def.node.id.properties.length - 1].type) &&  // last property is a rest property
-                        !restProperties.has(def.name.parent.type)  // variable is sibling of the rest property
+.some(def => {
+const isRestSibling = (
+def.node.id &&
+def.node.id.type === "ObjectPattern" &&
+def.node.id.properties.length &&
+restProperties.has(def.node.id.properties[def.node.id.properties.length - 1].type)
+);
+
+const isFunctionArgument = (
+def.name.parent &&
+def.name.parent.type === "FunctionExpression" || def.name.parent.type === "ArrowFunctionExpression"
+);
+
+return isRestSibling && (isFunctionArgument || !restProperties.has(def.name.parent.type));
+})
                     ));
             }
 
