        "  var oldProperties = context.oldProperties || getModdleProperties(moddleElement, keys(properties));",
        "",
        "  setModdleProperties(moddleElement, properties);",
        "",
        "  context.oldProperties = oldProperties;",
        "  context.changed = changed;",
        "",
        "  return changed;",
        "};",
