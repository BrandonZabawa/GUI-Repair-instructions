            "function_name": "BpmnLayouter.prototype.layoutConnection",
            "file_path": "lib/features/modeling/BpmnLayouter.js",
            "function_details": [
                {
                    "name": "BpmnLayouter.prototype.layoutConnection",
                    "start_line": 33,
