        "export function isLabelExternal(semantic) {",
        "  return is(semantic, 'bpmn:Event') ||",
        "         is(semantic, 'bpmn:Gateway') ||",
        "         is(semantic, 'bpmn:DataStoreReference') ||",
        "         is(semantic, 'bpmn:DataObjectReference') ||",
        "         is(semantic, 'bpmn:DataInput') ||",
