                "BpmnRenderer.prototype.drawConnection = function(parentGfx, element) {",
                "  var type = element.type;",
                "  var h = this.handlers[type];",
                "",
                "  /* jshint -W040 */",
                "  return h(parentGfx, element);",
                "};"
            ]
        },
