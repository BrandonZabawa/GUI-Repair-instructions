                "",
                "  if (is(target, 'bpmn:Participant')) {",
                "    this._modeling.resizeLane(target, newBounds, null, hints);",
                "  } else {",
                "    this._modeling.resizeShape(target, newBounds, null, hints);",
                "  }",
