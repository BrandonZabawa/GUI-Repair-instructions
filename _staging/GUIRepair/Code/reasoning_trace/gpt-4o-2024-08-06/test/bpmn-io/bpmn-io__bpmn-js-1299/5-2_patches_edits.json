{
    "1/1": {
        "lib/features/label-editing/LabelEditingProvider.js": [
            {
                "SEARCH": [
                    "// external labels",
                    "if (isLabelExternal(element)) {",
                    "assign(options, {",
                    "autoResize: true",
                    "});",
                    "}",
                    "",
                    "// text annotations",
                    "if (is(element, 'bpmn:TextAnnotation')) {",
                    "assign(options, {",
                    "resizable: true,",
                    "autoResize: true",
                    "});",
                    "}"
                ],
                "REPLACE": [
                    "// external labels",
                    "if (isLabelExternal(element) && text.trim() !== '') {",
                    "assign(options, {",
                    "autoResize: true",
                    "});",
                    "}",
                    "",
                    "// text annotations",
                    "if (is(element, 'bpmn:TextAnnotation') && text.trim() !== '') {",
                    "assign(options, {",
                    "resizable: true,",
                    "autoResize: true",
                    "});",
                    "}"
                ]
            }
        ]
    }
}