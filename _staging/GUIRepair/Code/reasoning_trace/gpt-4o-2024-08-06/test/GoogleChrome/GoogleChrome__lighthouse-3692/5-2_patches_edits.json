{
    "1/1": {
        "lighthouse-core/report/v2/renderer/report-renderer.js": [
            {
                "SEARCH": [
                    "_renderReportHeader(report) {",
                    "const header = this._dom.cloneTemplate('#tmpl-lh-heading', this._templateContext);",
                    "this._dom.find('.lh-config__timestamp', header).textContent =",
                    "Util.formatDateTime(report.generatedTime);",
                    "const url = this._dom.find('.lh-metadata__url', header);",
                    "url.href = report.url;",
                    "url.textContent = report.url;"
                ],
                "REPLACE": [
                    "  _renderReportHeader(report) {",
                    "    const header = this._dom.cloneTemplate('#tmpl-lh-heading', this._templateContext);",
                    "    this._dom.find('.lh-config__timestamp', header).textContent =",
                    "        Util.formatDateTime(report.generatedTime);",
                    "    const url = this._dom.find('.lh-metadata__url', header);",
                    "    url.href = report.url;",
                    "    url.textContent = report.url;",
                    "",
                    "    // Add warning for headless Chrome",
                    "    if (report.runtimeConfig.environment.some(runtime => runtime.name.includes('HeadlessChrome'))) {",
                    "      const warning = this._dom.createElement('div', 'lh-warning');",
                    "      warning.textContent = 'Note: Your site\\'s mobile performance may be worse than the numbers presented in this report. Lighthouse could not test on a mobile connection because Headless Chrome does not support network throttling.';",
                    "      header.insertBefore(warning, header.firstChild);",
                    "    }"
                ]
            }
        ]
    }
}