{
    "1/1": {
        "lighthouse-core/gather/computed/critical-request-chains.js": [
            {
                "SEARCH": [
                    "return ['VeryHigh', 'High', 'Medium'].includes(request.priority());"
                ],
                "REPLACE": [
                    "    // Check if the request is a preload with an onload handler that changes rel to stylesheet",
                    "    const isPreloadWithOnload = request._resourceType === WebInspector.resourceTypes.Stylesheet &&",
                    "                                request.initiator.type === 'parser' &&",
                    "                                request.initiator.stack &&",
                    "                                request.initiator.stack.callFrames.some(frame => frame.functionName.includes('onload'));",
                    "",
                    "    return ['VeryHigh', 'High', 'Medium'].includes(request.priority()) && !isPreloadWithOnload;"
                ]
            }
        ]
    }
}