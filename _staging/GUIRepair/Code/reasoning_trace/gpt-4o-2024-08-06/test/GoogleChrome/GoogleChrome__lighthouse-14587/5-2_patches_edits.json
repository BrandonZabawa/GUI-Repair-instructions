{
    "1/1": {
        "core/lib/emulation.js": [
            {
                "SEARCH": [
                    "const motoG4Details = {",
                    "platform: 'Android',",
                    "platformVersion: '6.0',",
                    "architecture: '',",
                    "model: 'Moto G4',",
                    "};",
                    "const macDesktopDetails = {",
                    "platform: 'macOS',",
                    "platformVersion: '10.15.7',",
                    "architecture: 'x86',",
                    "model: '',",
                    "};",
                    "const mobile = formFactor === 'mobile';",
                    "",
                    "return {",
                    "brands,",
                    "fullVersion,",
                    "// Since config users can supply a custom useragent, they likely are emulating something",
                    "// other than Moto G4 and MacOS Desktop.",
                    "// TODO: Determine how to thoughtfully expose this metadata/client-hints configurability.",
                    "...(mobile ? motoG4Details : macDesktopDetails),",
                    "mobile,",
                    "};"
                ],
                "REPLACE": [
                    "  const mobile = formFactor === 'mobile';",
                    "",
                    "  const deviceDetails = settings.screenEmulation.disabled ? {} : (mobile ? {",
                    "    platform: 'Android',",
                    "    platformVersion: '6.0',",
                    "    architecture: '',",
                    "    model: 'Moto G4',",
                    "  } : {",
                    "    platform: 'macOS',",
                    "    platformVersion: '10.15.7',",
                    "    architecture: 'x86',",
                    "    model: '',",
                    "  });",
                    "",
                    "  return {",
                    "    brands,",
                    "    fullVersion,",
                    "    ...deviceDetails,",
                    "    mobile,",
                    "  };"
                ]
            }
        ]
    }
}