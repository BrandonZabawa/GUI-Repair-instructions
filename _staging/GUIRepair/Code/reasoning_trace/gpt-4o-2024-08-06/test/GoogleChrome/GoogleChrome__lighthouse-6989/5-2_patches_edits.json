{
    "1/1": {
        "lighthouse-core/report/html/renderer/report-renderer.js": [
            {
                "SEARCH": [
                    "if (!report.runWarnings || report.runWarnings.length === 0) {",
                    "return this._dom.createElement('div');",
                    "}",
                    "",
                    "const container = this._dom.cloneTemplate('#tmpl-lh-warnings--toplevel', this._templateContext);",
                    "const message = this._dom.find('.lh-warnings__msg', container);",
                    "message.textContent = Util.UIStrings.toplevelWarningsMessage;"
                ],
                "REPLACE": [
                    "    const container = this._dom.createElement('div');",
                    "    if (report.runWarnings && report.runWarnings.length > 0) {",
                    "      const warningsContainer = this._dom.cloneTemplate('#tmpl-lh-warnings--toplevel', this._templateContext);",
                    "      const message = this._dom.find('.lh-warnings__msg', warningsContainer);",
                    "      message.textContent = Util.UIStrings.toplevelWarningsMessage;",
                    "",
                    "      const warnings = this._dom.find('ul', warningsContainer);",
                    "      for (const warningString of report.runWarnings) {",
                    "        const warning = warnings.appendChild(this._dom.createElement('li'));",
                    "        warning.textContent = warningString;",
                    "      }",
                    "      container.appendChild(warningsContainer);",
                    "    }"
                ]
            }
        ],
        "lighthouse-core/audits/viewport.js": [
            {
                "SEARCH": [
                    "if (Object.keys(parsedProps.unknownProperties).length) {",
                    "warnings.push(`Invalid properties found: ${JSON.stringify(parsedProps.unknownProperties)}`);",
                    "}",
                    "if (Object.keys(parsedProps.invalidValues).length) {",
                    "warnings.push(`Invalid values found: ${JSON.stringify(parsedProps.invalidValues)}`);",
                    "}"
                ],
                "REPLACE": [
                    "    if (Object.keys(parsedProps.unknownProperties).length > 0) {",
                    "      warnings.push(`Invalid properties found: ${JSON.stringify(parsedProps.unknownProperties)}`);",
                    "    }",
                    "    if (Object.keys(parsedProps.invalidValues).length > 0) {",
                    "      warnings.push(`Invalid values found: ${JSON.stringify(parsedProps.invalidValues)}`);",
                    "    }"
                ]
            }
        ]
    }
}