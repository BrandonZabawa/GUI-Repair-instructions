{
    "1/1": {
        "lighthouse-core/lib/stack-collector.js": [
            {
                "SEARCH": [
                    "return jsLibraries.map(lib => ({",
                    "detector: /** @type {'js'} */ ('js'),",
                    "id: lib.id,",
                    "name: lib.name,",
                    "version: lib.version || undefined,",
                    "npm: lib.npm || undefined,",
                    "}));"
                ],
                "REPLACE": [
                    "  const uniqueLibraries = new Map();",
                    "  jsLibraries.forEach(lib => {",
                    "    const key = `${lib.id}@${lib.version}`;",
                    "    if (!uniqueLibraries.has(key)) {",
                    "      uniqueLibraries.set(key, {",
                    "        detector: /** @type {'js'} */ ('js'),",
                    "        id: lib.id,",
                    "        name: lib.name,",
                    "        version: lib.version || undefined,",
                    "        npm: lib.npm || undefined,",
                    "      });",
                    "    }",
                    "  });",
                    "  return Array.from(uniqueLibraries.values());"
                ]
            }
        ],
        "lighthouse-core/audits/dobetterweb/js-libraries.js": [
            {
                "SEARCH": [
                    "const libDetails = artifacts.Stacks",
                    ".filter(stack => stack.detector === 'js')",
                    ".map(stack => ({",
                    "name: stack.name,",
                    "version: stack.version,",
                    "npm: stack.npm,",
                    "}));"
                ],
                "REPLACE": [
                    "    const uniqueLibs = new Map();",
                    "    artifacts.Stacks",
                    "      .filter(stack => stack.detector === 'js')",
                    "      .forEach(stack => {",
                    "        const key = `${stack.name}@${stack.version}`;",
                    "        if (!uniqueLibs.has(key)) {",
                    "          uniqueLibs.set(key, {",
                    "            name: stack.name,",
                    "            version: stack.version,",
                    "            npm: stack.npm,",
                    "          });",
                    "        }",
                    "      });",
                    "    const libDetails = Array.from(uniqueLibs.values());"
                ]
            }
        ]
    }
}