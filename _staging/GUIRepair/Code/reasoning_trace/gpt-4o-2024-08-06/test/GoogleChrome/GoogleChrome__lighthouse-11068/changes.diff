diff --git a/lighthouse-core/gather/gatherers/css-usage.js b/lighthouse-core/gather/gatherers/css-usage.js
index 282dbd7a9..d4ffb25f6 100644
--- a/lighthouse-core/gather/gatherers/css-usage.js
+++ b/lighthouse-core/gather/gatherers/css-usage.js
@@ -27,6 +27,20 @@ class CSSUsage extends Gatherer {
     await driver.sendCommand('DOM.enable');
     await driver.sendCommand('CSS.enable');
     await driver.sendCommand('CSS.startRuleUsageTracking');
+
+    // Evaluate stylesheets in all frames, including iframes
+    const evaluateStylesheets = async (frame) => {
+      const frameStylesheets = await driver.sendCommand('CSS.getAllStyleSheets', {frameId: frame.id});
+      frameStylesheets.forEach(sheet => stylesheets.push(sheet));
+      const childFrames = await driver.sendCommand('Page.getFrameTree', {frameId: frame.id});
+      for (const childFrame of childFrames.childFrames) {
+        await evaluateStylesheets(childFrame);
+      }
+    };
+
+    const mainFrame = await driver.sendCommand('Page.getFrameTree');
+    await evaluateStylesheets(mainFrame.frameTree.frame);
+
     await driver.evaluateAsync('getComputedStyle(document.body)');
     driver.off('CSS.styleSheetAdded', onStylesheetAdded);
 
