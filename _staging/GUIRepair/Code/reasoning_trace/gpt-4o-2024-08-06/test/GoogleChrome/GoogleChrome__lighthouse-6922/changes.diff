@@ -73,7 +73,24 @@ class Driver {
       this._devtoolsLog.record(event);
       if (this._networkStatusMonitor) {
         this._networkStatusMonitor.dispatch(event);
+  }
+
+  /**
+   * Discover targets and enable network monitoring for OOPIFs.
+   * @return {Promise<void>}
+   */
+  async enableOOPIFs() {
+    const targets = await this.sendCommand('Target.getTargets');
+    for (const target of targets.targetInfos) {
+      if (target.type === 'iframe') {
+        await this.sendCommand('Target.attachToTarget', {targetId: target.targetId, flatten: true});
+        await this.sendCommand('Target.sendMessageToTarget', {
+          targetId: target.targetId,
+          message: JSON.stringify({id: 1, method: 'Network.enable'}),
+        });
       }
+    }
+  }
 
