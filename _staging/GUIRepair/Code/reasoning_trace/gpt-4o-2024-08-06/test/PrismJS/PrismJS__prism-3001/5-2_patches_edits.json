{
    "1/5": {
        "prism.js": [
            {
                "SEARCH": [
                    "'keyword': /\\b(?:if|else|while|do|for|return|in|instanceof|function|new|try|throw|catch|finally|null|break|continue)\\b/,"
                ],
                "REPLACE": [
                    "'keyword': /\\b(?:if|else|while|do|for|return|in|instanceof|function|new|try|throw|catch|finally|null|break|continue|infer|type)\\b/,"
                ]
            }
        ],
        "plugins/highlight-keywords/prism-highlight-keywords.js": [
            {
                "SEARCH": [
                    "Prism.hooks.add('wrap', function (env) {",
                    "if (env.type !== 'keyword') {",
                    "return;",
                    "}",
                    "env.classes.push('keyword-' + env.content);",
                    "});"
                ],
                "REPLACE": [
                    "Prism.hooks.add('wrap', function (env) {",
                    "if (env.type !== 'keyword') {",
                    "return;",
                    "}",
                    "if (!/\\b(?:infer|type)\\b/.test(env.content)) {",
                    "env.classes.push('keyword-' + env.content);",
                    "}",
                    "});"
                ]
            }
        ]
    },
    "2/5": {
        "prism.js": [
            {
                "SEARCH": [
                    "'keyword': /\\b(?:if|else|while|do|for|return|...|type|infer)\\b/,"
                ],
                "REPLACE": [
                    "'keyword': /\\b(?:if|else|while|do|for|return|...|type|infer)\\b(?!\\w)/,"
                ]
            }
        ]
    },
    "3/5": {
        "prism.js": [
            {
                "SEARCH": [
                    "\\t\\'keyword\\': /\\\\b(?:if|else|while|do|for|return|in|instanceof|function|new|try|throw|catch|finally|null|break|continue)\\\\b/,"
                ],
                "REPLACE": [
                    "\\t\\'keyword\\': /\\\\b(?:if|else|while|do|for|return|in|instanceof|function|new|try|throw|catch|finally|null|break|continue)\\\\b(?=\\\\W|$)/,"
                ]
            },
            {
                "SEARCH": [
                    "\\t\\tif (env.type !== 'keyword') {",
                    "\\t\\t\\treturn;",
                    "\\t\\t}"
                ],
                "REPLACE": [
                    "\\t\\tif (env.type !== 'keyword' || !/\\\\b(?:if|else|while|do|for|return|in|instanceof|function|new|try|throw|catch|finally|null|break|continue)\\\\b/.test(env.content)) {",
                    "\\t\\t\\treturn;",
                    "\\t\\t}"
                ]
            }
        ]
    },
    "4/5": {
        "prism.js": [
            {
                "SEARCH": [
                    "\\t\\'keyword\\': /\\\\b(?:if|else|while|do|for|return|in|instanceof|function|new|try|throw|catch|finally|null|break|continue)\\\\b/,",
                    "\\t\\t},\\n\\t\\t'boolean':"
                ],
                "REPLACE": [
                    "\\t\\'keyword\\': /\\\\b(?:if|else|while|do|for|return|in|instanceof|function|new|try|throw|catch|finally|null|break|continue|infer|type)\\\\b/,",
                    "\\t\\t},\\n\\t\\t'boolean':"
                ]
            }
        ]
    },
    "5/5": {
        "prism.js": [
            {
