    "2/5": {
        "prism.js": [
            {
                "SEARCH": [
                    "plaintext: plainTextGrammar,",
                    "text: plainTextGrammar,",
                    "txt: plainTextGrammar,"
                ],
                "REPLACE": [
                    "plaintext: plainTextGrammar,",
                    "text: plainTextGrammar,",
                    "txt: plainTextGrammar,",
                    "mermaid: {",
                    "'comment': /%%.*$/,",
                    "'directive': {",
                    "pattern: /%%{.*}%%/,",
                    "inside: {",
                    "'punctuation': /^%%{|}%%$/",
                    "}",
                    "},",
                    "'keyword': /\\b(?:graph|subgraph|end|style|classDef)\\b/,",
                    "'entity': /\\b(?:TB|BT|LR|RL)\\b/,",
                    "'variable': /[^{}<>\"]+(?= *\\.=)/,",
                    "'punctuation': /[{}<>.()=]/",
                    "},"
                ]
            }
        ]
    },
    "3/5": {
