                    "languages: {",
                    "/**...existing code... */",
                    "txt: plainTextGrammar,",
                    "mermaid: {",
                    "'keyword': /\\b(?:graph|classDiag|sequenceDiagram|gantt|pie|stateDiagram|erDiagram|journey)\\b/,",
