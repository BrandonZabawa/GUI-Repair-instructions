                    "'arrow': /==>|-->|-\\>\\|-\\>/,",
                    "'entity': /\\b[A-Za-z]\\w*\\b/,",
                    "'note': /note(?:\\sleft|right|top|bottom)?\\s?:.*?(?=\\n|$)/",
                    "},"
                ]
            }
        ]
    },
    "4/5": {
        "prism.js": [
            {
