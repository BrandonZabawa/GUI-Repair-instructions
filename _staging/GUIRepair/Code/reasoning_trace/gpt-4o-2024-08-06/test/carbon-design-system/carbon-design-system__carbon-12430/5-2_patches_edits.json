{
    "1/1": {
        "packages/react/src/components/Dropdown/Dropdown.js": [
            {
                "SEARCH": [
                    "disabled,",
                    "direction,",
                    "items,",
                    "label,",
                    "ariaLabel,"
                ],
                "REPLACE": [
                    "  disabled,",
                    "  readOnly, // Add readOnly prop",
                    "  direction,",
                    "  items,",
                    "  label,",
                    "  ariaLabel,"
                ]
            },
            {
                "SEARCH": [
                    "const className = cx(",
                    "`${prefix}--dropdown`,",
                    "[enabled ? null : containerClassName],",
                    "{",
                    "[`${prefix}--dropdown--invalid`]: invalid,",
                    "[`${prefix}--dropdown--warning`]: showWarning,",
                    "[`${prefix}--dropdown--open`]: isOpen,",
                    "[`${prefix}--dropdown--inline`]: inline,",
                    "[`${prefix}--dropdown--disabled`]: disabled,",
                    "[`${prefix}--dropdown--light`]: light,",
                    "[`${prefix}--dropdown--${size}`]: size,",
                    "[`${prefix}--list-box--up`]: direction === 'top',",
                    "}",
                    ");"
                ],
                "REPLACE": [
                    "  const className = cx(",
                    "    `${prefix}--dropdown`,",
                    "    [enabled ? null : containerClassName],",
                    "    {",
                    "      [`${prefix}--dropdown--invalid`]: invalid,",
                    "      [`${prefix}--dropdown--warning`]: showWarning,",
                    "      [`${prefix}--dropdown--open`]: isOpen,",
                    "      [`${prefix}--dropdown--inline`]: inline,",
                    "      [`${prefix}--dropdown--disabled`]: disabled || readOnly, // Apply readOnly style",
                    "      [`${prefix}--dropdown--light`]: light,",
                    "      [`${prefix}--dropdown--${size}`]: size,",
                    "      [`${prefix}--list-box--up`]: direction === 'top',",
                    "    }",
                    "  );"
                ]
            },
            {
                "SEARCH": [
                    "disabled={disabled}",
                    "aria-disabled={disabled}"
                ],
                "REPLACE": [
                    "        disabled={disabled || readOnly} // Disable interaction if readOnly",
                    "        aria-disabled={disabled || readOnly}"
                ]
            },
            {
                "SEARCH": [
                    "Dropdown.defaultProps = {",
                    "disabled: false,"
                ],
                "REPLACE": [
                    "Dropdown.defaultProps = {",
                    "  disabled: false,",
                    "  readOnly: false, // Default readOnly to false"
                ]
            }
        ]
    }
}