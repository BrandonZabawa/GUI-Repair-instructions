        "...",
        "export function NotificationButton({",
        "  ariaLabel,",
        "  className,",
        "  iconDescription,",
        "  type,",
        "  renderIcon: IconTag,",
        "  name,",
        "  notificationType,",
        "  ...rest",
        "}) {",
        "  const prefix = usePrefix();",
