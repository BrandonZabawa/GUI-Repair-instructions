{
    "1/1": {
        "packages/react/src/components/CodeSnippet/CodeSnippet.js": [
            {
                "SEARCH": [
                    "<code>",
                    "<pre ref={codeContentRef}>{children}</pre>",
                    "</code>"
                ],
                "REPLACE": [
                    "<code>",
                    "<pre ref={codeContentRef} style={{ whiteSpace: 'pre-wrap', wordWrap: 'break-word' }}>",
                    "{children}",
                    "</pre>",
                    "</code>"
                ]
            }
        ]
    }
}