            {
                "SEARCH": [
                    "disabled,",
                    "hideLabel,",
                    "id,"
                ],
                "REPLACE": [
                    "  disabled,",
                    "  readOnly,",
                    "  hideLabel,",
                    "  id,"
                ]
            },
            {
                "SEARCH": [
                    "return (",
                    "<div className={wrapperClasses}>",
                    "<input",
                    "{...rest}",
                    "type=\"radio\"",
                    "className={`${prefix}--radio-button`}",
                    "onChange={handleOnChange}",
