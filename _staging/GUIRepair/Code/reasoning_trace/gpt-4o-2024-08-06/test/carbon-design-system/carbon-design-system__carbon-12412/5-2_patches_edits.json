                "REPLACE": [
                    "  const inputClasses = classNames(`${prefix}--radio-button`, {",
                    "    [`${prefix}--radio-button--readonly`]: readOnly,",
                    "  });",
                    "",
                    "  return (",
                    "    <div className={wrapperClasses}>",
                    "      <input",
                    "        {...rest}",
                    "        type=\"radio\"",
                    "        className={inputClasses}",
                    "        onChange={readOnly ? undefined : handleOnChange}",
                    "        id={uniqueId}",
                    "        ref={ref}",
                    "        disabled={disabled || readOnly}",
                    "        value={value}",
                    "        name={name}",
                    "      />",
                    "      <label htmlFor={uniqueId} className={`${prefix}--radio-button__label`}>",
                    "        <span className={`${prefix}--radio-button__appearance`} />",
