                    "import React from 'react';",
                    "import PropTypes from 'prop-types';",
                    "import classnames from 'classnames';",
                    "import { settings } from 'carbon-components';",
                    "",
                    "const { prefix } = settings;",
                    "",
                    "const ProgressBar = ({ value, max, className, ...other }) => {",
                    "  const percentage = Math.min(Math.max(value / max, 0), 1) * 100;",
                    "  const classes = classnames(`${prefix}--progress-bar`, className);",
                    "",
                    "  return (",
                    "    <div className={classes} {...other}>",
                    "      <div",
                    "        className={`${prefix}--progress-bar__fill`}",
                    "        style={{ width: `${percentage}%` }}",
                    "      />",
                    "      <span className={`${prefix}--progress-bar__label`}>{`${percentage.toFixed(0)}%`}</span>",
                    "    </div>",
                    "  );",
                    "};",
                    "",
                    "ProgressBar.propTypes = {",
                    "  value: PropTypes.number.isRequired,",
                    "  max: PropTypes.number.isRequired,",
                    "  className: PropTypes.string,",
                    "};",
                    "",
                    "export default ProgressBar;"
                ]
            }
        ]
