                "  _handleClick({ relatedTarget, type, hadContextMenu, details }) {",
                "    const state = {",
                "      click: 'shown',",
                "      keydown: 'shown',",
                "      blur: 'hidden',",
                "      touchleave: 'hidden',",
                "      touchcancel: 'hidden',",
                "    }[type];",
                "",
