        "      this.helper.prepareDrawToRenderTarget(",
        "        frameState,",
        "        this.hitRenderTarget_,",
        "        true",
        "      );",
        "    }",
        "",
        "    this.helper.bindBuffer(this.verticesBuffer_);",
        "    this.helper.bindBuffer(this.indicesBuffer_);",
