        "  handleSourceFeatureChanged_(event) {",
        "    const feature = event.feature;",
        "    this.featureCache_[getUid(feature)] = {",
        "      feature: feature,",
        "      properties: feature.getProperties(),",
        "      geometry: feature.getGeometry(),",
