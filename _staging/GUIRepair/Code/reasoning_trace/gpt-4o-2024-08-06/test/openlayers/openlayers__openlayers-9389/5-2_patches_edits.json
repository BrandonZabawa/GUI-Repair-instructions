                    "if (!options.force && !options.match) {",
                    "entries = await getOutdated([...entries, ...unifiedEntries], options);",
                    "}",
                    "if (options.match) {",
                    "const exp = new RegExp(options.match);",
                    "entries = entries.filter(entry => exp.test(entry));",
                    "}",
                    "if (!options.interactive && entries.length === 0) {",
                    "return;",
                    "}",
                    "",
                    "const done = await serve(options);",
                    "try {",
                    "await render([...entries, ...unifiedEntries], options);",
                    "} finally {",
                    "if (!options.interactive) {",
                    "done();",
                    "}",
                    "}",
                    "}",
                    "",
                    "function getUnifiedEntries() {",
                    "// Logic to grab entries from the `test/rendering` folder",
                    "const newEntries = globby.sync(['test/rendering/**/*.js']);",
                    "return newEntries.map(entry => path.join(__dirname, '..', entry));",
                    "}"
                ]
            }
