+getTile(z, x, y) {
+// Adjust y for inverted coordinates
+const invertedY = this.tileGrid.getTileSize(z)[1] - y - 1;
+const tileCoordKey = getKeyZXY(z, x, invertedY);
+if (this.tileCache.containsKey(tileCoordKey)) {
+return /** @type {!LabeledTile} */ (this.tileCache.get(tileCoordKey));
+} else {
