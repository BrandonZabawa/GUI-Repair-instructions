                    "  local after_shortcodes = md_shortcode.md_shortcode:match(text) or \"\"",
                    "  local after_reading = pandoc.read(after_shortcodes, \"markdown\")",
                    "",
                    "  -- Normalize lists to ensure consistent block handling in markdown",
                    "  local normalize_lists = {",
                    "    BulletList = function(el)",
                    "      for i, item in ipairs(el.content) do",
                    "        el.content[i] = { pandoc.Para(item) }",
                    "      end",
                    "      return el",
                    "    end,",
                    "  }",
                    "",
                    "  local after_parsing = after_reading:walk(parse_extended_nodes()):walk(compute_flags()):walk(normalize_lists)",
