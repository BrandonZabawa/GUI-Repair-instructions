                "export function rInstallationMessage(indent = \"\") {",
                "  const lines = [",
                "    \"Unable to locate an installed version of R.\",",
                "    \"Install R from \" + colors.bold(\"https://cloud.r-project.org/\"),",
                "  ];",
                "  return lines.map((line: string) => `${indent}${line}`).join(\"\\n\");",
                "}"
