                    "function preprocessTheorems()",
                    "  local types = theoremTypes",
                    "  return {",
                    "    Div = function(el)",
                    "      local type = refType(el.attr.identifier)",
                    "      if types[type] ~= nil or proofType(el) ~= nil then",
                    "        return pandoc.walk_block(el, {",
                    "          Header = function(el)",
                    "            el.classes:insert(\"unnumbered\")",
                    "            -- Ensure headers are not part of list items",
                    "            pandoc.ListBlock({})",
                    "            return el",
                    "          end",
                    "        })",
                    "      end",
                    "",
                    "    end",
                    "  }",
                    "end"
                ]
            }
        ]
    },
    "5/5": {
        "src/resources/filters/crossref/theorems.lua": [
            {
                "SEARCH": [
                    "local type = refType(el.attr.identifier)",
                    "if types[type] ~= nil or proofType(el) ~= nil then",
                    "return pandoc.walk_block(el, {"
                ],
                "REPLACE": [
                    "      if el.t == \"Div\" and (types[refType(el.attr.identifier)] ~= nil or proofType(el) ~= nil) then",
                    "        local function isHeading(_, el)",
                    "          if el.t == 'Header' then",
                    "            el.classes:insert('unnumbered')",
                    "            return el",
                    "          end",
                    "        end",
                    "        return pandoc.walk_block(el, { Header = isHeading, List = isHeading })"
                ]
            }
        ]
