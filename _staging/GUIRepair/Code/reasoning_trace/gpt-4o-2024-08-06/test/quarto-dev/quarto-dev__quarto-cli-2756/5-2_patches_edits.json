                    "                pandoc.Attr(\"\", { \"theorem-title\" })",
                    "              )",
                    "            })",
                    "          else",
                    "            table.insert(el.content, 1, pandoc.Para({",
                    "              pandoc.Span(",
                    "                pandoc.Strong(prefix), ",
                    "                pandoc.Attr(\"\", { \"theorem-title\" })",
                    "              )",
                    "            }))",
                    "          end"
                ]
            }
        ]
    },
