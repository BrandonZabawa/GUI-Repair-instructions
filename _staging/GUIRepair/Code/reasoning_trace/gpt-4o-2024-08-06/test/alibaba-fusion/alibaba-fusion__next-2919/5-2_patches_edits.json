                "REPLACE": [
                    "componentWillUnmount() {",
                    "events.off(window, 'resize', this.onWindowResized);",
                    "",
                    "if (this.props.enableDragScroll) {",
                    "this.wrapper.removeEventListener('wheel', this.onWheelScroll);",
                    "this.nav.removeEventListener('mousedown', this.startDrag);",
                    "}",
                    "}",
                    "",
                    "onWheelScroll = (e) => {",
                    "e.preventDefault();",
                    "const delta = e.deltaY || e.detail || e.wheelDelta;",
                    "this.setOffset(this.offset + delta, true, false);",
                    "};",
                    "",
                    "startDrag = (e) => {",
                    "e.preventDefault();",
                    "const startPageX = e.pageX;",
                    "const startOffset = this.offset;",
                    "",
                    "const onMouseMove = (moveEvent) => {",
                    "const deltaX = moveEvent.pageX - startPageX;",
                    "this.setOffset(startOffset - deltaX, true, false);",
                    "};",
                    "",
                    "const onMouseUp = () => {",
                    "document.removeEventListener('mousemove', onMouseMove);",
                    "document.removeEventListener('mouseup', onMouseUp);",
                    "};",
                    "",
                    "document.addEventListener('mousemove', onMouseMove);",
                    "document.addEventListener('mouseup', onMouseUp);",
                    "};"
