{
    "1/5": {
        "src/select/main.scss": [
            {
                "SEARCH": [
                    ".#{$css-prefix}input-label, .#{$css-prefix}input-control, #{$select-prefix}-tag-compact {",
                    "line-height: calc(#{$form-element-medium-height} - 2px);",
                    "}",
                    "#{$select-prefix}-values {",
                    "/* Tag 有 3px 的 margin-bottom，所以包裹 Tag 的容器要作一下处理 */",
                    "margin-bottom: calc(0px - #{$select-tag-spacing-tb});",
                    "height: auto !important;",
                    "}"
                ],
                "REPLACE": [
                    "    .#{$css-prefix}input-label, .#{$css-prefix}input-control, #{$select-prefix}-tag-compact {",
                    "        line-height: calc(#{$form-element-medium-height} - 2px);",
                    "    }",
                    "    #{$select-prefix}-values {",
                    "        /* Adjusted margin to prevent affecting other demos */",
                    "        margin-bottom: 0;",
                    "        height: auto !important;",
                    "    }"
                ]
            }
        ]
    },
    "2/5": {
